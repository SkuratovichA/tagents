{
  "contractVersion": 1,
  "cli": {
    "tagents-core": {
      "exit": {
        "ok": 0,
        "error": 1,
        "usage": 2,
        "refused": 3,
        "timeout": 4
      },
      "commands": [
        {
          "path": [
            "session",
            "open"
          ],
          "positionals": [],
          "options": {
            "cwd": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "effort": {
              "type": "string"
            },
            "resume": {
              "type": "string"
            },
            "system-prompt-file": {
              "type": "string"
            },
            "mcp-config": {
              "type": "string"
            },
            "config-dir": {
              "type": "string"
            },
            "no-config-dir": {
              "type": "boolean"
            },
            "skip-permissions": {
              "type": "boolean"
            }
          },
          "required": [
            "cwd"
          ],
          "summary": "prepares a headless Claude session for a directory and prints its SessionRef as JSON; no process starts until a prompt is sent to it",
          "effect": "read",
          "tool": false
        },
        {
          "path": [
            "session",
            "prompt"
          ],
          "positionals": [
            "<ref-json-or-id>",
            "<text>"
          ],
          "options": {
            "timeout": {
              "type": "string"
            },
            "warn-before": {
              "type": "string"
            },
            "events": {
              "type": "boolean"
            }
          },
          "required": [],
          "summary": "runs one Claude turn: sends the prompt to a session, waits for the answer and prints the TurnOutcome as JSON; with --events, NDJSON events with the outcome last",
          "effect": "spawn",
          "tool": false
        },
        {
          "path": [
            "session",
            "last"
          ],
          "positionals": [
            "<ref-json-or-id>"
          ],
          "options": {},
          "required": [],
          "summary": "prints the last assistant text of a session and when it came, as JSON, or null",
          "effect": "read"
        },
        {
          "path": [
            "session",
            "list"
          ],
          "positionals": [],
          "options": {
            "label": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "multiple": true
            }
          },
          "required": [],
          "summary": "prints the known sessions as a JSON array of SessionRef, filtered by label and state",
          "effect": "read"
        },
        {
          "path": [
            "session",
            "abort"
          ],
          "positionals": [
            "<ref-json-or-id>"
          ],
          "options": {},
          "required": [],
          "summary": "stops the process of a session that has no pane and prints whether it did, with the id and pid, as JSON; a session in a tmux pane is refused with exit 3",
          "effect": "destructive",
          "tool": false
        },
        {
          "path": [
            "sessions",
            "recent"
          ],
          "positionals": [
            "[N]"
          ],
          "options": {},
          "required": [],
          "summary": "prints the most recent transcripts as text",
          "effect": "read",
          "tool": false
        },
        {
          "path": [
            "sessions",
            "search"
          ],
          "positionals": [
            "<words…>"
          ],
          "options": {},
          "required": [],
          "summary": "prints the transcripts that match the words, as text",
          "effect": "read",
          "tool": false
        },
        {
          "path": [
            "sessions",
            "show"
          ],
          "positionals": [
            "<id-prefix>"
          ],
          "options": {},
          "required": [],
          "summary": "prints the full text of one transcript, picked by id prefix",
          "effect": "read"
        },
        {
          "path": [
            "plugin",
            "list"
          ],
          "positionals": [],
          "options": {
            "json": {
              "type": "boolean"
            }
          },
          "required": [],
          "summary": "lists the configured plugins and what each offers, as lines or with --json one JSON document",
          "effect": "read"
        },
        {
          "path": [
            "plugin",
            "add"
          ],
          "positionals": [
            "<package-or-path>"
          ],
          "options": {
            "name": {
              "type": "string"
            }
          },
          "required": [],
          "summary": "validates a package manifest and writes the plugin into the config",
          "effect": "write",
          "tool": false
        },
        {
          "path": [
            "plugin",
            "remove"
          ],
          "positionals": [
            "<name>"
          ],
          "options": {},
          "required": [],
          "summary": "takes one plugin entry back out of the config",
          "effect": "destructive"
        },
        {
          "path": [
            "plugin",
            "new"
          ],
          "positionals": [
            "<name>"
          ],
          "options": {
            "dir": {
              "type": "string"
            }
          },
          "required": [],
          "summary": "scaffolds a package that is already a plugin",
          "effect": "write"
        },
        {
          "path": [
            "config",
            "convert"
          ],
          "positionals": [
            "[FILE]"
          ],
          "options": {
            "write": {
              "type": "boolean"
            },
            "all": {
              "type": "boolean"
            }
          },
          "required": [],
          "summary": "turns config.yaml into config.toml: prints it by default, writes it beside the YAML with --write, and also converts the per-host overlays with --all",
          "effect": "write",
          "tool": false
        },
        {
          "path": [
            "doctor"
          ],
          "positionals": [],
          "options": {},
          "required": [],
          "summary": "prints the node version, the state directory, the config file and whether claude is on PATH",
          "effect": "read"
        }
      ]
    },
    "tagents-knowledge": {
      "exit": {
        "ok": 0,
        "error": 1,
        "usage": 2,
        "notFound": 4
      },
      "commands": [
        {
          "path": [
            "index"
          ],
          "positionals": [],
          "options": {
            "dir": {
              "type": "string"
            },
            "db": {
              "type": "string"
            },
            "full": {
              "type": "boolean"
            }
          },
          "required": [],
          "summary": "brings the index in line with the folder; --full rebuilds it from nothing",
          "effect": "write"
        },
        {
          "path": [
            "search"
          ],
          "positionals": [
            "<query…>"
          ],
          "options": {
            "dir": {
              "type": "string"
            },
            "db": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "limit": {
              "type": "string"
            },
            "json": {
              "type": "boolean"
            },
            "usage-db": {
              "type": "string"
            },
            "verbose": {
              "type": "boolean"
            }
          },
          "required": [],
          "summary": "prints one line per hit: id#heading, score and snippet; --type filters by type (--kind is its deprecated alias); deprecated documents come last; each document it returns is recorded as a hit in the usage store (--usage-db F names the file, --verbose says why a read was not recorded)",
          "effect": "read",
          "tool": false
        },
        {
          "path": [
            "show"
          ],
          "positionals": [
            "<id[#heading]>"
          ],
          "options": {
            "dir": {
              "type": "string"
            },
            "db": {
              "type": "string"
            },
            "usage-db": {
              "type": "string"
            },
            "verbose": {
              "type": "boolean"
            }
          },
          "required": [],
          "summary": "prints the markdown of a document, or of one section of it; the read is recorded as a get in the usage store (--usage-db F names the file, --verbose says why a read was not recorded)",
          "effect": "read",
          "tool": false
        },
        {
          "path": [
            "list"
          ],
          "positionals": [],
          "options": {
            "dir": {
              "type": "string"
            },
            "db": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "json": {
              "type": "boolean"
            }
          },
          "required": [],
          "summary": "prints one line per document: id, type, updated, title and tags; --type filters by type (--kind is its deprecated alias); deprecated documents come last",
          "effect": "read",
          "tool": false
        },
        {
          "path": [
            "lint"
          ],
          "positionals": [],
          "options": {
            "dir": {
              "type": "string"
            }
          },
          "required": [],
          "summary": "checks the claims each document makes about itself",
          "effect": "read"
        },
        {
          "path": [
            "toc"
          ],
          "positionals": [],
          "options": {
            "dir": {
              "type": "string"
            },
            "check": {
              "type": "boolean"
            }
          },
          "required": [],
          "summary": "writes index.md, the OKF table of contents of the folder, grouped by type; --check writes nothing and exits 1 when index.md is absent or out of date",
          "effect": "write"
        },
        {
          "path": [
            "usage"
          ],
          "positionals": [],
          "options": {
            "dir": {
              "type": "string"
            },
            "db": {
              "type": "string"
            },
            "usage-db": {
              "type": "string"
            },
            "since": {
              "type": "string"
            },
            "top": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "all": {
              "type": "boolean"
            },
            "candidates": {
              "type": "boolean"
            },
            "min-gets": {
              "type": "string"
            },
            "min-days": {
              "type": "string"
            },
            "json": {
              "type": "boolean"
            }
          },
          "required": [],
          "summary": "reports what was read: one line per document with its type, status, gets, hits, the UTC days with a get and the date of the last get, the most read first; --since Nd sets the window (default 30d), --top N the number of lines (default 20), --type T keeps one type, --all adds ids that left the folder, --candidates keeps the documents read at least --min-gets times (default 5) on at least --min-days days (default 3), the ones worth turning into a skill; --usage-db F names the usage store",
          "effect": "read",
          "tool": false
        },
        {
          "path": [
            "mcp"
          ],
          "positionals": [],
          "options": {},
          "required": [],
          "summary": "serves the knowledge tools over stdio as an MCP server",
          "effect": "serve"
        },
        {
          "path": [
            "serve"
          ],
          "positionals": [],
          "options": {
            "idle": {
              "type": "string"
            },
            "foreground": {
              "type": "boolean"
            },
            "socket": {
              "type": "string"
            }
          },
          "required": [],
          "summary": "starts the shared MCP server for this environment if it is not running and prints its unix socket; --idle S is how many seconds without a client before it exits (default 600); --foreground runs the server in this process, on --socket P",
          "effect": "serve"
        }
      ]
    },
    "tagents-notify": {
      "exit": {
        "ok": 0,
        "error": 1,
        "usage": 2
      },
      "commands": [
        {
          "path": [
            "run"
          ],
          "positionals": [],
          "options": {},
          "required": [],
          "summary": "runs the notification service in the foreground until it is stopped",
          "effect": "serve"
        },
        {
          "path": [
            "install"
          ],
          "positionals": [],
          "options": {},
          "required": [],
          "summary": "installs and starts the notification service as a login item, builds its helper app and asks macOS for permission to notify",
          "effect": "spawn",
          "tool": false
        },
        {
          "path": [
            "uninstall"
          ],
          "positionals": [],
          "options": {
            "purge": {
              "type": "boolean"
            }
          },
          "required": [],
          "summary": "stops and removes the notification service; with purge it also deletes the helper app",
          "effect": "destructive",
          "tool": false
        },
        {
          "path": [
            "status"
          ],
          "positionals": [],
          "options": {},
          "required": [],
          "summary": "prints whether notifications will arrive: the service, the permission, the options and the click script",
          "effect": "read"
        },
        {
          "path": [
            "test"
          ],
          "positionals": [],
          "options": {
            "kind": {
              "type": "string"
            }
          },
          "required": [],
          "summary": "posts one sample notice of the given kind through the configured backend, which shows it on the screen",
          "effect": "write"
        },
        {
          "path": [
            "send"
          ],
          "positionals": [
            "<message…>"
          ],
          "options": {
            "title": {
              "type": "string"
            }
          },
          "required": [],
          "summary": "posts a desktop notification with this message (the words are joined with a space) through the configured backend, which shows it on the screen; a click docks the pane the command runs in; a title over 256 characters or a message over 2048 is refused",
          "effect": "write"
        }
      ]
    },
    "tagents": {
      "exit": {
        "ok": 0,
        "error": 1,
        "usage": 2
      },
      "commands": [
        {
          "path": [
            "--new"
          ],
          "positionals": [
            "[DIR]",
            "[PROFILE]"
          ],
          "options": {
            "detach": {
              "type": "boolean"
            }
          },
          "required": [],
          "summary": "starts a new interactive Claude Code session in DIR (default: the current directory) on the account PROFILE (default: the one the config rules pick), as a window of the tmux server this runs in, which the dashboard lists; detach (the default for a tool call) does not show or select the window, prints the new pane and where it is as session:index, and never opens a dialog, so when the rules say to ask which account it fails and names the profiles to pass",
          "effect": "spawn",
          "requires": "tmux",
          "toolDefaults": {
            "detach": true
          }
        },
        {
          "path": [
            "--window"
          ],
          "positionals": [
            "<DIR>",
            "<COMMAND>"
          ],
          "options": {
            "detach": {
              "type": "boolean"
            }
          },
          "required": [],
          "summary": "opens a tmux window in DIR that runs COMMAND, one string for the shell, and prints the new pane and where it is; the window closes when the command ends, and it lands in the session that owns DIR on the tmux server this runs in; detach (the default for a tool call) does not show or select the window",
          "effect": "spawn",
          "requires": "tmux",
          "toolDefaults": {
            "detach": true
          }
        },
        {
          "path": [
            "--label"
          ],
          "positionals": [
            "<K>",
            "<NAME>"
          ],
          "options": {},
          "required": [],
          "summary": "names an agent on the dashboard; K is its session id or pane id, and an empty NAME clears the name back to the window title",
          "effect": "write"
        },
        {
          "path": [
            "--profile-for"
          ],
          "positionals": [
            "<DIR>",
            "[SESSION]"
          ],
          "options": {},
          "required": [],
          "summary": "prints which account profile the config rules pick for DIR (and the tmux SESSION, when given), or ask, without starting anything; prints nothing and exits 1 when no profiles are configured",
          "effect": "read"
        },
        {
          "path": [
            "--config"
          ],
          "positionals": [],
          "options": {},
          "required": [],
          "summary": "prints the config as tagents reads it, one path and value per line, which includes the account profiles a session can be started on",
          "effect": "read"
        },
        {
          "path": [
            "--check"
          ],
          "positionals": [],
          "options": {},
          "required": [],
          "summary": "prints what is wrong with the config, one line each, and exits 1 while anything is; prints nothing and exits 0 when it is sound",
          "effect": "read"
        }
      ]
    }
  },
  "mcp": {
    "tagents-knowledge": {
      "tools": [
        {
          "name": "knowledge_get",
          "description": "The markdown of one document by id, or of a single \"## \" section when heading is given.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "document id, the filename stem"
              },
              "heading": {
                "description": "a \"## \" heading inside that document; omit for the whole document",
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        {
          "name": "knowledge_list",
          "description": "Every document as JSON: id, title, type, description, tags, status, stale, updated, path, headings. Documents with status deprecated come last.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "type": {
                "description": "only this type (case-insensitive, for example Runbook)",
                "type": "string"
              },
              "kind": {
                "description": "deprecated alias of type",
                "type": "string"
              },
              "tag": {
                "description": "only documents carrying this tag",
                "type": "string"
              }
            },
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        {
          "name": "knowledge_search",
          "description": "Full-text search over the owner's knowledge documents (Russian and English). Returns the matching sections as JSON: id, title, heading, score, snippet, path, type, description, status, stale. Documents with status deprecated come last. Read a whole section with knowledge_get.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "description": "words to look for; all of them must appear"
              },
              "tag": {
                "description": "only documents carrying this tag",
                "type": "string"
              },
              "type": {
                "description": "only documents of this type (case-insensitive, for example Runbook)",
                "type": "string"
              },
              "kind": {
                "description": "deprecated alias of type",
                "type": "string"
              },
              "limit": {
                "description": "how many sections (default 10)",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 50
              }
            },
            "required": [
              "query"
            ],
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        {
          "name": "knowledge_usage",
          "description": "What the knowledge documents are used for, as JSON rows, the most read first: id, type, status, gets (times the document or one of its sections was read), hits (times a search returned it), days (distinct UTC dates with a get inside the window), last (UTC date of the newest get, null when never read). Unread documents are listed with zeros. With candidates, only the documents read often enough on enough days to be worth turning into a skill. Looking at the numbers is not a read.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "since": {
                "description": "the window, a whole number of days and a d, for example 30d (default 30d)",
                "type": "string"
              },
              "top": {
                "description": "how many rows (default 20)",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "type": {
                "description": "only documents of this type (case-insensitive, for example Runbook)",
                "type": "string"
              },
              "all": {
                "description": "also list the ids that have events but are no longer in the folder",
                "type": "boolean"
              },
              "candidates": {
                "description": "only the documents that are not deprecated and were read at least min_gets times on at least min_days dates",
                "type": "boolean"
              },
              "min_gets": {
                "description": "gets a candidate needs inside the window (default 5)",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "min_days": {
                "description": "UTC dates a candidate needs a get on inside the window (default 3)",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        {
          "name": "sessions_recent",
          "description": "The latest sessions across every Claude account on this machine, newest first — the same text the sessions CLI prints.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "limit": {
                "description": "how many (default 15)",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 50
              }
            },
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        },
        {
          "name": "sessions_search",
          "description": "Sessions whose project path or opening prompt contains every one of these words — the same text the sessions CLI prints.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "words": {
                "type": "string",
                "minLength": 1,
                "description": "words that must all appear"
              }
            },
            "required": [
              "words"
            ],
            "$schema": "http://json-schema.org/draft-07/schema#"
          }
        }
      ]
    },
