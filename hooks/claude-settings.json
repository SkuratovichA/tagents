{
  "hooks": {
    "SessionStart":     [{ "hooks": [{ "type": "command", "command": "sh \"@HOOKS@/tmux-agent-state.sh\"" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "sh \"@HOOKS@/tmux-agent-state.sh\"" }] }],
    "PreToolUse":       [{ "hooks": [{ "type": "command", "command": "sh \"@HOOKS@/tmux-agent-state.sh\"", "async": true }] }],
    "PostToolUse":      [{ "hooks": [{ "type": "command", "command": "sh \"@HOOKS@/tmux-agent-state.sh\"", "async": true }] }],
    "Notification":     [{ "hooks": [{ "type": "command", "command": "sh \"@HOOKS@/tmux-agent-state.sh\"" }] }],
    "Stop":             [{ "hooks": [{ "type": "command", "command": "sh \"@HOOKS@/tmux-agent-state.sh\"" }] }],
    "SubagentStop":     [{ "hooks": [{ "type": "command", "command": "sh \"@HOOKS@/tmux-agent-state.sh\"", "async": true }] }],
    "SessionEnd":       [{ "hooks": [{ "type": "command", "command": "sh \"@HOOKS@/tmux-agent-state.sh\"" }] }]
  },
  "statusLine": {
    "type": "command",
    "command": "sh \"@HOOKS@/claude-statusline.sh\"",
    "padding": 0,
    "refreshInterval": 30
  }
}
