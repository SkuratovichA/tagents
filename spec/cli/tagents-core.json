{
  "$schema": "./cli-spec.schema.json",
  "program": "tagents-core",
  "exit": { "ok": 0, "error": 1, "usage": 2, "refused": 3, "timeout": 4 },
  "commands": [
    {
      "path": ["session", "open"],
      "positionals": [],
      "options": {
        "cwd": { "type": "string" },
        "label": { "type": "string" },
        "model": { "type": "string" },
        "effort": { "type": "string" },
        "resume": { "type": "string" },
        "system-prompt-file": { "type": "string" },
        "mcp-config": { "type": "string" },
        "config-dir": { "type": "string" },
        "no-config-dir": { "type": "boolean" },
        "skip-permissions": { "type": "boolean" }
      },
      "required": ["cwd"],
      "summary": "summarySessionOpen",
      "impl": "rust",
      "effect": "read",
      "tool": false
    },
    {
      "path": ["session", "prompt"],
      "positionals": ["<ref-json-or-id>", "<text>"],
      "options": {
        "timeout": { "type": "string" },
        "warn-before": { "type": "string" },
        "events": { "type": "boolean" }
      },
      "required": [],
      "summary": "summarySessionPrompt",
      "impl": "rust",
      "effect": "spawn",
      "tool": false
    },
    {
      "path": ["session", "last"],
      "positionals": ["<ref-json-or-id>"],
      "options": {},
      "required": [],
      "summary": "summarySessionLast",
      "impl": "rust",
      "effect": "read"
    },
    {
      "path": ["session", "list"],
      "positionals": [],
      "options": {
        "label": { "type": "string" },
        "state": { "type": "string", "multiple": true }
      },
      "required": [],
      "summary": "summarySessionList",
      "impl": "rust",
      "effect": "read"
    },
    {
      "path": ["session", "abort"],
      "positionals": ["<ref-json-or-id>"],
      "options": {},
      "required": [],
      "summary": "summarySessionAbort",
      "impl": "rust",
      "effect": "destructive",
      "tool": false
    },
    {
      "path": ["sessions", "recent"],
      "positionals": ["[N]"],
      "options": {},
      "required": [],
      "summary": "summarySessionsRecent",
      "impl": "rust",
      "effect": "read",
      "tool": false
    },
    {
      "path": ["sessions", "search"],
      "positionals": ["<words…>"],
      "options": {},
      "required": [],
      "summary": "summarySessionsSearch",
      "impl": "rust",
      "effect": "read",
      "tool": false
    },
    {
      "path": ["sessions", "show"],
      "positionals": ["<id-prefix>"],
      "options": {},
      "required": [],
      "summary": "summarySessionsShow",
      "impl": "rust",
      "effect": "read"
    },
    {
      "path": ["plugin", "list"],
      "positionals": [],
      "options": {
        "json": { "type": "boolean" }
      },
      "required": [],
      "summary": "summaryPluginList",
      "impl": "node",
      "effect": "read"
    },
    {
      "path": ["plugin", "add"],
      "positionals": ["<package-or-path>"],
      "options": {
        "name": { "type": "string" }
      },
      "required": [],
      "summary": "summaryPluginAdd",
      "impl": "rust",
      "effect": "write",
      "tool": false
    },
    {
      "path": ["plugin", "remove"],
      "positionals": ["<name>"],
      "options": {},
      "required": [],
      "summary": "summaryPluginRemove",
      "impl": "rust",
      "effect": "destructive"
    },
    {
      "path": ["plugin", "new"],
      "positionals": ["<name>"],
      "options": {
        "dir": { "type": "string" }
      },
      "required": [],
      "summary": "summaryPluginNew",
      "impl": "rust",
      "effect": "write"
    },
    {
      "path": ["doctor"],
      "positionals": [],
      "options": {},
      "required": [],
      "summary": "summaryDoctor",
      "impl": "rust",
      "effect": "read"
    },
    {
      "path": ["mcp"],
      "positionals": [],
      "options": { "contract": { "type": "string" } },
      "required": ["contract"],
      "summary": "summaryMcp",
      "impl": "rust",
      "effect": "serve"
    },
    {
      "path": ["notify", "run"],
      "positionals": [],
      "options": {},
      "required": [],
      "summary": "summaryNotifyRun",
      "impl": "rust",
      "effect": "serve"
    },
    {
      "path": ["knowledge", "mcp"],
      "positionals": [],
      "options": {},
      "required": [],
      "summary": "summaryKnowledgeMcp",
      "impl": "rust",
      "effect": "serve"
    },
    {
      "path": ["knowledge", "serve"],
      "positionals": [],
      "options": {
        "idle": { "type": "string" },
        "foreground": { "type": "boolean" },
        "socket": { "type": "string" }
      },
      "required": [],
      "summary": "summaryKnowledgeServe",
      "impl": "rust",
      "effect": "serve"
    },
    {
      "path": ["knowledge", "join"],
      "positionals": [],
      "options": {},
      "required": [],
      "summary": "summaryKnowledgeJoin",
      "impl": "rust",
      "effect": "serve"
    }
  ]
}
