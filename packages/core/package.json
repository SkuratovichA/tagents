{
  "name": "@tagents/core",
  "version": "0.3.1",
  "description": "How a headless Claude Code session is spawned, prompted, read and listed: the session driver, the transcript reader, the agent-state reader and the tagents-core CLI",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "tagents-core": "./dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/cli/main.js",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "yaml": "^2.8",
    "zod": "^4.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "5.9.3"
  }
}
