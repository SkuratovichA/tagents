#!/usr/bin/env bash
#
# tusage — token accounting for Claude Code, read straight from the transcripts
# in ~/.claude/projects. Answers "where did my limit go", per project, per
# session, per subagent.
#
#   tusage                      summary: last 5h window, today, last 7 days
#   tusage --by day|project|session|agent|model|hour
#   tusage --since 5h|3d|month  window for --by (default 7d; month = since the 1st)
#   tusage --until <epoch>      close the --daily window at that instant too
#   tusage --calibrate <account> <amount> [--at "YYYY-MM-DD HH:MM"|<epoch>]
#                               price that account at a factor that makes the
#                               month-to-date equal what its own meter showed
#   tusage --meter [--refresh|--force]
#                               what the account's own meter says it has spent
#   tusage --sessions           machine-readable per-session totals (for tagents)
#   tusage --session <sid>      one session in detail
#   tusage --burn               one-line status-bar string
#   tusage --update             refresh the index and exit
#   tusage --rebuild            throw the index away and rescan everything
#   tusage --json               emit the current window as JSON
#   tusage --daily              day<TAB>account<TAB>usd<TAB>reqs<TAB>unpriced
#
# ACCOUNTS. --daily splits the bill by login. TU_ACCOUNTS is "name=dir;name=dir"
# (an empty dir means ~/.claude); unset, it is the default config dir plus every
# ~/.claude-* that keeps a history. TU_ACCOUNT_RULES is "dir=name;dir=name" and
# places the sessions no history.jsonl lists — headless -p runs write none — by
# the directory they were launched in. Anything still unplaced prints as "?".
#
# THE DOLLARS ARE AN ESTIMATE, NOT A BILL: roughly 3% under Claude Code's own
# ledger on a large session and more on small ones, because retries, titles and
# away summaries never reach a transcript and so are never counted.
#
# EXCEPT FOR THE MONTH, WHICH IS THE METER. The account's own spend is one
# authenticated GET away — `/api/oauth/usage`, with the OAuth token Claude Code
# keeps in the keychain for the default config dir — and that figure is the one
# the bill is written from. --meter reads it into meter.tsv (one row per
# account, at most one fetch per account per call, TU_METER_TTL seconds apart —
# 900 by default, 300 past 90% of the limit), re-calibrates the per-day factor
# from it, and --update refreshes it in passing, which is how the dashboard gets
# it for free. TU_NO_METER=1 turns the whole thing off. The token is read into a
# variable, handed to curl as one header and dropped: it is never printed,
# never logged, and never written anywhere.
#
# WHY AN INDEX. 800 MB of transcripts across ~1300 files: a full scan costs a
# second and a half, which is fine once and far too slow for a dashboard that
# refreshes every two seconds. So the parsed byte offset of every file is
# remembered and only the tail is re-read.
#
# WHY DEDUPE. One API response is written to the transcript once per content
# block, each copy carrying the SAME usage object and the same requestId.
# Summing entries naively overcounts by ~2.2x. Everything here counts unique
# requestIds. Duplicates are adjacent in the file, so carrying the last few ids
# across an incremental read is enough to keep the seam honest.
#
# WHY A LOCK. That dedupe is per-process, and the index is append-only, so two
# updaters running at once both start from the same offset, both parse the same
# new bytes and both append them — and nothing downstream can tell, because the
# facts file records totals, not ids. The dashboard refreshes on a timer and
# `tusage` with no arguments updates too, so the sessions being typed into are
# exactly the ones that collide. Measured on a fixture: 13 requests indexed as
# 21. One updater at a time, `mkdir` as the atomic primitive (macOS has no
# flock); losing the race is not an error, the winner reads the same bytes.
#
# WHY "COST UNITS". Raw token counts are not comparable: a cached read is an
# order of magnitude cheaper than a fresh write, and output is several times
# more expensive than input. The `cost` column normalises everything to
# input-token equivalents using the published cache multipliers:
#
#     cost = input + 1.25*cache_write_5m + 2.0*cache_write_1h
#                  + 0.1*cache_read + 5*output
#
# It is a proxy for what a request actually costs you, not a billing figure.
# Raw totals are always available with --raw.
#
# For actual money, see PRICES below: every row is priced at the model that
# produced it, so a session that switched models mid-conversation — or spread
# work across subagents on a cheaper tier — still totals correctly. `--sessions`
# reports both, and `--session <id>` breaks a session down per subagent and per
# model.
#
# That figure is an ESTIMATE, and knowably a few percent low: it can only price
# requests that reached the transcript, and Claude Code also spends on calls
# that never do — retries, conversation titles, away summaries. Measured against
# Claude Code own ledger on a live session: 3% under on a large one, more on a
# small one where that fixed overhead weighs more. tagents prefers the ledger
# (via the status line) for the headline number and uses these figures for what
# the ledger cannot answer: subagent share, the 5h window, closed sessions.
#
# bash 3.2 compatible — macOS ships nothing newer.

set -uo pipefail

PROJECTS=${TU_PROJECTS:-$HOME/.claude/projects}
STATE=${TU_STATE:-$HOME/.claude/agent-state/usage}
OFFSETS="$STATE/offsets.tsv"
FACTS="$STATE/facts.tsv"
META="$STATE/sessions.tsv"
STAMP="$STATE/.stamp"
BUCKET=300                          # facts are aggregated into 5-minute buckets
# A CALENDAR MONTH IS THE UNIT A BILL IS WRITTEN IN. 30 days of facts cannot
# answer "what did this month cost" on the 31st, and cannot answer "how does it
# compare with last month" on any day at all. 62 days covers the longest month
# plus the one before it, which is the shortest retention that makes both
# questions answerable; the index costs ~2 MB a month, so the space is noise.
KEEP_DAYS=${TU_KEEP_DAYS:-62}
TAB=$'\t'

W_IN=1; W_CW5=1.25; W_CW1H=2.0; W_CR=0.1; W_OUT=5

# ---------------------------------------------------------------------------
#  Model prices — US dollars per million tokens
# ---------------------------------------------------------------------------
#  WHY A TABLE AND NOT ONE MULTIPLIER. The cost units above are comparable
#  across models but they are not money: a million Haiku tokens and a million
#  Fable tokens differ by a factor of ten. Dollars need the per-model rate.
#
#  And — this is the part worth doing properly — A SESSION'S MODEL CHANGES.
#  /model mid-conversation, a fallback after a refusal, a subagent deliberately
#  put on a cheaper tier. Pricing a session's whole token total at whatever
#  model it happens to be on right now is simply wrong, and wrong by 2x between
#  the two models this index actually holds. The facts index is already keyed
#  per model (field 7), so every row is priced at the model that produced it and
#  the session total is the sum. Subagent rows are priced the same way and are
#  part of that sum — a cheap courier and an expensive architect land in the
#  same session at their own rates.
#
#  Rows: <model> <input $/MTok> <output $/MTok> [<cache read $/MTok>
#        [<until epoch> <in> <out>]]
#  The read rate is optional and defaults to 0.1x the input rate, which is what
#  every model charges except Fable/Mythos 5.1, whose reads are $0.25/MTok —
#  0.025x their input, and cheaper per token than Opus 5's reads.
#  The tail after it is introductory pricing, applied to usage at or before that
#  instant; no model needs it today, and a row that wants one must state its
#  read rate first.
#
#  The write multipliers are ratios of the input rate and hold for every model:
#  a 5m write is 1.25x, a 1h write 2x.
#
#  A model with no row here is NOT guessed at — see usd(). Add one with
#  TU_PRICES rather than editing this file if you just need a rate today.
# ---------------------------------------------------------------------------
# Dollars per million tokens, input then output; an optional trailing
# "<until-epoch> <in> <out>" is an introductory rate that applies up to that
# instant. These are what a request is priced at; the cache multipliers below
# ride on top of the input rate.
#
# These are the published rates. An earlier table carried fable at 15/75, fitted
# against the ledger; that fit was absorbing a missing rate rather than finding a
# premium — fable's cache reads are $0.25/MTok, a quarter of the 0.1x this file
# assumed, and fable sessions are read-heavy. With the published rates plus that
# read rate, ledger/estimate over the eight largest fable-heavy sessions lands at
# 0.88-1.09 (the ledger runs a few percent high because it counts retries and
# title requests that never reach a transcript); at 15/75 the same sessions came
# out at 0.44-0.78, i.e. the estimate was up to twice the bill. There is no
# long-context premium either: Anthropic prices the whole 1M window at one rate
# ("a 900k-token request is billed at the same per-token rate as a 9k-token
# request"), so nothing here needs to vary with context size. Re-derive the same
# way if a rate ever stops matching: `tusage --session <id>` prints the per-model
# split, and agent-state/model/<id>.tsv holds the ledger figure to fit against.
PRICES=${TU_PRICES:-'
claude-fable-5-1   10 50 0.25
claude-mythos-5-1  10 50 0.25
claude-fable-5     10 50
claude-mythos-5    10 50
claude-opus-5       5 25
claude-opus-4-8     5 25
claude-opus-4-7     5 25
claude-opus-4-6     5 25
claude-sonnet-5     2 10
claude-sonnet-4-6   3 15
claude-haiku-4-5    1  5
'}

# BWK awk rejects a -v value containing newlines and fails silently enough to
# look like "nothing is priced", so the table crosses on one line.
prices_arg() { printf '%s' "$PRICES" | tr '\n' ';'; }

# Shared by every awk below that reports money.
AWK_PRICE='
  function price_load(  n, i, a, row) {
    PLOADED = 1
    n = split(prices, row, ";")
    for (i = 1; i <= n; i++) {
      if (row[i] ~ /^[ \t]*$/) continue
      split(row[i], a, " ")
      PN++; PK[PN] = a[1]; PIN[a[1]] = a[2] + 0; POUT[a[1]] = a[3] + 0
      PCR[a[1]] = (a[4] != "" ? a[4] + 0 : 0.1 * (a[2] + 0))
      if (a[5] != "") { PUNTIL[a[1]] = a[5] + 0; PIN0[a[1]] = a[6] + 0; POUT0[a[1]] = a[7] + 0 }
    }
  }
  # Transcripts carry dated snapshot ids (claude-haiku-4-5-20251001), so an
  # exact hit is tried first and the longest matching prefix second.
  function price_key(m,   i, k, best) {
    if (!PLOADED) price_load()
    if (m in PIN) return m
    best = ""
    for (i = 1; i <= PN; i++) {
      k = PK[i]
      if (index(m, k) == 1 && length(k) > length(best)) best = k
    }
    return best
  }
  # Dollars for one facts row. Returns -1 for a model with no published rate —
  # a caller must surface that rather than fold an unpriced model in as free,
  # which would quietly under-report the bill.
  function usd(m, ts, i, c5, c1, cr, o,   k, pin, pout, pcr) {
    k = price_key(m)
    if (k == "") return -1
    pin = PIN[k]; pout = POUT[k]; pcr = PCR[k]
    if ((k in PUNTIL) && ts <= PUNTIL[k]) { pin = PIN0[k]; pout = POUT0[k]; pcr = 0.1 * pin }
    return (i * pin + 1.25 * c5 * pin + 2.0 * c1 * pin + pcr * cr + o * pout) / 1000000
  }
  function money(d) {
    if (d < 0)     return "?"
    if (d >= 100)  return sprintf("$%.0f", d)
    if (d >= 10)   return sprintf("$%.1f", d)
    if (d >= 0.01) return sprintf("$%.2f", d)
    if (d > 0)     return "<$0.01"
    return "$0"
  }
'

mkdir -p "$STATE" 2>/dev/null

command -v jq >/dev/null 2>&1 || { echo "tusage: jq is required" >&2; exit 1; }

# ---------------------------------------------------------------------------
# extraction
# ---------------------------------------------------------------------------
# NB: every project directory begins with "-" (e.g. -Users-suka--git-work-x),
# so a relative path is parsed as an option by jq, tail, head and wc alike.
# Absolute paths are used everywhere below for exactly that reason.

EXTRACT='
  select(.type == "assistant" and (.message.usage != null))
  | .message.usage as $u
  | ($u.cache_creation // null) as $cc
  | [ (.requestId // .message.id // "-"),
      ((.timestamp // "") | if . == "" then 0
         else (sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601? // 0) end),
      (.sessionId // "-"),
      (.agentId // "-"),
      (.attributionAgent // "-"),
      (.sessionKind // "-"),
      (.message.model // "-"),
      ($u.input_tokens // 0),
      (if $cc then ($cc.ephemeral_5m_input_tokens // 0)
               else ($u.cache_creation_input_tokens // 0) end),
      (if $cc then ($cc.ephemeral_1h_input_tokens // 0) else 0 end),
      ($u.cache_read_input_tokens // 0),
      ($u.output_tokens // 0)
    ] | @tsv'

# Bytes of a file that end in a complete line. A transcript being appended to
# right now usually has a partial last line; consuming it would corrupt the
# offset and silently drop the record when the rest arrives.
complete_bytes() {
  local f=$1 sz
  sz=$(wc -c <"$f" 2>/dev/null | tr -d ' ') || return 1
  [ "${sz:-0}" -eq 0 ] && { printf '0'; return 0; }
  if [ "$(tail -c 1 -- "$f" 2>/dev/null | wc -l | tr -d ' ')" -eq 1 ]; then
    printf '%s' "$sz"
  else
    local part
    part=$(tail -c 4194304 -- "$f" 2>/dev/null | tail -1 | wc -c | tr -d ' ')
    printf '%s' "$(( sz - ${part:-0} ))"
  fi
}

# Transcripts are NOT one file per session. A subagent gets its own file under
#   <project-slug>/<parent-session-id>/subagents/agent-<id>.jsonl
# and a Workflow run one file per agent under
#   <project-slug>/<parent-session-id>/subagents/workflows/wf_<id>/agent-<id>.jsonl
# Those nested files carry the PARENT's sessionId, so attribution is exact — but
# the project must come from the first path component, not from dirname, or every
# workflow shows up as a project of its own. Verified: no requestId appears in
# both a parent file and a nested one, so per-file dedupe cannot double-count.
path_facets() {  # <abs path> -> "slug<TAB>origin" where origin = main|sub|wf:<id>
  local rel=${1#"$PROJECTS"/} slug rest
  slug=${rel%%/*}; rest=${rel#*/}
  case "$rest" in
    */workflows/wf_*/*) rest=${rest#*/workflows/}; printf '%s\t%s' "$slug" "wf:${rest%%/*}" ;;
    */subagents/*)      printf '%s\t%s' "$slug" "sub" ;;
    *)                  printf '%s\t%s' "$slug" "main" ;;
  esac
}

# A TRANSCRIPT IS THE SAME FILE WHEREVER CLAUDE CODE PUTS IT. A session started
# in a worktree lives under the worktree's slug; when the worktree is deleted the
# very same files reappear under the parent project's slug. Keyed by absolute
# path, the index saw a brand-new file each time and re-read it from byte 0, so
# every request in it was counted again — one live session was indexed under
# three slugs and $162 of the $285 charged to it was the copies.
#
# The identity that survives the move is session-relative: the sid for the main
# transcript, and the sid plus the path below its directory for a subagent or
# workflow file. Everything above that (the project slug) is where the file
# happens to live today.
transcript_key() {  # <abs path> -> "<sid>" | "<sid>/subagents/..."
  local rel=${1#"$PROJECTS"/} rest
  rest=${rel#*/}
  printf '%s' "${rest%.jsonl}"
}

# Newest-copy-wins needs an mtime, and BSD and GNU stat spell it differently.
# GNU answers -f with filesystem info instead of failing, so the BSD spelling is
# accepted only when it comes back as digits.
mtime_of() {  # <abs path> -> epoch seconds, 0 if unknown
  local m
  m=$(stat -f %m "$1" 2>/dev/null)
  case "$m" in ''|*[!0-9]*) m=$(stat -c %Y "$1" 2>/dev/null) ;; esac
  case "$m" in ''|*[!0-9]*) m=0 ;; esac
  printf '%s' "$m"
}

# facts rows: bucket, project-slug, sid, agentid, agenttype, kind, model,
#             reqs, in, cw5, cw1h, cr, out, maxctx
fold_rows() {  # <project-slug> <carried ids> <origin> ; extracted TSV on stdin
  awk -F"$TAB" -v OFS="$TAB" -v proj="$1" -v seen0="$2" -v origin="$3" -v bucket="$BUCKET" '
    BEGIN { n = split(seen0, carry, ","); for (i = 1; i <= n; i++) if (carry[i] != "") seen[carry[i]] = 1 }
    {
      id = $1
      if (id in seen) next
      seen[id] = 1
      tail[++t] = id
      # attributionAgent is absent in nested transcripts of some versions; the
      # path always knows what the file is, so it is the fallback.
      who = $5
      if (who == "-" || who == "") who = (origin == "main" ? "-" : (origin == "sub" ? "subagent" : "workflow"))
      kind = $6
      if (kind == "-" && origin != "main") kind = (origin == "sub" ? "sub" : origin)
      b = int($2 / bucket) * bucket
      k = b SUBSEP $3 SUBSEP $4 SUBSEP who SUBSEP kind SUBSEP $7
      if (!(k in R)) { order[++m] = k }
      ctx = $8 + $9 + $10 + $11
      R[k]++; I[k] += $8; C5[k] += $9; C1[k] += $10; CR[k] += $11; O[k] += $12
      if (ctx > X[k]) X[k] = ctx
      if (!($3 in fts) || $2 < fts[$3]) fts[$3] = $2
      if (!($3 in lts) || $2 > lts[$3]) lts[$3] = $2
      mdl[$3] = $7
    }
    END {
      for (i = 1; i <= m; i++) {
        k = order[i]; split(k, a, SUBSEP)
        print "F", a[1], proj, a[2], a[3], a[4], a[5], a[6], R[k], I[k], C5[k], C1[k], CR[k], O[k], X[k]
      }
      for (s in fts) print "M", s, proj, fts[s], lts[s], mdl[s]
      # the last few ids, so the next incremental read does not double-count a
      # response whose content blocks straddle the seam
      out = ""
      for (i = (t > 32 ? t - 31 : 1); i <= t; i++) out = out (out == "" ? "" : ",") tail[i]
      print "T", out
    }'
}

# ONE UPDATER AT A TIME, or the index inflates. facts.tsv is append-only and
# every updater starts from the offset it read at entry, so two running at once
# both parse the same new bytes and both append them — the requests are counted
# twice and no later pass can tell, because the file records totals, not ids.
# It is not hypothetical: the dashboard refreshes on a timer, `tusage` with no
# arguments updates too, and a session being actively typed into is exactly the
# one generating new bytes for them to collide over. Measured on a fixture: 13
# real requests indexed as 21.
#
# mkdir is the atomic primitive that exists everywhere (macOS has no flock).
# Losing the race is not an error: the winner is reading the same bytes this
# process would have, so it just returns and lets the next tick pick up.
LOCK="$STATE/.update.lock"
LOCK_STALE_MIN=${TU_LOCK_STALE_MIN:-5}

update() {
  local rebuild=${1:-0} loud=${2:-0} f sz off end slug seen tmp work newoff key state dups n=0

  mkdir -p "$STATE" 2>/dev/null || return 1
  # A background refresh that loses the race just returns — the winner is
  # reading the same bytes. An explicit --rebuild is a command, not a tick, so
  # it waits and says so rather than pretending it did the work.
  local tries=1; [ "$rebuild" = 1 ] && tries=20
  while [ "$tries" -gt 0 ]; do
    mkdir "$LOCK" 2>/dev/null && break
    # An updater killed mid-run would otherwise wedge the index for good.
    if [ -n "$(find "$LOCK" -maxdepth 0 -mmin "+$LOCK_STALE_MIN" 2>/dev/null)" ]; then
      rm -rf "$LOCK" 2>/dev/null
      mkdir "$LOCK" 2>/dev/null && break
    fi
    tries=$((tries - 1))
    [ "$tries" -gt 0 ] && sleep 1
  done
  if [ "$tries" -le 0 ]; then
    [ "$rebuild" = 1 ] &&
      echo "tusage: another update is running; index left alone" >&2
    return 0
  fi

  tmp=$(mktemp -d "${TMPDIR:-/tmp}/tusage.XXXXXX") || { rm -rf "$LOCK"; return 1; }
  trap 'rm -rf "$tmp" "$LOCK"' RETURN

  [ "$rebuild" = 1 ] && rm -f "$OFFSETS" "$FACTS" "$META" "$STAMP"

  # Candidates: everything on a rebuild or a first run, otherwise only what has
  # been touched since the last update (plus anything the index never saw).
  if [ -e "$STAMP" ] && [ -s "$OFFSETS" ]; then
    find "$PROJECTS" -name '*.jsonl' -newer "$STAMP" 2>/dev/null >"$tmp/cand"
    awk -F"$TAB" 'NR==FNR { known[$1]=1; next } !($0 in known)' "$OFFSETS" \
      <(find "$PROJECTS" -name '*.jsonl' 2>/dev/null) >>"$tmp/cand" 2>/dev/null
    sort -u "$tmp/cand" -o "$tmp/cand"
  else
    find "$PROJECTS" -name '*.jsonl' 2>/dev/null >"$tmp/cand"
  fi
  [ -s "$tmp/cand" ] || { : >"$STAMP"; return 0; }

  # The offsets table, keyed. Rows written before the key column existed are
  # migrated here, not rewritten in place: the key is a pure function of the
  # path, so deriving it once on the way in costs nothing and the old three-field
  # rows keep working until the table is next written out.
  : >"$tmp/offk"
  [ -s "$OFFSETS" ] && awk -F"$TAB" -v OFS="$TAB" -v pref="$PROJECTS/" '
      { k = $4
        if (k == "") {
          p = $1
          if (index(p, pref) == 1) p = substr(p, length(pref) + 1)
          i = index(p, "/"); if (i > 0) p = substr(p, i + 1)
          sub(/\.jsonl$/, "", p)
          k = p
        }
        print $1, $2, $3, k }' "$OFFSETS" >"$tmp/offk"

  # Key every candidate, and add any already-indexed copy of the same key that is
  # still on disk under its old path — mid-move, or a plain copy, both halves are
  # there and only one of them may be counted.
  : >"$tmp/keyed"; : >"$tmp/skipped"
  while IFS= read -r f; do
    [ -e "$f" ] || continue
    printf '%s\t%s\t%s\tnew\n' "$(transcript_key "$f")" "$(mtime_of "$f")" "$f"
  done <"$tmp/cand" >"$tmp/keyed"
  if [ -s "$tmp/offk" ]; then
    awk -F"$TAB" 'NR==FNR { ck[$1] = 1; cp[$3] = 1; next }
                  ($4 in ck) && !($1 in cp) { print $4 "\t" $1 }' \
        "$tmp/keyed" "$tmp/offk" |
      while IFS="$TAB" read -r k f; do
        [ -e "$f" ] || continue
        printf '%s\t%s\t%s\told\n' "$k" "$(mtime_of "$f")" "$f"
      done >>"$tmp/keyed"
  fi
  # Newest mtime wins the key; the losers are not parsed at all. A loser that is
  # already indexed keeps its row, so the copy on disk is simply invisible.
  sort -t"$TAB" -k1,1 -k2,2nr "$tmp/keyed" 2>/dev/null |
    awk -F"$TAB" -v skip="$tmp/skipped" '
      { if (seen[$1]++) { print > skip; next } print }' >"$tmp/plan"
  dups=$(grep -c . "$tmp/skipped" 2>/dev/null); dups=${dups:-0}

  : >"$tmp/newfacts"; : >"$tmp/newmeta"; : >"$tmp/newoff"

  while IFS="$TAB" read -r key _ f state; do
    [ "$state" = new ] || continue
    [ -e "$f" ] || continue
    off=0; seen=""
    # BY KEY, NOT BY PATH: a known key under a new path is the same transcript
    # moved, so its offset and carried ids come along and only the tail is read.
    if [ -s "$tmp/offk" ]; then
      IFS="$TAB" read -r _ off seen _ < <(awk -F"$TAB" -v k="$key" '$4==k { print; exit }' "$tmp/offk")
      off=${off:-0}
    fi
    sz=$(wc -c <"$f" 2>/dev/null | tr -d ' '); sz=${sz:-0}
    # Shorter than the offset it inherited: not that file after all, so read it
    # whole. Covers a rewritten transcript and a name reused by a shorter one.
    [ "$sz" -lt "$off" ] && { off=0; seen=""; }
    end=$(complete_bytes "$f"); end=${end:-0}
    if [ "$end" -le "$off" ]; then
      printf '%s\t%s\t%s\t%s\n' "$f" "$off" "$seen" "$key" >>"$tmp/newoff"
      continue
    fi
    IFS="$TAB" read -r slug origin < <(path_facets "$f")
    if [ "$off" -eq 0 ] && [ "$end" -eq "$sz" ]; then
      jq -rc "$EXTRACT" -- "$f" 2>/dev/null
    else
      tail -c "+$((off + 1))" -- "$f" 2>/dev/null | head -c "$((end - off))" |
        jq -rc "$EXTRACT" 2>/dev/null
    fi | fold_rows "$slug" "$seen" "$origin" >"$tmp/out"
    grep '^F'"$TAB" "$tmp/out" 2>/dev/null | cut -f2- >>"$tmp/newfacts"
    grep '^M'"$TAB" "$tmp/out" 2>/dev/null | cut -f2- >>"$tmp/newmeta"
    newoff=$(grep '^T'"$TAB" "$tmp/out" 2>/dev/null | cut -f2- | head -1)
    printf '%s\t%s\t%s\t%s\n' "$f" "$end" "$newoff" "$key" >>"$tmp/newoff"
    n=$((n + 1))
  done <"$tmp/plan"

  # merge offsets: untouched files keep their row, and a key that moved keeps
  # exactly one row — the new path's. The old path's row goes, or the next
  # update would offer the offset of a file that is no longer there.
  if [ -s "$tmp/offk" ]; then
    awk -F"$TAB" -v OFS="$TAB" 'NR==FNR { up[$1] = 1; uk[$4] = 1; next }
                                !($1 in up) && !($4 in uk)' \
        "$tmp/newoff" "$tmp/offk" >>"$tmp/newoff.merged" 2>/dev/null
  fi
  cat "$tmp/newoff" >>"$tmp/newoff.merged" 2>/dev/null
  sort -u "$tmp/newoff.merged" 2>/dev/null |
    awk -F"$TAB" '!p[$1]++ && !k[$4]++' >"$tmp/off.final"
  mv -f "$tmp/off.final" "$OFFSETS" 2>/dev/null
  [ "$dups" -gt 0 ] && [ "$loud" = 1 ] &&
    echo "tusage: $dups duplicate transcript copies skipped" >&2

  [ -s "$tmp/newfacts" ] && cat "$tmp/newfacts" >>"$FACTS"
  if [ -s "$tmp/newmeta" ]; then
    cat "$META" "$tmp/newmeta" 2>/dev/null |
      awk -F"$TAB" -v OFS="$TAB" '
        { if (!($1 in f) || $3 < f[$1]) f[$1] = $3
          if (!($1 in l) || $4 > l[$1]) l[$1] = $4
          p[$1] = $2; if ($5 != "" && $5 != "-") m[$1] = $5 }
        END { for (s in f) print s, p[s], f[s], l[s], (s in m ? m[s] : "-") }' \
      >"$tmp/meta.final" 2>/dev/null
    mv -f "$tmp/meta.final" "$META" 2>/dev/null
  fi

  # The account map is refreshed on the updater's tick, never on a render: the
  # jq passes over the histories are exactly the kind of parsing the index
  # exists to keep off the two-second path.
  account_map --locked >/dev/null 2>&1

  # keep facts bounded
  if [ -s "$FACTS" ]; then
    awk -F"$TAB" -v cut="$(( $(date +%s) - KEEP_DAYS * 86400 ))" '$1 + 0 >= cut' \
      "$FACTS" >"$tmp/facts.trim" 2>/dev/null && mv -f "$tmp/facts.trim" "$FACTS"
  fi
  : >"$STAMP"
  return 0
}

# ---------------------------------------------------------------------------
# reporting
# ---------------------------------------------------------------------------
# facts columns: 1 bucket 2 slug 3 sid 4 agentid 5 agenttype 6 kind 7 model
#                8 reqs 9 in 10 cw5 11 cw1h 12 cr 13 out

# Local 00:00 of the 1st of the current month. BSD date wants the format spelt
# out, GNU date parses the bare date; try each in that order.
month_start() {
  local first; first=$(date +%Y-%m-01)
  date -j -f '%Y-%m-%d %H:%M:%S' "$first 00:00:00" +%s 2>/dev/null ||
    date -d "$first" +%s 2>/dev/null
}

# `month` is spelt out because the suffix space is taken: *m already means
# minutes, and silently re-reading "1m" as a month would change what every
# existing caller asks for.
since_secs() {
  case "$1" in
    month) printf '%s' "$(( $(date +%s) - $(month_start) ))" ;;
    *h) printf '%s' "$(( ${1%h} * 3600 ))" ;;
    *d) printf '%s' "$(( ${1%d} * 86400 ))" ;;
    *m) printf '%s' "$(( ${1%m} * 60 ))" ;;
    *)  printf '%s' "$1" ;;
  esac
}

# slug -> the real directory. Decoding the slug itself is impossible (a dash
# stands for both "/" and "-"), so the first cwd written into any transcript of
# that project is used instead, and cached.
SLUGMAP="$STATE/projects.tsv"
slug_map() {
  local d slug f cwd
  if [ -e "$SLUGMAP" ] && [ -z "${TU_REFRESH_SLUGS:-}" ]; then
    # refresh only when a project directory appeared since the map was written
    [ "$(find "$PROJECTS" -maxdepth 1 -type d -newer "$SLUGMAP" 2>/dev/null | wc -l)" -eq 0 ] &&
      { cat "$SLUGMAP"; return 0; }
  fi
  : >"$SLUGMAP.tmp"
  for d in "$PROJECTS"/*/; do
    [ -d "$d" ] || continue
    slug=$(basename "$d")
    f=$(ls -1t "$d"*.jsonl 2>/dev/null | head -1)
    cwd=""
    [ -n "$f" ] && cwd=$(head -200 -- "$f" 2>/dev/null | jq -rc 'select(.cwd)|.cwd' 2>/dev/null | head -1)
    [ -z "$cwd" ] && cwd="$slug"
    printf '%s\t%s\n' "$slug" "$cwd" >>"$SLUGMAP.tmp"
  done
  mv -f "$SLUGMAP.tmp" "$SLUGMAP" 2>/dev/null
  cat "$SLUGMAP"
}

# sid -> which login paid for it.
#
# THE ACCOUNT IS A JOIN, NOT A COLUMN. Every config dir shares one transcript
# pool (~/.claude-d/projects is a symlink into ~/.claude/projects), so no facts
# row can tell which login was billed, and facts.tsv is append-only — a 15th
# field would be blank for every row already written and could never be
# back-filled without a --rebuild that only recovers what the transcripts still
# hold. A side table can be thrown away and rebuilt from scratch at any time.
#
# What does know the answer is each config dir's own history.jsonl: it lists the
# sessions started under that login. Headless `-p` runs write no history line,
# so a second pass classifies whatever is left by the directory it was launched
# in — the same rules tagents already uses to pick a profile.
ACCOUNTS="$STATE/accounts.tsv"

# THE BILL IS NOT THE LIST PRICE. An Enterprise seat is metered at whatever the
# contract says — on this account a flat 0.90 of list, two days running — and
# the meter in `/usage` is the only figure that is actually billed. --meter now
# fetches that reading itself and calls this for every account it reads, so the
# factor follows the meter without anybody typing it; by hand it is still one
# command, and the only way to price an account whose meter cannot be reached:
# `--calibrate work 732.71`
# takes that reading, divides it by the month-to-date this index computes for the
# same instant, and keeps the factor per account. From then on --daily reports
# dollars the meter would agree with; --sessions and --burn stay at list, since
# they are read next to the CLI's own list-price ledger. TU_NO_FACTOR=1 turns the
# scaling off for one call — the calibration itself needs the unscaled number.
FACTOR="$STATE/factor.tsv"           # account<TAB>factor<TAB>read at (epoch)<TAB>amount

factor_arg() {  # -> "acct=factor;..." for awk, empty when off or absent
  [ -z "${TU_NO_FACTOR:-}" ] || return 0
  [ -s "$FACTOR" ] || return 0
  awk -F"$TAB" '$2 + 0 > 0 { printf "%s=%s;", $1, $2 }' "$FACTOR"
}

calibrate() {  # <account> <amount> [at]
  local acct=${1:-} amt=${2:-} at=${3:-} epoch mtd f tmp
  [ -n "$acct" ] && [ -n "$amt" ] || { echo "tusage: --calibrate <account> <amount> [--at when]" >&2; return 2; }
  case "$amt" in ''|*[!0-9.]*) echo "tusage: amount must be a number: $amt" >&2; return 2 ;; esac
  if [ -z "$at" ]; then epoch=$(date +%s)
  else
    case "$at" in
      *[!0-9]*) epoch=$(date -j -f '%Y-%m-%d %H:%M' "$at" +%s 2>/dev/null ||
                        date -d "$at" +%s 2>/dev/null) ;;
      *)        epoch=$at ;;
    esac
  fi
  [ -n "${epoch:-}" ] || { echo "tusage: cannot read the time: $at" >&2; return 2; }
  mtd=$(TU_NO_FACTOR=1 daily month "$epoch" |
          awk -F"$TAB" -v a="$acct" '$2 == a { s += $3 } END { printf "%.4f", s + 0 }')
  if ! awk -v m="$mtd" 'BEGIN { exit !(m + 0 > 0) }'; then
    echo "tusage: nothing indexed for $acct this month up to that instant — nothing to calibrate" >&2
    return 1
  fi
  f=$(awk -v a="$amt" -v m="$mtd" 'BEGIN { printf "%.4f", a / m }')
  if ! awk -v f="$f" 'BEGIN { exit !(f >= 0.3 && f <= 2.0) }'; then
    echo "tusage: a factor of $f (meter $amt vs indexed $mtd) is not a price, refusing" >&2
    return 1
  fi
  mkdir -p "$STATE" 2>/dev/null || return 1
  tmp="$FACTOR.tmp.$$"
  { [ -s "$FACTOR" ] && awk -F"$TAB" -v a="$acct" '$1 != a' "$FACTOR"
    printf '%s\t%s\t%s\t%s\n' "$acct" "$f" "$epoch" "$amt"; } >"$tmp" 2>/dev/null &&
    mv -f "$tmp" "$FACTOR"
  printf 'tusage: %s priced at x%s of list (meter $%s vs indexed $%s at %s)\n' \
    "$acct" "$f" "$amt" "$mtd" "$(date -r "$epoch" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "$epoch")"
  return 0
}

# TU_ACCOUNTS is "name=dir;name=dir"; an empty dir means $HOME/.claude, the
# default config dir. Unset, the accounts are discovered: the default one plus
# every ~/.claude-* directory that keeps a history. Dirs are deduped by their
# real path because ~/.claude-personal is a symlink to ~/.claude-d, and reading
# both would double-count every personal session.
account_dirs() {
  local spec=${TU_ACCOUNTS:-} d n ent
  if [ -z "$spec" ]; then
    spec="default="
    for d in "$HOME"/.claude-*/; do
      [ -f "${d}history.jsonl" ] || continue
      n=$(basename "${d%/}"); n=${n#.claude-}
      spec="$spec;$n=${d%/}"
    done
  fi
  # The trailing newline is not decoration: `read` drops a final line that has
  # none, which silently loses the last account in the list.
  printf '%s\n' "$spec" | tr ';' '\n' | while IFS= read -r ent; do
    [ -n "$ent" ] || continue
    n=${ent%%=*}; d=${ent#*=}
    [ -n "$d" ] || d="$HOME/.claude"
    d=$(cd "$d" 2>/dev/null && pwd -P) || continue
    printf '%s\t%s\n' "$n" "$d"
  done | awk -F"$TAB" '!seen[$2]++'
}

# ---------------------------------------------------------------------------
#  The meter — what the account itself says it has spent
# ---------------------------------------------------------------------------
#
# A TYPED-IN READING IS STALE THE DAY AFTER IT IS TAKEN. The calibration factor
# above drifted from 0.98 to 0.73 in two days and the dashboard read $1108
# against a meter of $830; against Claude Code's own per-session ledger the
# estimate is wrong in both directions, so no single ratio can be trusted for
# long. The figure the account is actually billed is one authenticated GET
# away: `/api/oauth/usage` answers with the month-to-date spend and the limit
# behind it, for whichever login owns the OAuth token in the keychain. So the
# month becomes the meter, the index keeps only the shape of the days, and
# calibrate() is re-run from each reading so --daily agrees with it too.
#
# HOW OFTEN. The dashboard's refresher calls --update every few seconds, so the
# TTL in the row IS the rate limit: TU_METER_TTL (900s) normally, 300s once the
# account is past 90% of its limit, 5 minutes after a failure and a day after an
# account that has no meter at all — a plan seat answers without a spend object,
# and asking it again this hour will not change that.
#
# THE TOKEN NEVER LEAVES THE PROCESS. It is read out of the keychain into a
# shell variable, handed to curl as one header, and dropped. It is never
# printed, never logged, and nothing derived from it is written to meter.tsv.
METER="$STATE/meter.tsv"   # account<TAB>used<TAB>limit<TAB>fetched at<TAB>status<TAB>next try

meter_item() {  # <account> -> the keychain item holding its credentials, or 1
  local acct=${1:-} item dir home
  [ -n "$acct" ] || return 1
  # An explicit naming wins: a second login keeps its credentials under an item
  # only whoever set it up can know the name of.
  item=$(printf '%s' "${TU_METER_ITEMS:-}" | tr ';' '\n' |
           awk -F= -v a="$acct" '$1 == a { sub(/^[^=]*=/, ""); print; exit }')
  if [ -n "$item" ]; then printf '%s' "$item"; return 0; fi
  dir=$(account_dirs | awk -F"$TAB" -v a="$acct" '$1 == a { print $2; exit }')
  [ -n "$dir" ] || return 1
  home=$(cd "$HOME/.claude" 2>/dev/null && pwd -P) || return 1
  # Claude Code writes ONE keychain item, and it belongs to the default config
  # dir. Every other login has credentials somewhere this cannot guess.
  [ "$dir" = "$home" ] || return 1
  printf 'Claude Code-credentials'
}

meter_token() {  # <account> -> its OAuth access token, or 1
  local item tok
  item=$(meter_item "${1:-}") || return 1
  tok=$(security find-generic-password -s "$item" -w 2>/dev/null |
          jq -r '.claudeAiOauth.accessToken // empty' 2>/dev/null)
  [ -n "$tok" ] || return 1
  printf '%s' "$tok"
}

meter_field() {  # <account> <field number>
  [ -s "$METER" ] || return 1
  awk -F"$TAB" -v a="${1:-}" -v n="${2:-1}" '$1 == a { print $n; exit }' "$METER"
}

meter_put() {  # <account> <used> <limit> <fetched at> <status> <next try>
  local tmp
  mkdir -p "$STATE" 2>/dev/null || return 1
  tmp="$METER.tmp.$$"
  { [ -s "$METER" ] && awk -F"$TAB" -v a="$1" '$1 != a' "$METER"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" "$6"; } >"$tmp" 2>/dev/null &&
    mv -f "$tmp" "$METER"
}

meter_fetch() {  # <account> — one GET, one row, never more than one of either
  local acct=${1:-} tok body code now ttl pct um ue lm le used lim pu pl pt ps
  [ -n "$acct" ] || return 1
  now=$(date +%s)
  # A failed reading must not erase a good one: yesterday's figure with a
  # visible error beside it is worth more than a blank the dashboard would
  # silently fall back from.
  pu=$(meter_field "$acct" 2); pl=$(meter_field "$acct" 3)
  pt=$(meter_field "$acct" 4); ps=$(meter_field "$acct" 5)
  [ "${ps:-}" = ok ] || { pu=""; pl=""; pt=""; }

  tok=$(meter_token "$acct") || {
    meter_put "$acct" "$pu" "$pl" "$pt" error "$((now + 300))"
    return 1
  }
  body="$STATE/.meter.$$.json"
  code=$(curl -sS --max-time 8 -o "$body" -w '%{http_code}' \
           -H "Authorization: Bearer $tok" \
           -H "anthropic-beta: oauth-2025-04-20" \
           https://api.anthropic.com/api/oauth/usage 2>/dev/null)
  tok=""
  if [ "${code:-}" != 200 ]; then
    rm -f "$body" 2>/dev/null
    meter_put "$acct" "$pu" "$pl" "$pt" error "$((now + 300))"
    return 1
  fi
  um=$(jq -r '.spend.used.amount_minor // empty' "$body" 2>/dev/null)
  ue=$(jq -r '.spend.used.exponent // 2' "$body" 2>/dev/null)
  lm=$(jq -r '.spend.limit.amount_minor // empty' "$body" 2>/dev/null)
  le=$(jq -r '.spend.limit.exponent // 2' "$body" 2>/dev/null)
  pct=$(jq -r '.spend.percent // 0' "$body" 2>/dev/null)
  rm -f "$body" 2>/dev/null

  # A plan seat answers the same endpoint with no spend object at all. That is
  # an answer, not a failure, and it will still be the answer tomorrow.
  case "${um:-}" in ''|*[!0-9]*)
    meter_put "$acct" "" "" "$now" nometer "$((now + 86400))"
    return 0 ;;
  esac
  case "${ue:-}" in ''|*[!0-9]*) ue=2 ;; esac
  used=$(awk -v m="$um" -v e="$ue" 'BEGIN { printf "%.2f", m / (10 ^ e) }')
  lim=""
  case "${le:-}" in ''|*[!0-9]*) le=2 ;; esac
  case "${lm:-}" in ''|*[!0-9]*) ;; *) lim=$(awk -v m="$lm" -v e="$le" 'BEGIN { printf "%.2f", m / (10 ^ e) }') ;; esac

  ttl=${TU_METER_TTL:-900}
  case "$ttl" in ''|*[!0-9]*) ttl=900 ;; esac
  case "${pct:-}" in ''|*[!0-9]*) pct=0 ;; esac
  # Near the wall the figure is the one being watched, so it is refreshed at
  # three times the rate. A shorter TTL asked for on purpose still wins.
  if [ "$pct" -ge 90 ] && [ "$ttl" -gt 300 ]; then ttl=300; fi
  meter_put "$acct" "$used" "$lim" "$now" ok "$((now + ttl))" || return 1

  # The meter prices the month; the factor makes --daily and the sparkline agree
  # with it, which is what calibrate() has always done — it is just no longer a
  # human typing the reading. A refusal is a note on stderr, not a failure: the
  # row is good even when the ratio it implies is not a price.
  calibrate "$acct" "$used" >/dev/null
  return 0
}

meter_refresh() {  # [--force] [account…]
  local force=0 acct list now nt st at
  [ -z "${TU_NO_METER:-}" ] || return 0
  case "${1:-}" in --force) force=1; shift ;; esac
  now=$(date +%s)
  if [ $# -eq 0 ]; then list=$(account_dirs | cut -f1 | tr '\n' ' '); else list=$*; fi
  for acct in $list; do
    [ -n "$acct" ] || continue
    if ! meter_item "$acct" >/dev/null 2>&1; then
      st=$(meter_field "$acct" 5)
      [ "${st:-}" = nometer ] ||
        meter_put "$acct" "$(meter_field "$acct" 2)" "$(meter_field "$acct" 3)" \
                  "$(meter_field "$acct" 4)" nometer "$((now + 86400))"
      continue
    fi
    if [ "$force" != 1 ]; then
      nt=$(meter_field "$acct" 6)
      case "${nt:-}" in ''|*[!0-9]*) nt=0 ;; esac
      # AN EXPLICIT TTL APPLIES TO THE READING ALREADY TAKEN, not only to the
      # next one: somebody who asks for a faster meter means now, not in the
      # quarter of an hour the last row was written with.
      case "${TU_METER_TTL:-}" in
        ''|*[!0-9]*) ;;
        *) if [ "$(meter_field "$acct" 5)" = ok ]; then
             at=$(meter_field "$acct" 4)
             case "${at:-}" in ''|*[!0-9]*) ;; *) nt=$((at + TU_METER_TTL)) ;; esac
           fi ;;
      esac
      [ "$now" -lt "$nt" ] && continue
    fi
    meter_fetch "$acct"
  done
  return 0
}

meter_show() {  # the rows, for a person
  local acct used lim at st nt when
  [ -s "$METER" ] ||
    { echo "tusage: no meter reading yet — tusage --meter --refresh" >&2; return 1; }
  printf '%-12s %10s %10s  %-16s %s\n' account used limit fetched status
  # A TAB IS IFS WHITESPACE EVEN WHEN IFS IS JUST A TAB, so `read` folds the
  # empty used/limit of a nometer row into one separator and hands the status to
  # the wrong variable. Fill the holes before reading them.
  awk -F"$TAB" -v OFS="$TAB" '{ for (i = 1; i <= 6; i++) if ($i == "") $i = "-"; print }' "$METER" |
  while IFS="$TAB" read -r acct used lim at st nt; do
    [ -n "$acct" ] || continue
    when="-"
    case "${at:-}" in [0-9]*) when=$(date -r "$at" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$at") ;; esac
    printf '%-12s %10s %10s  %-16s %s\n' "$acct" "$used" "$lim" "$when" "$st"
    case "$st" in
      nometer) printf '# %s: this login reports no spend meter (a plan seat, or credentials this cannot read) — the estimate stands alone\n' "$acct" ;;
      error)   printf '# %s: the last fetch failed; the figures above are the reading before it\n' "$acct" ;;
    esac
  done
}

# Writes $ACCOUNTS (sid<TAB>account) and prints it. Called with --locked from
# inside update(), which already holds the lock: taking it again would deadlock
# against ourselves, and the jq passes are the expensive part anyway, so they
# happen before the lock in either case and only the rename is protected.
account_map() {
  local locked=0 fresh=1 n d tmp rules spec
  [ "${1:-}" = "--locked" ] && locked=1
  mkdir -p "$STATE" 2>/dev/null || return 1

  # THE MAP IS ONLY AS GOOD AS THE SPEC IT WAS BUILT FROM. Rename an account or
  # change a rule and every sid keeps the names of the old spec until a history
  # file happens to move — which is how a status bar came to say $0 for an
  # account that had just been named under it. The spec is kept beside the map
  # and a different spec is a stale map, whatever the timestamps say.
  spec="${TU_ACCOUNTS:-}|${TU_ACCOUNT_RULES:-}"
  [ -s "$ACCOUNTS" ] || fresh=0
  [ -n "${TU_REFRESH_ACCOUNTS:-}" ] && fresh=0
  [ "$(cat "$ACCOUNTS.spec" 2>/dev/null)" = "$spec" ] || fresh=0
  if [ "$fresh" = 1 ]; then
    [ -e "$META" ] && [ "$META" -nt "$ACCOUNTS" ] && fresh=0
    while IFS="$TAB" read -r n d; do
      [ -f "$d/history.jsonl" ] && [ "$d/history.jsonl" -nt "$ACCOUNTS" ] && fresh=0
    done <<EOF
$(account_dirs)
EOF
  fi
  [ "$fresh" = 1 ] && { cat "$ACCOUNTS"; return 0; }

  tmp="$ACCOUNTS.tmp.$$"
  : >"$tmp.in"
  while IFS="$TAB" read -r n d; do
    [ -f "$d/history.jsonl" ] || continue
    jq -r --arg a "$n" 'select(.sessionId)|["H",.sessionId,(.timestamp//0),$a]|@tsv' \
      "$d/history.jsonl" 2>/dev/null >>"$tmp.in"
  done <<EOF
$(account_dirs)
EOF
  slug_map | sed 's/^/P\t/' >>"$tmp.in" 2>/dev/null
  [ -s "$META" ] && awk -F"$TAB" -v OFS="$TAB" '{ print "S", $1, $2 }' "$META" >>"$tmp.in"

  rules=${TU_ACCOUNT_RULES:-}
  awk -F"$TAB" -v OFS="$TAB" -v rules="$rules" -v home="$HOME" '
    BEGIN {
      n = split(rules, rr, ";")
      for (i = 1; i <= n; i++) {
        if (rr[i] ~ /^[ \t]*$/) continue
        if (!match(rr[i], /=[^=]*$/)) continue
        k = substr(rr[i], 1, RSTART - 1); v = substr(rr[i], RSTART + 1)
        if (substr(k, 1, 2) == "~/") k = home substr(k, 2)
        sub(/\/+$/, "", k)
        if (k == "" || v == "") continue
        NRULE++; RD[NRULE] = k; RN[NRULE] = v
      }
    }
    # Longest prefix wins, and only on a path-component boundary: ~/git/personalx
    # is not inside ~/git/personal, however much it looks like it.
    function ruleacct(dir,   i, k, best, bn) {
      best = ""; bn = "?"
      for (i = 1; i <= NRULE; i++) {
        k = RD[i]
        if (dir != k && !(index(dir, k) == 1 && substr(dir, length(k) + 1, 1) == "/")) continue
        if (length(k) > length(best)) { best = k; bn = RN[i] }
      }
      return bn
    }
    # One sid can appear in two histories (a session resumed under the other
    # login). The newest line wins, so the join stays single-valued instead of
    # emitting the session twice and double-counting its dollars.
    $1 == "H" { if (!($2 in HT) || $3 + 0 > HT[$2]) { HT[$2] = $3 + 0; HA[$2] = $4 } ; next }
    $1 == "P" { PD[$2] = $3; next }
    $1 == "S" { SL[$2] = $3; next }
    END {
      for (s in HA) print s, HA[s]
      for (s in SL) {
        if (s in HA) continue
        d = (SL[s] in PD) ? PD[SL[s]] : ""
        print s, (d == "" ? "?" : ruleacct(d))
      }
    }' "$tmp.in" | sort -u >"$tmp.out" 2>/dev/null

  # A reader must never see a half-written map, so the file appears whole or not
  # at all. Losing the lock is not an error: the old map is still valid, just a
  # session or two behind, and the next tick rewrites it.
  printf '%s\n' "$spec" >"$tmp.spec" 2>/dev/null
  if [ "$locked" = 1 ]; then
    mv -f "$tmp.out" "$ACCOUNTS" 2>/dev/null && mv -f "$tmp.spec" "$ACCOUNTS.spec" 2>/dev/null
  elif mkdir "$LOCK" 2>/dev/null; then
    mv -f "$tmp.out" "$ACCOUNTS" 2>/dev/null && mv -f "$tmp.spec" "$ACCOUNTS.spec" 2>/dev/null
    rm -rf "$LOCK" 2>/dev/null
  fi
  rm -f "$tmp.in" "$tmp.out" "$tmp.spec" 2>/dev/null
  cat "$ACCOUNTS" 2>/dev/null
  return 0
}

# sid -> the directory the session was launched in. The hook's cwd follows the
# Bash tool around, so it is useless as an identity; the first cwd recorded in
# the transcript is the launch directory and never changes.
origin_dir() {
  local sid=$1 slug=${2:-} cache="$STATE/origin.tsv" d f
  if [ -e "$cache" ]; then
    d=$(awk -F"$TAB" -v k="$sid" '$1==k { print $2; exit }' "$cache")
    [ -n "$d" ] && { printf '%s' "$d"; return 0; }
  fi
  f=$(ls -1 "$PROJECTS/$slug/$sid.jsonl" 2>/dev/null | head -1)
  [ -z "$f" ] && f=$(find "$PROJECTS" -name "$sid.jsonl" 2>/dev/null | head -1)
  if [ -n "$f" ]; then
    d=$(head -200 -- "$f" 2>/dev/null | jq -rc 'select(.cwd) | .cwd' 2>/dev/null | head -1)
  fi
  [ -z "$d" ] && d="?"
  printf '%s\t%s\n' "$sid" "$d" >>"$cache" 2>/dev/null
  printf '%s' "$d"
}

AWK_FMT='
  function human(x) {
    if (x >= 1e9) return sprintf("%.1fG", x/1e9)
    if (x >= 1e6) return sprintf("%.1fM", x/1e6)
    if (x >= 1e3) return sprintf("%.0fk", x/1e3)
    return sprintf("%d", x)
  }
  function cost(i, c5, c1, cr, o) { return i + 1.25*c5 + 2.0*c1 + 0.1*cr + 5*o }
  function bar(v, mx, w,   n, s, i) {
    n = (mx > 0) ? int(v / mx * w + 0.5) : 0
    s = ""; for (i = 0; i < w; i++) s = s (i < n ? "█" : "·")
    return s
  }
'

# Local-day arithmetic, shared by every report that has a day axis. The offset
# comes from a -v tz="$(date +%z)" the caller passes, and is decoded on first
# use rather than in a BEGIN block so a caller only has to supply the variable.
AWK_DAY='
  function tzinit(  zh, zm) {
    zh = substr(tz,2,2) + 0; zm = substr(tz,4,2) + 0
    OFFS = zh*3600 + zm*60; if (substr(tz,1,1) == "-") OFFS = -OFFS
    TZI = 1
  }
  function daykey(t)  { if (!TZI) tzinit(); return int((t + OFFS)/86400) }
  function hourkey(t) { if (!TZI) tzinit(); return int((t + OFFS)/3600) }
  function daystr(d,   z, y, m, dd, e, doe, yoe, doy, mp) {
    # civil-from-days, so no shelling out to date per row
    z = d + 719468
    e = (z >= 0 ? z : z - 146096) / 146097; e = int(e)
    doe = z - e*146097
    yoe = int((doe - int(doe/1460) + int(doe/36524) - int(doe/146096)) / 365)
    y = yoe + e*400
    doy = doe - (365*yoe + int(yoe/4) - int(yoe/100))
    mp = int((5*doy + 2)/153)
    dd = doy - int((153*mp+2)/5) + 1
    m = mp + (mp < 10 ? 3 : -9)
    y += (m <= 2)
    return sprintf("%04d-%02d-%02d", y, m, dd)
  }
'

report_by() {
  local dim=$1 since=$2 cut
  cut=$(( $(date +%s) - $(since_secs "$since") ))
  [ -s "$FACTS" ] || { echo "tusage: no data yet — run 'tusage --rebuild'" >&2; return 1; }

  { slug_map | sed 's/^/P\t/'; cat "$FACTS"; } |
  awk -F"$TAB" -v cut="$cut" -v dim="$dim" -v tz="$(date +%z)" -v home="$HOME" \
      "$AWK_FMT$AWK_DAY"'
    BEGIN { R = "\033[0m"; DIM = "\033[90m"; B = "\033[1m" }
    function tilde(p) { return (index(p, home) == 1) ? "~" substr(p, length(home)+1) : p }
    $1 == "P" { pdir[$2] = $3; next }
    $1 + 0 < cut { next }
    {
      proj = ($2 in pdir) ? tilde(pdir[$2]) : $2
      if      (dim == "day")      k = daystr(daykey($1))
      else if (dim == "hour")     k = daystr(daykey($1)) sprintf(" %02d:00", hourkey($1) % 24)
      else if (dim == "project")  k = proj
      else if (dim == "session")  k = substr($3, 1, 8) "  " proj
      else if (dim == "model")    k = $7
      else if (dim == "workflow") { if ($6 !~ /^wf:/) next; k = $6 "  " proj }
      else if (dim == "agent") {
        if ($4 == "-")           k = "· main session"
        else if ($6 ~ /^wf:/)    k = "⑂ workflow agent"
        else                     k = "⑂ " $5 ($6 == "bg" ? " (bg)" : "")
      }
      else                        k = proj
      if (!(k in seen)) { seen[k] = 1; order[++n] = k }
      REQ[k] += $8; IN[k] += $9; C5[k] += $10; C1[k] += $11; CR[k] += $12; OUT[k] += $13
      if ($14 + 0 > CX[k]) CX[k] = $14 + 0
      C[k] = cost(IN[k], C5[k], C1[k], CR[k], OUT[k])
      if (C[k] > mx) mx = C[k]
      TOT += cost($9, $10, $11, $12, $13); TREQ += $8
    }
    END {
      if (n == 0) { print "no data in this window" > "/dev/stderr"; exit 1 }
      printf "%s%-36s %8s %7s %8s %8s %8s %8s  %s%s\n", DIM, dim,
             "cost", "reqs", "cwrite", "cread", "out", "maxctx", "share", R
      # sort by cost, descending — the answer to "who ate it" should be line 1
      for (i = 1; i <= n; i++) for (j = i + 1; j <= n; j++)
        if (C[order[j]] > C[order[i]]) { t = order[i]; order[i] = order[j]; order[j] = t }
      for (i = 1; i <= n; i++) {
        k = order[i]
        printf "%-36.36s %8s %7d %8s %8s %8s %7.0fk  %s%s%s %s%4.1f%%%s\n",
               k, human(C[k]), REQ[k], human(C5[k] + C1[k]), human(CR[k]),
               human(OUT[k]), CX[k]/1000,
               DIM, bar(C[k], mx, 14), R, DIM, 100*C[k]/TOT, R
      }
      printf "%s%-36s %8s %7d%s\n", DIM, "TOTAL", human(TOT), TREQ, R
    }'
}

# sid, cost, reqs, ctx, last_ts, slug, subagent_cost, live_subagents, cost_5h,
#   model, usd, usd_5h, usd_subagent, unpriced
# ctx is the largest context seen in the last hour — the number that says
# "this session is fat, compact it", which an average over the window hides.
#
# `model` is the session's CURRENT model — the one the newest row was billed at,
# which is what a status line should show. The dollar figures are emphatically
# not derived from it: each row is priced at its own model (see usd), so a
# session that switched tiers mid-conversation, or fanned work out to subagents
# on a cheaper one, still totals correctly. Subagent rows are in the session
# total AND in usd_subagent, which is a subset of it, not an addition.
# `unpriced` counts rows whose model has no published rate; when it is non-zero
# the dollar figures are a floor, not the whole bill.
sessions() {
  [ -s "$FACTS" ] || return 0
  local now; now=$(date +%s)
  awk -F"$TAB" -v OFS="$TAB" -v cut="$(( now - $(since_secs "${1:-7d}") ))" \
      -v h1="$(( now - 3600 ))" -v h5="$(( now - 18000 ))" \
      -v prices="$(prices_arg)" "$AWK_PRICE"'
    function cost(i,c5,c1,cr,o) { return i + 1.25*c5 + 2.0*c1 + 0.1*cr + 5*o }
    $1 + 0 >= cut {
      s = $3; c = cost($9,$10,$11,$12,$13)
      d = usd($7, $1 + 0, $9,$10,$11,$12,$13)
      # An unpriced row that spent nothing is not a hole in the bill: Claude Code
      # writes a zero-token "<synthetic>" placeholder that would otherwise make
      # every session claim its total was incomplete.
      if (d < 0) { d = 0; if (c > 0) UNP[s]++ }
      C[s] += c; R[s] += $8; P[s] = $2
      D[s] += d
      if ($1 + 0 >= h5) { C5H[s] += c; D5H[s] += d }
      if ($1 + 0 >= h1 && $14 + 0 > X[s]) X[s] = $14 + 0
      if ($14 + 0 > XMAX[s]) XMAX[s] = $14 + 0
      if ($1 + 0 > L[s]) L[s] = $1 + 0
      # The newest row that actually spent something wins the model column, so a
      # mid-session /model shows up at once — but the placeholder never does.
      if (c > 0 && $1 + 0 >= LM[s]) { LM[s] = $1 + 0; MDL[s] = $7 }
      if ($4 != "-") { SUB[s] += c; DSUB[s] += d; NSUB[s SUBSEP $4] = ($1 + 0) }
    }
    END { for (s in C) {
        k = 0
        for (q in NSUB) { split(q, a, SUBSEP); if (a[1] == s && NSUB[q] >= h1) k++ }
        print s, int(C[s]), R[s], int(X[s] ? X[s] : XMAX[s]), L[s], P[s],
              int(SUB[s]), k, int(C5H[s]),
              MDL[s], sprintf("%.6f", D[s]), sprintf("%.6f", D5H[s]),
              sprintf("%.6f", DSUB[s]), UNP[s] + 0 } }' "$FACTS"
}

# day<TAB>account<TAB>usd<TAB>reqs<TAB>unpriced — one row per local day per
# login, no header, sorted by day then account, for a spend chart or a monthly
# reckoning. Machine-readable on purpose: report_by's table prints cost units
# and a bar, which is the wrong shape for money someone is going to add up.
#
# Sessions the account map cannot place print as "?" rather than falling into a
# default, because a wrong login is worse than a visible hole.
daily() {
  [ -s "$FACTS" ] || return 0
  local cut upto; cut=$(( $(date +%s) - $(since_secs "${1:-7d}") ))
  # --until cuts the far end, so a window can be closed at both ends: the meter
  # calibration in tagents needs the month AS OF the instant the meter was read.
  upto=${2:-0}; case "$upto" in ''|*[!0-9]*) upto=0 ;; esac
  { account_map | sed 's/^/A\t/'; cat "$FACTS"; } |
  awk -F"$TAB" -v OFS="$TAB" -v cut="$cut" -v upto="$upto" -v tz="$(date +%z)" \
      -v prices="$(prices_arg)" -v factors="$(factor_arg)" "$AWK_PRICE$AWK_DAY"'
    BEGIN {
      nf = split(factors, fr, ";")
      for (i = 1; i <= nf; i++) if (fr[i] != "") { split(fr[i], q, "="); FAC[q[1]] = q[2] + 0 }
    }
    $1 == "A" { ACC[$2] = ($3 == "" ? "?" : $3); next }
    $1 + 0 < cut { next }
    upto > 0 && $1 + 0 > upto { next }
    {
      a = ($3 in ACC) ? ACC[$3] : "?"
      k = daystr(daykey($1)) SUBSEP a
      d = usd($7, $1 + 0, $9,$10,$11,$12,$13)
      # The contract rate, when a meter reading taught us one — see calibrate.
      if (d > 0 && (a in FAC)) d *= FAC[a]
      c = $9 + 1.25*$10 + 2.0*$11 + 0.1*$12 + 5*$13
      # Same rule as --sessions: a zero-token row on an unknown model is the
      # "<synthetic>" placeholder, not a hole in the bill.
      if (d < 0) { d = 0; if (c > 0) UNP[k]++ }
      USD[k] += d; RQ[k] += $8; SEEN[k] = 1
    }
    END {
      for (k in SEEN) { split(k, p, SUBSEP)
        printf "%s\t%s\t%.4f\t%d\t%d\n", p[1], p[2], USD[k], RQ[k], UNP[k] + 0 }
    }' |
  sort -t"$TAB" -k1,1 -k2,2
}

burn() {   # what the last 5h cost, for the tmux status bar
  [ -s "$FACTS" ] || return 0
  awk -F"$TAB" -v cut="$(( $(date +%s) - 18000 ))" -v prices="$(prices_arg)" "$AWK_PRICE"'
    function human(x) { if (x >= 1e6) return sprintf("%.1fM", x/1e6)
                        if (x >= 1e3) return sprintf("%.0fk", x/1e3); return sprintf("%d", x) }
    $1 + 0 >= cut {
      c = $9 + 1.25*$10 + 2.0*$11 + 0.1*$12 + 5*$13; T += c; S[$3] += c
      d = usd($7, $1 + 0, $9,$10,$11,$12,$13); if (d > 0) TD += d
    }
    END {
      if (T <= 0) exit 0
      # Money is the honest threshold now that a bar can mix a $5 and a $10
      # model: the same token count is two different bills.
      printf "#[fg=#665c54]5h #[fg=%s]%s ", (TD > 200 ? "red" : TD > 100 ? "yellow" : "#928374"), money(TD)
    }' "$FACTS"
}

session_detail() {
  local sid=$1 full slug
  [ -s "$FACTS" ] || return 1
  # accept a short prefix; everything downstream needs the full id
  full=$(awk -F"$TAB" -v k="$sid" 'index($1, k) == 1 { print $1; exit }' "$META" 2>/dev/null)
  [ -n "$full" ] && sid=$full
  slug=$(awk -F"$TAB" -v k="$sid" '$1 == k { print $2; exit }' "$META" 2>/dev/null)
  printf '\033[1m%s\033[0m  %s\n' "$sid" "$(origin_dir "$sid" "$slug")"
  awk -F"$TAB" -v k="$sid" -v prices="$(prices_arg)" "$AWK_FMT$AWK_PRICE"'
    $3 ~ "^" k {
      a = ($4 == "-" ? "· main" : ($6 ~ /^wf:/ ? "⑂ " $6 : "⑂ " $5 ($6 == "bg" ? " (bg)" : "")))
      REQ[a] += $8; IN[a] += $9; C5[a] += $10; C1[a] += $11; CR[a] += $12; OUT[a] += $13
      if (!(a in seen)) { seen[a] = 1; ord[++n] = a }
      if ($1 + 0 > last) { last = $1 + 0 }
      c = cost($9,$10,$11,$12,$13)
      d = usd($7, $1 + 0, $9,$10,$11,$12,$13)
      if (d < 0) { d = 0; if (c > 0) { UNP++; MUNP[$7] = 1 } }
      T += c; TD += d; DOL[a] += d
      # Per model, so a mid-session switch is visible as two priced rows rather
      # than one blended number that matches neither rate.
      MC[$7] += c; MD[$7] += d
      if (!($7 in mseen) && c > 0) { mseen[$7] = 1; mord[++mn] = $7 }
    }
    END {
      if (n == 0) { print "  (no usage recorded in the retained window)"; exit }
      printf "\033[90m  %-26s %8s %8s %7s %8s %8s %8s\033[0m\n", "who", "cost", "$", "reqs", "cwrite", "cread", "out"
      for (i = 1; i <= n; i++) { a = ord[i]
        printf "  %-26.26s %8s %8s %7d %8s %8s %8s\n", a, human(cost(IN[a],C5[a],C1[a],CR[a],OUT[a])),
               money(DOL[a]), REQ[a], human(C5[a]+C1[a]), human(CR[a]), human(OUT[a]) }
      printf "\033[90m  %-26s %8s %8s\033[0m\n", "TOTAL", human(T), money(TD)
      if (mn > 1 || UNP) {
        printf "\n\033[90m  %-26s %8s %8s\033[0m\n", "model", "cost", "$"
        for (i = 1; i <= mn; i++) { m = mord[i]
          printf "  %-26.26s %8s %8s%s\n", m, human(MC[m]), money(MD[m]),
                 ((m in MUNP) ? "  \033[33m(no published rate)\033[0m" : "") }
      }
      if (UNP) printf "\033[33m  %d request(s) ran on a model with no published rate — $ is a floor\033[0m\n", UNP
    }' "$FACTS"
}

summary() {
  local now; now=$(date +%s)
  [ -s "$FACTS" ] || { echo "tusage: no data yet — run 'tusage --rebuild'" >&2; return 1; }
  { slug_map | sed 's/^/P\t/'; cat "$FACTS"; } |
  awk -F"$TAB" -v now="$now" -v home="$HOME" "$AWK_FMT"'
    BEGIN { R = "\033[0m"; DIM = "\033[90m"; B = "\033[1m" }
    function tilde(p) { return (index(p, home) == 1) ? "~" substr(p, length(home)+1) : p }
    # pad by CHARACTERS: macOS awk counts bytes, so a "⑂" would eat three of them
    function uclen(s,   i, n, c) { n = 0
      for (i = 1; i <= length(s); i++) { c = substr(s, i, 1)
        if (c >= "\200" && c <= "\277") continue; n++ }
      return n }
    function upad(s, w,   n) { n = uclen(s); return (w > n) ? s sprintf("%" (w-n) "s", "") : s }
    $1 == "P" { pdir[$2] = $3; next }
    {
      c = cost($9,$10,$11,$12,$13); age = now - ($1 + 0)
      if (age <= 18000) { W5 += c; W5R += $8; if ($14 + 0 > W5X) W5X = $14 + 0 }
      if (age <= 86400) { D1 += c; D1R += $8 }
      if (age <= 604800) { D7 += c; D7R += $8
        P[$2] += c
        if ($4 == "-") MAIN += c
        else { SUBC += c
               SA[$6 ~ /^wf:/ ? "workflow agent" : $5 ($6 == "bg" ? " (bg)" : "")] += c
               if ($6 ~ /^wf:/) { WF[$6] += c; WFR[$6] += $8 } }
        CW += $10 + $11; CW5 += $10; CW1 += $11; CR += $12; OU += $13; INP += $9
        if ($14 + 0 > 200000) BIG += $8
        TREQ += $8
      }
    }
    END {
      printf "%s cost = input-token equivalents: in + 1.25*cw5m + 2*cw1h + 0.1*cread + 5*out%s\n\n", DIM, R
      printf "%slast 5 h%s   %s%10s%s   %5d requests   %speak ctx %.0fk%s\n", B, R, B, human(W5), R, W5R, DIM, W5X/1000, R
      printf "%slast 24 h%s  %s%10s%s   %5d requests\n", B, R, B, human(D1), R, D1R
      printf "%slast 7 d%s   %s%10s%s   %5d requests\n\n", B, R, B, human(D7), R, D7R

      printf "%swhere it goes (7 d)%s\n", B, R
      wcw = 1.25*CW5 + 2.0*CW1; wcr = 0.1*CR; wou = 5*OU; wt = INP + wcw + wcr + wou
      printf "  cache WRITE %10s raw -> %9s  %s%s %2.0f%%%s\n", human(CW), human(wcw), DIM, bar(wcw, wt, 22), 100*wcw/wt, R
      printf "  cache READ  %10s raw -> %9s  %s%s %2.0f%%%s\n", human(CR), human(wcr), DIM, bar(wcr, wt, 22), 100*wcr/wt, R
      printf "  output      %10s raw -> %9s  %s%s %2.0f%%%s\n", human(OU), human(wou), DIM, bar(wou, wt, 22), 100*wou/wt, R
      if (TREQ) printf "  %s%.0f%% of requests carry more than 200k of context%s\n", DIM, 100*BIG/TREQ, R

      printf "\n%stop projects (7 d)%s\n", B, R
      for (p in P) if (P[p] > pm) pm = P[p]
      k = 0; for (p in P) arr[++k] = P[p] SUBSEP p
      for (i = 1; i <= k; i++) for (j = i+1; j <= k; j++) {
        split(arr[i], x, SUBSEP); split(arr[j], y, SUBSEP)
        if (y[1] + 0 > x[1] + 0) { t = arr[i]; arr[i] = arr[j]; arr[j] = t } }
      for (i = 1; i <= k && i <= 6; i++) { split(arr[i], x, SUBSEP)
        printf "  %-42.42s %9s  %s%s%s\n",
               (x[2] in pdir ? tilde(pdir[x[2]]) : x[2]), human(x[1]), DIM, bar(x[1], pm, 16), R }

      printf "\n%smain sessions vs everything they spawn (7 d)%s\n", B, R
      tot = MAIN + SUBC + 0.001
      printf "  %s %9s  %s%s %2.0f%%%s\n", upad("main sessions", 42), human(MAIN), DIM, bar(MAIN, tot, 16), 100*MAIN/tot, R
      k = 0; for (a in SA) arr2[++k] = SA[a] SUBSEP a
      for (i = 1; i <= k; i++) for (j = i+1; j <= k; j++) {
        split(arr2[i], x, SUBSEP); split(arr2[j], y, SUBSEP)
        if (y[1] + 0 > x[1] + 0) { t = arr2[i]; arr2[i] = arr2[j]; arr2[j] = t } }
      for (i = 1; i <= k && i <= 7; i++) { split(arr2[i], x, SUBSEP)
        printf "  %s %9s  %s%s %2.0f%%%s\n", upad("⑂ " x[2], 42), human(x[1]), DIM, bar(x[1], tot, 16), 100*x[1]/tot, R }

      nwf = 0; for (w in WF) nwf++
      if (nwf) {
        printf "\n%sworkflow runs (7 d) — %d of them%s\n", B, nwf, R
        k = 0; for (w in WF) arr3[++k] = WF[w] SUBSEP w
        for (i = 1; i <= k; i++) for (j = i+1; j <= k; j++) {
          split(arr3[i], x, SUBSEP); split(arr3[j], y, SUBSEP)
          if (y[1] + 0 > x[1] + 0) { t = arr3[i]; arr3[i] = arr3[j]; arr3[j] = t } }
        for (i = 1; i <= k && i <= 5; i++) { split(arr3[i], x, SUBSEP)
          printf "  %-42.42s %9s  %s%d requests%s\n", x[2], human(x[1]), DIM, WFR[x[2]], R }
      }
    }'
  echo
  printf '\033[1mheaviest sessions (7 d)\033[0m\n'
  sessions 7d | sort -t"$TAB" -k2,2nr | head -8 |
  while IFS="$TAB" read -r sid c reqs ctx last slug subc nsub c5h; do
    printf '  \033[90m%-9.9s\033[0m %9s %6s req  ctx %5.0fk  sub %7s  \033[90m%s\033[0m\n' \
      "$sid" \
      "$(awk -v v="$c" 'BEGIN{ if (v>=1e6) printf "%.1fM", v/1e6; else if (v>=1e3) printf "%.0fk", v/1e3; else printf "%d", v }')" \
      "$reqs" "$(( ctx / 1000 ))" \
      "$(awk -v v="$subc" 'BEGIN{ if (v>=1e6) printf "%.1fM", v/1e6; else if (v>=1e3) printf "%.0fk", v/1e3; else printf "%d", v }')" \
      "$(origin_dir "$sid" "$slug")"
  done
}

json() {
  [ -s "$FACTS" ] || { echo '{"error":"no data"}'; return 1; }
  awk -F"$TAB" -v cut="$(( $(date +%s) - $(since_secs "${1:-7d}") ))" '
    function cost(i,c5,c1,cr,o) { return i + 1.25*c5 + 2.0*c1 + 0.1*cr + 5*o }
    $1 + 0 >= cut { C[$2 SUBSEP $3 SUBSEP ($4=="-"?"main":$5)] += cost($9,$10,$11,$12,$13)
                    R[$2 SUBSEP $3 SUBSEP ($4=="-"?"main":$5)] += $8 }
    END { printf "["; first = 1
      for (k in C) { split(k, a, SUBSEP)
        printf "%s{\"project\":\"%s\",\"session\":\"%s\",\"who\":\"%s\",\"cost\":%d,\"requests\":%d}",
               (first ? "" : ","), a[1], a[2], a[3], C[k], R[k]; first = 0 }
      print "]" }' "$FACTS"
}

# ---------------------------------------------------------------------------

SINCE=7d; UNTIL=""; DIM=""; DO_UPDATE=1; CAL_ACCT=""; CAL_AMT=""; CAL_AT=""
MET_REFRESH=0; MET_FORCE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --by)       DIM=${2:-project}; shift 2 ;;
    --since)    SINCE=${2:-7d}; shift 2 ;;
    --until)    UNTIL=${2:-}; shift 2 ;;
    --calibrate) DIM=__calibrate; CAL_ACCT=${2:-}; CAL_AMT=${3:-}; shift 3 ;;
    --at)       CAL_AT=${2:-}; shift 2 ;;
    --meter)    DIM=__meter; shift ;;
    --refresh)  MET_REFRESH=1; shift ;;
    --force)    MET_FORCE=1; shift ;;
    --sessions) DIM=__sessions; shift ;;
    --daily)    DIM=__daily; shift ;;
    --session)  DIM=__detail; SID=${2:-}; shift 2 ;;
    --burn)     DIM=__burn; shift ;;
    --json)     DIM=__json; shift ;;
    # The meter runs AFTER the index work and outside its lock: it is a network
    # call, and holding a lock across one would wedge every other tick behind it.
    --update)   update 0 1; URC=$?; meter_refresh; exit "$URC" ;;
    --rebuild)  update 1 1; exit $? ;;
    --no-update) DO_UPDATE=0; shift ;;
    # Print to the first non-comment line, never a hardcoded range: the header
    # grows, the range does not, and the help silently loses its tail.
    -h|--help)  awk 'NR > 2 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
    *)          echo "tusage: unknown option $1" >&2; exit 2 ;;
  esac
done

[ "$DO_UPDATE" = 1 ] && update 0

case "$DIM" in
  "")          summary ;;
  __sessions)  sessions "$SINCE" ;;
  __daily)     daily "$SINCE" "$UNTIL" ;;
  __calibrate) calibrate "$CAL_ACCT" "$CAL_AMT" "$CAL_AT" ;;
  __meter)     if [ "$MET_FORCE" = 1 ]; then meter_refresh --force
               elif [ "$MET_REFRESH" = 1 ]; then meter_refresh; fi
               meter_show ;;
  __detail)    session_detail "${SID:-}" ;;
  __burn)      burn ;;
  __json)      json "$SINCE" ;;
  *)           report_by "$DIM" "$SINCE" ;;
esac
