{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "tagents",
  "version": "0.8.1",
  "description": "The tagents contract for Claude Code: every tagents-core and tagents-knowledge verb and flag, every MCP tool schema and the public TypeScript API of the packages, regenerated from the code on every change, plus the tagents-knowledge MCP server.",
  "author": {
    "name": "Aliaksandr Skuratovich"
  },
  "repository": "https://github.com/SkuratovichA/tagents",
  "license": "MIT",
  "mcpServers": {
    "knowledge": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/packages/knowledge/bin/knowledge-mcp"
      ]
    },
    "tagents": {
      "command": "tagents-mcp",
      "args": [
        "--contract",
        "${CLAUDE_PLUGIN_ROOT}/contract.json"
      ]
    }
  },
  "metadata": {
    "digest": "sha256:f1ec2f1f8baac9ed2f8fcc510c9ead73f9736785e8ab1e3b2458c720eefc1bc2"
  }
}
