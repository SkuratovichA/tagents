#!/usr/bin/env bash
#
# tusage — token accounting for Claude Code, read straight from the transcripts
# in ~/.claude/projects. Answers "where did my limit go", per project, per
# session, per subagent.
#
#   tusage                      summary: last 5h window, today, last 7 days in
#                               cost units and dollars, by account when there are
#                               several, then the heaviest sessions by name
#   tusage --by <dims>          the spend as a table, nested by up to three of
#                               account, project, session, day, week, month,
#                               hour, agent, model, workflow (comma-separated)
#   tusage --by <dims> --breakdown
#                               one more level under the deepest: the model
#   tusage --since 5h|3d|month|YYYY-MM-DD
#                               window for --by (default 7d; month = since the 1st)
#   tusage --until <epoch>|YYYY-MM-DD
#                               close the window at that instant too
#   tusage --account <name>     only that account's sessions (repeatable)
#   tusage --project <text>     only projects whose directory holds the text
#                               (repeatable, any case)
#   tusage --top N              rows under each parent (default 12; 0 is all)
#   tusage --sort cost          a table by time lists its dearest rows first
#   tusage --compact            label, total, dollars and share only
#   tusage --tsv                the deepest rows, no header or colour, for a script
#   tusage --color auto|always|never
#                               colour on a terminal only, and never with NO_COLOR
#   tusage --calibrate <account> <amount> [--at "YYYY-MM-DD HH:MM"|<epoch>]
#                               price that account at a factor that makes the
#                               month-to-date equal what its own meter showed
#   tusage --meter [--refresh|--force]
#                               what the account's own meter says it has spent
#   tusage --sessions           machine-readable per-session totals (for tagents)
#   tusage --session <name|id|prefix>
#                               one session by main session and subagent; with
#                               --by, that session split by the dimensions
#   tusage --burn               one-line status-bar string
#   tusage --update             refresh the index and exit
#   tusage --rebuild            throw the index away and rescan everything
#   tusage --json               emit the current window as JSON
#   tusage --daily              day<TAB>account<TAB>usd<TAB>reqs<TAB>unpriced
#
# ACCOUNTS. The summary, --by account, --account and --daily split the bill by
# login. TU_ACCOUNTS is "name=dir;name=dir" (an empty dir means ~/.claude); unset,
# a terminal takes the accounts of the tagents config, the ones the dashboard
# names, and with no config naming any it is the default config dir plus every
# ~/.claude-* that keeps a history. TU_ACCOUNT_RULES is "dir=name;dir=name" and
# places the sessions no history.jsonl lists — headless -p runs write none — by
# the directory they were launched in. Anything still unplaced prints as "?".
#
# NAMES. A session is shown by the name it has in tagents, the typed one else its
# title, and by the start of its id when it has neither. --session takes a name
# (the whole one, else part of it, any case), an id or the start of one. A text
# that names no session exits 1, one that names several lists them and exits 3,
# an empty one exits 2.
#
# THE DOLLARS ARE AN ESTIMATE, NOT A BILL: roughly 3% under Claude Code's own
# ledger on a large session and more on small ones, because retries, titles and
# away summaries never reach a transcript and so are never counted.
#
# EXCEPT FOR THE MONTH, WHICH IS THE METER. The account's own spend is one
# authenticated GET away — `/api/oauth/usage`, with the OAuth token Claude Code
# keeps in the keychain for the default config dir — and that figure is the one
# the bill is written from. --meter reads it into meter.tsv (one row per
# account, at most one fetch per account per call, TU_METER_TTL seconds apart —
# 900 by default, 300 past 90% of the limit), re-calibrates the per-day factor
# from it, and --update refreshes it in passing, which is how the dashboard gets
# it for free. TU_NO_METER=1 turns the whole thing off. The token is read into a
# variable, handed to curl as one header and dropped: it is never printed,
# never logged, and never written anywhere.
#
# WHY AN INDEX. 800 MB of transcripts across ~1300 files: a full scan costs a
# second and a half, which is fine once and far too slow for a dashboard that
# refreshes every two seconds. So the parsed byte offset of every file is
# remembered and only the tail is re-read.
#
# WHY DEDUPE. One API response is written to the transcript once per content
# block, each copy carrying the SAME usage object and the same requestId.
# Summing entries naively overcounts by ~2.2x. Everything here counts unique
# requestIds. Duplicates are adjacent in the file, so carrying the last few ids
# across an incremental read is enough to keep the seam honest.
#
# WHY A LOCK. That dedupe is per-process, and the index is append-only, so two
# updaters running at once both start from the same offset, both parse the same
# new bytes and both append them — and nothing downstream can tell, because the
# facts file records totals, not ids. The dashboard refreshes on a timer and
# `tusage` with no arguments updates too, so the sessions being typed into are
# exactly the ones that collide. Measured on a fixture: 13 requests indexed as
# 21. One updater at a time, `mkdir` as the atomic primitive (macOS has no
# flock); losing the race is not an error, the winner reads the same bytes.
#
# WHY "COST UNITS". Raw token counts are not comparable: a cached read is an
# order of magnitude cheaper than a fresh write, and output is several times
# more expensive than input. The `cost` column normalises everything to
# input-token equivalents using the published cache multipliers:
#
#     cost = input + 1.25*cache_write_5m + 2.0*cache_write_1h
#                  + 0.1*cache_read + 5*output
#
# It is a proxy for what a request actually costs you, not a billing figure.
# Raw totals are always available with --raw.
#
# For actual money, see PRICES below: every row is priced at the model that
# produced it, so a session that switched models mid-conversation — or spread
# work across subagents on a cheaper tier — still totals correctly. `--sessions`
# reports both, and `--session <id>` breaks a session down per subagent and per
# model.
#
# That figure is an ESTIMATE, and knowably a few percent low: it can only price
# requests that reached the transcript, and Claude Code also spends on calls
# that never do — retries, conversation titles, away summaries. Measured against
# Claude Code own ledger on a live session: 3% under on a large one, more on a
# small one where that fixed overhead weighs more. tagents prefers the ledger
# (via the status line) for the headline number and uses these figures for what
# the ledger cannot answer: subagent share, the 5h window, closed sessions.
#
# bash 3.2 compatible — macOS ships nothing newer.

set -uo pipefail

PROJECTS=${TU_PROJECTS:-$HOME/.claude/projects}
STATE=${TU_STATE:-$HOME/.claude/agent-state/usage}
OFFSETS="$STATE/offsets.tsv"
FACTS="$STATE/facts.tsv"
META="$STATE/sessions.tsv"
STAMP="$STATE/.stamp"
BUCKET=300                          # facts are aggregated into 5-minute buckets
# A CALENDAR MONTH IS THE UNIT A BILL IS WRITTEN IN. 30 days of facts cannot
# answer "what did this month cost" on the 31st, and cannot answer "how does it
# compare with last month" on any day at all. 62 days covers the longest month
# plus the one before it, which is the shortest retention that makes both
# questions answerable; the index costs ~2 MB a month, so the space is noise.
KEEP_DAYS=${TU_KEEP_DAYS:-62}
TAB=$'\t'

W_IN=1; W_CW5=1.25; W_CW1H=2.0; W_CR=0.1; W_OUT=5

# ---------------------------------------------------------------------------
#  Model prices — US dollars per million tokens
# ---------------------------------------------------------------------------
#  WHY A TABLE AND NOT ONE MULTIPLIER. The cost units above are comparable
#  across models but they are not money: a million Haiku tokens and a million
#  Fable tokens differ by a factor of ten. Dollars need the per-model rate.
#
#  And — this is the part worth doing properly — A SESSION'S MODEL CHANGES.
#  /model mid-conversation, a fallback after a refusal, a subagent deliberately
#  put on a cheaper tier. Pricing a session's whole token total at whatever
#  model it happens to be on right now is simply wrong, and wrong by 2x between
#  the two models this index actually holds. The facts index is already keyed
#  per model (field 7), so every row is priced at the model that produced it and
#  the session total is the sum. Subagent rows are priced the same way and are
#  part of that sum — a cheap courier and an expensive architect land in the
#  same session at their own rates.
#
#  Rows: <model> <input $/MTok> <output $/MTok> [<cache read $/MTok>
#        [<until epoch> <in> <out>]]
#  The read rate is optional and defaults to 0.1x the input rate, which is what
#  every model charges except Fable/Mythos 5.1, whose reads are $0.25/MTok —
#  0.025x their input, and cheaper per token than Opus 5's reads.
#  The tail after it is introductory pricing, applied to usage at or before that
#  instant; no model needs it today, and a row that wants one must state its
#  read rate first.
#
#  The write multipliers are ratios of the input rate and hold for every model:
#  a 5m write is 1.25x, a 1h write 2x.
#
#  A model with no row here is NOT guessed at — see usd(). Add one with
#  TU_PRICES rather than editing this file if you just need a rate today.
# ---------------------------------------------------------------------------
# Dollars per million tokens, input then output; an optional trailing
# "<until-epoch> <in> <out>" is an introductory rate that applies up to that
# instant. These are what a request is priced at; the cache multipliers below
# ride on top of the input rate.
#
# These are the published rates. An earlier table carried fable at 15/75, fitted
# against the ledger; that fit was absorbing a missing rate rather than finding a
# premium — fable's cache reads are $0.25/MTok, a quarter of the 0.1x this file
# assumed, and fable sessions are read-heavy. With the published rates plus that
# read rate, ledger/estimate over the eight largest fable-heavy sessions lands at
# 0.88-1.09 (the ledger runs a few percent high because it counts retries and
# title requests that never reach a transcript); at 15/75 the same sessions came
# out at 0.44-0.78, i.e. the estimate was up to twice the bill. There is no
# long-context premium either: Anthropic prices the whole 1M window at one rate
# ("a 900k-token request is billed at the same per-token rate as a 9k-token
# request"), so nothing here needs to vary with context size. Re-derive the same
# way if a rate ever stops matching: `tusage --session <id>` prints the per-model
# split, and agent-state/model/<id>.tsv holds the ledger figure to fit against.
PRICES=${TU_PRICES:-'
claude-fable-5-1   10 50 0.25
claude-mythos-5-1  10 50 0.25
claude-fable-5     10 50
claude-mythos-5    10 50
claude-opus-5       5 25
claude-opus-4-8     5 25
claude-opus-4-7     5 25
claude-opus-4-6     5 25
claude-sonnet-5     2 10
claude-sonnet-4-6   3 15
claude-haiku-4-5    1  5
'}

# BWK awk rejects a -v value containing newlines and fails silently enough to
# look like "nothing is priced", so the table crosses on one line.
prices_arg() { printf '%s' "$PRICES" | tr '\n' ';'; }

# Shared by every awk below that reports money.
AWK_PRICE='
  function price_load(  n, i, a, row) {
    PLOADED = 1
    n = split(prices, row, ";")
    for (i = 1; i <= n; i++) {
      if (row[i] ~ /^[ \t]*$/) continue
      split(row[i], a, " ")
      PN++; PK[PN] = a[1]; PIN[a[1]] = a[2] + 0; POUT[a[1]] = a[3] + 0
      PCR[a[1]] = (a[4] != "" ? a[4] + 0 : 0.1 * (a[2] + 0))
      if (a[5] != "") { PUNTIL[a[1]] = a[5] + 0; PIN0[a[1]] = a[6] + 0; POUT0[a[1]] = a[7] + 0 }
    }
  }
  # Transcripts carry dated snapshot ids (claude-haiku-4-5-20251001), so an
  # exact hit is tried first and the longest matching prefix second.
  function price_key(m,   i, k, best) {
    if (!PLOADED) price_load()
    if (m in PIN) return m
    best = ""
    for (i = 1; i <= PN; i++) {
      k = PK[i]
      if (index(m, k) == 1 && length(k) > length(best)) best = k
    }
    return best
  }
  # Dollars for one facts row. Returns -1 for a model with no published rate —
  # a caller must surface that rather than fold an unpriced model in as free,
  # which would quietly under-report the bill.
  function usd(m, ts, i, c5, c1, cr, o,   k, pin, pout, pcr) {
    k = price_key(m)
    if (k == "") return -1
    pin = PIN[k]; pout = POUT[k]; pcr = PCR[k]
    if ((k in PUNTIL) && ts <= PUNTIL[k]) { pin = PIN0[k]; pout = POUT0[k]; pcr = 0.1 * pin }
    return (i * pin + 1.25 * c5 * pin + 2.0 * c1 * pin + pcr * cr + o * pout) / 1000000
  }
  # What a "*" beside dollars means, in every report that prints one.
  function floor_note() { return "* marks dollars that are a floor: a request ran on a model with no published rate and counts as $0." }
  function money(d) {
    if (d < 0)     return "?"
    if (d >= 100)  return sprintf("$%.0f", d)
    if (d >= 10)   return sprintf("$%.1f", d)
    if (d >= 0.01) return sprintf("$%.2f", d)
    if (d > 0)     return "<$0.01"
    return "$0"
  }
'

mkdir -p "$STATE" 2>/dev/null

command -v jq >/dev/null 2>&1 || { echo "tusage: jq is required" >&2; exit 1; }

# ---------------------------------------------------------------------------
# extraction
# ---------------------------------------------------------------------------
# NB: every project directory begins with "-" (e.g. -Users-suka--git-work-x),
# so a relative path is parsed as an option by jq, tail, head and wc alike.
# Absolute paths are used everywhere below for exactly that reason.

EXTRACT='
  select(.type == "assistant" and (.message.usage != null))
  | .message.usage as $u
  | ($u.cache_creation // null) as $cc
  | [ (.requestId // .message.id // "-"),
      ((.timestamp // "") | if . == "" then 0
         else (sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601? // 0) end),
      (.sessionId // "-"),
      (.agentId // "-"),
      (.attributionAgent // "-"),
      (.sessionKind // "-"),
      (.message.model // "-"),
      ($u.input_tokens // 0),
      (if $cc then ($cc.ephemeral_5m_input_tokens // 0)
               else ($u.cache_creation_input_tokens // 0) end),
      (if $cc then ($cc.ephemeral_1h_input_tokens // 0) else 0 end),
      ($u.cache_read_input_tokens // 0),
      ($u.output_tokens // 0)
    ] | @tsv'

# Bytes of a file that end in a complete line, out of its first <size>. A
# transcript being appended to right now usually has a partial last line;
# consuming it would corrupt the offset and silently drop the record when the
# rest arrives. The size is the one the update took when it started, and every
# byte looked at here and parsed later is cut at it, so an append landing in
# between cannot make this answer and the bytes that are read disagree.
complete_bytes() {  # <file> <size>
  local f=$1 sz=${2:-0} part from
  [ "$sz" -gt 0 ] || { printf '0'; return 0; }
  # $( ) strips a trailing newline, so the byte comes back empty exactly when it
  # is one; dd seeks to it rather than reading the file up to it.
  if [ -z "$(dd if="$f" bs=1 skip=$((sz - 1)) count=1 2>/dev/null)" ]; then
    printf '%s' "$sz"
  else
    from=$(( sz > 4194304 ? sz - 4194303 : 1 ))
    part=$(tail -c "+$from" -- "$f" 2>/dev/null | head -c "$((sz - from + 1))" |
             tail -1 | wc -c | tr -d ' ')
    printf '%s' "$(( sz - ${part:-0} ))"
  fi
}

# Transcripts are NOT one file per session. A subagent gets its own file under
#   <project-slug>/<parent-session-id>/subagents/agent-<id>.jsonl
# and a Workflow run one file per agent under
#   <project-slug>/<parent-session-id>/subagents/workflows/wf_<id>/agent-<id>.jsonl
# Those nested files carry the PARENT's sessionId, so attribution is exact — but
# the project must come from the first path component, not from dirname, or every
# workflow shows up as a project of its own. Verified: no requestId appears in
# both a parent file and a nested one, so per-file dedupe cannot double-count.
#
# The answer is set in PF_SLUG and PF_ORIGIN (main|sub|wf:<id>) rather than
# printed: this runs once per transcript an update reads, and a subshell for
# each was a good part of what a catch-up over two thousand of them cost.
path_facets() {  # <abs path>
  local rel=${1#"$PROJECTS"/} rest
  PF_SLUG=${rel%%/*}; rest=${rel#*/}
  case "$rest" in
    */workflows/wf_*/*) rest=${rest#*/workflows/}; PF_ORIGIN="wf:${rest%%/*}" ;;
    */subagents/*)      PF_ORIGIN=sub ;;
    *)                  PF_ORIGIN=main ;;
  esac
}

# A TRANSCRIPT IS THE SAME FILE WHEREVER CLAUDE CODE PUTS IT. A session started
# in a worktree lives under the worktree's slug; when the worktree is deleted the
# very same files reappear under the parent project's slug. Keyed by absolute
# path, the index saw a brand-new file each time and re-read it from byte 0, so
# every request in it was counted again — one live session was indexed under
# three slugs and $162 of the $285 charged to it was the copies.
#
# The identity that survives the move is session-relative: the sid for the main
# transcript, and the sid plus the path below its directory for a subagent or
# workflow file. Everything above that (the project slug) is where the file
# happens to live today.
#
# In awk, because every pass that keys paths keys a whole list of them at once.
# The caller passes -v pref="$PROJECTS/".
AWK_KEY='
  function tkey(p,   i) {  # <abs path> -> "<sid>" | "<sid>/subagents/..."
    if (index(p, pref) == 1) p = substr(p, length(pref) + 1)
    i = index(p, "/"); if (i > 0) p = substr(p, i + 1)
    sub(/\.jsonl$/, "", p)
    return p
  }
'

# mtime<TAB>size<TAB>path of every path listed in <in> that still exists, in one
# stat for the lot instead of a stat per path. Newest-copy-wins needs the mtime
# and the reader the size, and BSD and GNU stat spell both differently: GNU
# answers -f with filesystem info instead of failing, so the BSD spelling is
# kept only when its first line comes back as digits.
stat_all() {  # <in: one path per line> <out>
  : >"$2"
  [ -s "$1" ] || return 0
  tr '\n' '\0' <"$1" | xargs -0 stat -f '%m%t%z%t%N' >"$2" 2>/dev/null
  case "$(head -1 "$2")" in
    [0-9]*"$TAB"[0-9]*"$TAB"*) ;;
    *) tr '\n' '\0' <"$1" | xargs -0 stat --printf '%Y\t%s\t%n\n' >"$2" 2>/dev/null ;;
  esac
}

# facts rows: bucket, project-slug, sid, agentid, agenttype, kind, model,
#             reqs, in, cw5, cw1h, cr, out, maxctx, lastctx
#
# maxctx is the largest context of any request in the bucket; lastctx is the
# context of the NEWEST request of the bucket's session and agent, by timestamp.
# They differ exactly when the context shrank inside the bucket, which is what a
# compaction does, and only lastctx answers "how big is this chat now".
#
# lastctx is per (bucket, session, agent), not per row: a row is also split by
# model and kind, so a zero-token "<synthetic>" placeholder written after the
# real request would otherwise be the newest of a row of its own, and a model
# switch inside the bucket would make the answer depend on which row came first.
# A request with no context at all never counts as the newest — it is not a
# request that says anything about the size of the chat.
#
# THE TWO FORMATS. facts.tsv is append-only and is trimmed, never rewritten, so
# rows written before this column existed keep 14 fields for as long as they
# live. A reader tells them apart by NF: a row with 15 fields has a lastctx, a
# row with 14 has only maxctx, which then stands in for it. No --rebuild is
# needed, and the stand-in is only wrong for a bucket that held a compaction.
#
# The facts and session rows are appended straight to the two files named, and
# only the ids to carry are printed, so the caller reads one line back instead
# of sorting the output into three with a grep and a cut each.
fold_rows() {  # <project-slug> <carried ids> <origin> <facts out> <sessions out> ; extracted TSV on stdin
  LC_ALL=C awk -F"$TAB" -v OFS="$TAB" -v proj="$1" -v seen0="$2" -v origin="$3" -v bucket="$BUCKET" \
      -v ff="$4" -v mf="$5" '
    BEGIN { n = split(seen0, carry, ","); for (i = 1; i <= n; i++) if (carry[i] != "") seen[carry[i]] = 1 }
    {
      id = $1
      if (id in seen) next
      seen[id] = 1
      tail[++t] = id
      # attributionAgent is absent in nested transcripts of some versions; the
      # path always knows what the file is, so it is the fallback.
      who = $5
      if (who == "-" || who == "") who = (origin == "main" ? "-" : (origin == "sub" ? "subagent" : "workflow"))
      kind = $6
      if (kind == "-" && origin != "main") kind = (origin == "sub" ? "sub" : origin)
      b = int($2 / bucket) * bucket
      k = b SUBSEP $3 SUBSEP $4 SUBSEP who SUBSEP kind SUBSEP $7
      if (!(k in R)) { order[++m] = k }
      ctx = $8 + $9 + $10 + $11
      R[k]++; I[k] += $8; C5[k] += $9; C1[k] += $10; CR[k] += $11; O[k] += $12
      if (ctx > X[k]) X[k] = ctx
      g = b SUBSEP $3 SUBSEP $4; G[k] = g
      if (ctx > 0 && (!(g in LT) || $2 + 0 >= LT[g])) { LT[g] = $2 + 0; LX[g] = ctx }
      if (!($3 in fts) || $2 < fts[$3]) fts[$3] = $2
      if (!($3 in lts) || $2 > lts[$3]) lts[$3] = $2
      mdl[$3] = $7
    }
    END {
      for (i = 1; i <= m; i++) {
        k = order[i]; split(k, a, SUBSEP)
        print a[1], proj, a[2], a[3], a[4], a[5], a[6], R[k], I[k], C5[k], C1[k], CR[k], O[k], X[k], LX[G[k]] + 0 >> ff
      }
      for (s in fts) print s, proj, fts[s], lts[s], mdl[s] >> mf
      # the last few ids, so the next incremental read does not double-count a
      # response whose content blocks straddle the seam
      out = ""
      for (i = (t > 32 ? t - 31 : 1); i <= t; i++) out = out (out == "" ? "" : ",") tail[i]
      print out
    }'
}

# ONE UPDATER AT A TIME, or the index inflates. facts.tsv is append-only and
# every updater starts from the offset it read at entry, so two running at once
# both parse the same new bytes and both append them — the requests are counted
# twice and no later pass can tell, because the file records totals, not ids.
# It is not hypothetical: the dashboard refreshes on a timer, `tusage` with no
# arguments updates too, and a session being actively typed into is exactly the
# one generating new bytes for them to collide over. Measured on a fixture: 13
# real requests indexed as 21.
#
# mkdir is the atomic primitive that exists everywhere (macOS has no flock).
# Losing the race is not an error: the winner is reading the same bytes this
# process would have, so it just returns and lets the next tick pick up.
LOCK="$STATE/.update.lock"
LOCK_STALE_MIN=${TU_LOCK_STALE_MIN:-5}

# A LOCK IS STALE WHEN ITS UPDATER IS GONE, NOT WHEN IT IS OLD. The updater
# writes its pid into the lock, and while that pid is a running tusage the lock
# is held however long the update takes: a catch-up after weeks with no update
# reads for minutes, and a lock taken over from a live updater counts every byte
# both of them read twice. A pid that is gone, or that now belongs to some other
# program, leaves the lock to be taken over at once. A lock with no pid in it —
# an older version's, or one caught between its mkdir and the write — falls back
# to its age.
lock_stale() {
  local pid
  pid=$(cat "$LOCK/pid" 2>/dev/null)
  case "$pid" in
    ''|*[!0-9]*) [ -n "$(find "$LOCK" -maxdepth 0 -mmin "+$LOCK_STALE_MIN" 2>/dev/null)" ] ;;
    *) kill -0 "$pid" 2>/dev/null || return 0
       case "$(ps -p "$pid" -o command= 2>/dev/null)" in *tusage*) return 1 ;; esac
       return 0 ;;
  esac
}

# AN INTERRUPTED UPDATER TAKES ITS LOCK WITH IT. Ctrl-C in a report that was
# catching up used to leave the lock behind, and every tusage for the next five
# minutes then reported from the old index without a word. The RETURN trap does
# not run on a signal, so these do the same cleaning and exit with the signal's
# status; update() sets them once it holds the lock and drops them on return.
update_abort() {  # <exit status>
  rm -rf "${tmp:-}" "$LOCK" "$STAMP.new" 2>/dev/null
  [ "${show:-0}" = 1 ] && printf '\r\033[K' >&2
  exit "$1"
}

# NOTHING WRITTEN SINCE THE LAST COMPLETED UPDATE, NOTHING TO DO. The dashboard
# calls --update after Claude events and once a minute when idle, and an update
# that finds nothing used to cost ~130 programs. One find answers it: is any
# transcript, or any directory under the projects tree, not older than the
# stamp? A directory counts because a rename, a delete or a copy that kept its
# mtime (mv, cp -p) touches the directory and nothing else `-newer` can see, and
# the full pass below is what learns about a path the index has never seen.
# The stamp is an ordinary touch, to the nanosecond APFS keeps: find compares
# those, not whole seconds as bash 3.2 does, so a write in the same second as the
# touch but after it is newer than it and counts. (A filesystem with one-second
# mtimes would tie and miss such a write; this machine has none.)
#
# THE GUARD SITS BEFORE THE LOCK and only reads. It is safe against a running
# updater: that one writes its stamp to a side file and moves it into place only
# when it is done, so until then this guard compares against the old stamp and
# sees every change the running updater may yet miss.
update_has_work() {
  [ -n "$(find "$PROJECTS" \( -name '*.jsonl' -o -type d \) -newer "$STAMP" \
            -print -quit 2>/dev/null)" ]
}

update() {
  local rebuild=${1:-0} loud=${2:-0} f sz off end seen tmp newoff key state dups n=0

  if [ "$rebuild" != 1 ] && [ -e "$STAMP" ] && [ -s "$OFFSETS" ]; then
    update_has_work || return 0
  fi

  mkdir -p "$STATE" 2>/dev/null || return 1
  # A background refresh that loses the race just returns — the winner is
  # reading the same bytes. An explicit --rebuild is a command, not a tick, so
  # it waits and says so rather than pretending it did the work.
  local tries=1; [ "$rebuild" = 1 ] && tries=20
  while [ "$tries" -gt 0 ]; do
    mkdir "$LOCK" 2>/dev/null && break
    # An updater killed mid-run would otherwise wedge the index for good.
    if lock_stale; then
      rm -rf "$LOCK" 2>/dev/null
      mkdir "$LOCK" 2>/dev/null && break
    fi
    tries=$((tries - 1))
    [ "$tries" -gt 0 ] && sleep 1
  done
  if [ "$tries" -le 0 ]; then
    [ "$rebuild" = 1 ] &&
      echo "tusage: another update is running; index left alone" >&2
    return 0
  fi

  printf '%s\n' "$$" >"$LOCK/pid" 2>/dev/null
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/tusage.XXXXXX") || { rm -rf "$LOCK"; return 1; }
  trap 'rm -rf "$tmp" "$LOCK"; trap - INT TERM HUP' RETURN
  trap 'update_abort 130' INT; trap 'update_abort 143' TERM; trap 'update_abort 129' HUP

  [ "$rebuild" = 1 ] && rm -f "$OFFSETS" "$FACTS" "$META" "$STAMP"

  # The stamp is taken BEFORE anything is read and only moved into place when the
  # update completes: a transcript written during the scan is newer than it and
  # counts next time, and an update that dies leaves the old stamp, so the next
  # one covers the same ground again.
  touch "$STAMP.new" || return 1

  # Candidates: everything on a rebuild or a first run, otherwise only what has
  # been touched since the last update (plus anything the index never saw).
  if [ -e "$STAMP" ] && [ -s "$OFFSETS" ]; then
    find "$PROJECTS" -name '*.jsonl' -newer "$STAMP" 2>/dev/null >"$tmp/cand"
    # A path the index has never seen can only have arrived through a directory
    # entry (create, move, copy), which moves that directory's mtime. When none
    # moved, only files that grew are read and the whole-tree listing is skipped.
    if [ -n "$(find "$PROJECTS" -type d -newer "$STAMP" -print -quit 2>/dev/null)" ]; then
      LC_ALL=C awk -F"$TAB" 'NR==FNR { known[$1]=1; next } !($0 in known)' "$OFFSETS" \
        <(find "$PROJECTS" -name '*.jsonl' 2>/dev/null) >>"$tmp/cand" 2>/dev/null
    fi
    sort -u "$tmp/cand" -o "$tmp/cand"
  else
    find "$PROJECTS" -name '*.jsonl' 2>/dev/null >"$tmp/cand"
  fi
  [ -s "$tmp/cand" ] || { mv -f "$STAMP.new" "$STAMP"; return 0; }

  # The offsets table, keyed. Rows written before the key column existed are
  # migrated here, not rewritten in place: the key is a pure function of the
  # path, so deriving it once on the way in costs nothing and the old three-field
  # rows keep working until the table is next written out.
  : >"$tmp/offk"
  [ -s "$OFFSETS" ] && LC_ALL=C awk -F"$TAB" -v OFS="$TAB" -v pref="$PROJECTS/" "$AWK_KEY"'
      { print $1, $2, $3, ($4 == "" ? tkey($1) : $4) }' "$OFFSETS" >"$tmp/offk"

  # Key every candidate, and add any already-indexed copy of the same key that is
  # still on disk under its old path — mid-move, or a plain copy, both halves are
  # there and only one of them may be counted. One stat and one awk for each list,
  # never a program per path: a catch-up after weeks without an update has
  # thousands of them.
  : >"$tmp/keyed"; : >"$tmp/skipped"
  stat_all "$tmp/cand" "$tmp/cstat"
  LC_ALL=C awk -F"$TAB" -v OFS="$TAB" -v pref="$PROJECTS/" "$AWK_KEY"'
    { print tkey($3), $1, $3, "new", $2 }' "$tmp/cstat" >"$tmp/keyed"
  if [ -s "$tmp/offk" ] && [ -s "$tmp/keyed" ]; then
    LC_ALL=C awk -F"$TAB" 'NR==FNR { ck[$1] = 1; cp[$3] = 1; next }
                  ($4 in ck) && !($1 in cp) { print $4 "\t" $1 }' \
        "$tmp/keyed" "$tmp/offk" >"$tmp/oldk"
    cut -f2 "$tmp/oldk" >"$tmp/oldp"
    stat_all "$tmp/oldp" "$tmp/ostat"
    LC_ALL=C awk -F"$TAB" -v OFS="$TAB" 'FILENAME == ARGV[1] { mt[$3] = $1; sz[$3] = $2; next }
        ($2 in mt) { print $1, mt[$2], $2, "old", sz[$2] }' "$tmp/ostat" "$tmp/oldk" >>"$tmp/keyed"
  fi
  # Newest mtime wins the key; the losers are not parsed at all. A loser that is
  # already indexed keeps its row, so the copy on disk is simply invisible.
  #
  # BY KEY, NOT BY PATH: a known key under a new path is the same transcript
  # moved, so its offset and carried ids come along and only the tail is read.
  # They are joined on here in one pass, the ids last: they can be empty, and
  # read collapses an empty field between two tabs into the next one.
  sort -t"$TAB" -k1,1 -k2,2nr "$tmp/keyed" 2>/dev/null |
    LC_ALL=C awk -F"$TAB" -v skip="$tmp/skipped" '
      { if (seen[$1]++) { print > skip; next } print }' |
    LC_ALL=C awk -F"$TAB" -v OFS="$TAB" '
      FILENAME == ARGV[1] { if (!($4 in off)) { off[$4] = $2 + 0; ids[$4] = $3 }; next }
      { print $1, $2, $3, $4, $5, ($1 in off ? off[$1] : 0), ids[$1] }' "$tmp/offk" - >"$tmp/plan"
  dups=$(grep -c . "$tmp/skipped" 2>/dev/null); dups=${dups:-0}

  : >"$tmp/newfacts"; : >"$tmp/newmeta"; : >"$tmp/newoff"

  # A CATCH-UP SAYS HOW FAR IT GOT. Weeks of transcripts take minutes to read,
  # and a report that sat through them in silence looked hung and was killed.
  # Only on a terminal: the dashboard and every script read a pipe, and a
  # handful of transcripts is read before anybody would wonder.
  local total=0 i=0 show=0
  total=$(grep -c "${TAB}new${TAB}" "$tmp/plan" 2>/dev/null); total=${total:-0}
  [ -t 2 ] && [ "$total" -ge "${TU_PROGRESS_MIN:-100}" ] && show=1

  while IFS="$TAB" read -r key _ f state sz off seen; do
    [ "$state" = new ] || continue
    [ -e "$f" ] || continue
    i=$((i + 1))
    [ "$show" = 1 ] && [ $((i % 20)) -eq 1 ] &&
      printf '\rtusage: reading transcripts %d/%d' "$i" "$total" >&2
    # Shorter than the offset it inherited: not that file after all, so read it
    # whole. Covers a rewritten transcript and a name reused by a shorter one.
    [ "$sz" -lt "$off" ] && { off=0; seen=""; }
    end=$(complete_bytes "$f" "$sz"); end=${end:-0}
    if [ "$end" -le "$off" ]; then
      printf '%s\t%s\t%s\t%s\n' "$f" "$off" "$seen" "$key" >>"$tmp/newoff"
      continue
    fi
    path_facets "$f"
    # Cut at the complete bytes even from the start: the file may have grown
    # since its size was taken, and bytes past the offset written down would be
    # read again next time.
    if [ "$off" -eq 0 ]; then
      head -c "$end" -- "$f" 2>/dev/null
    else
      tail -c "+$((off + 1))" -- "$f" 2>/dev/null | head -c "$((end - off))"
    fi | jq -rc "$EXTRACT" 2>/dev/null |
      fold_rows "$PF_SLUG" "$seen" "$PF_ORIGIN" "$tmp/newfacts" "$tmp/newmeta" >"$tmp/out"
    newoff=""; IFS= read -r newoff <"$tmp/out"
    printf '%s\t%s\t%s\t%s\n' "$f" "$end" "$newoff" "$key" >>"$tmp/newoff"
    n=$((n + 1))
  done <"$tmp/plan"
  [ "$show" = 1 ] && printf '\r\033[K' >&2

  # merge offsets: untouched files keep their row, and a key that moved keeps
  # exactly one row — the new path's. The old path's row goes, or the next
  # update would offer the offset of a file that is no longer there.
  if [ -s "$tmp/offk" ]; then
    LC_ALL=C awk -F"$TAB" -v OFS="$TAB" 'NR==FNR { up[$1] = 1; uk[$4] = 1; next }
                                !($1 in up) && !($4 in uk)' \
        "$tmp/newoff" "$tmp/offk" >>"$tmp/newoff.merged" 2>/dev/null
  fi
  cat "$tmp/newoff" >>"$tmp/newoff.merged" 2>/dev/null
  sort -u "$tmp/newoff.merged" 2>/dev/null |
    LC_ALL=C awk -F"$TAB" '!p[$1]++ && !k[$4]++' >"$tmp/off.final"
  mv -f "$tmp/off.final" "$OFFSETS" 2>/dev/null
  [ "$dups" -gt 0 ] && [ "$loud" = 1 ] &&
    echo "tusage: $dups duplicate transcript copies skipped" >&2

  [ -s "$tmp/newfacts" ] && cat "$tmp/newfacts" >>"$FACTS"
  if [ -s "$tmp/newmeta" ]; then
    cat "$META" "$tmp/newmeta" 2>/dev/null |
      LC_ALL=C awk -F"$TAB" -v OFS="$TAB" '
        { if (!($1 in f) || $3 < f[$1]) f[$1] = $3
          if (!($1 in l) || $4 > l[$1]) l[$1] = $4
          p[$1] = $2; if ($5 != "" && $5 != "-") m[$1] = $5 }
        END { for (s in f) print s, p[s], f[s], l[s], (s in m ? m[s] : "-") }' \
      >"$tmp/meta.final" 2>/dev/null
    mv -f "$tmp/meta.final" "$META" 2>/dev/null
  fi

  # The account map is refreshed on the updater's tick, never on a render: the
  # jq passes over the histories are exactly the kind of parsing the index
  # exists to keep off the two-second path.
  account_map --locked >/dev/null 2>&1

  # keep facts bounded
  if [ -s "$FACTS" ]; then
    LC_ALL=C awk -F"$TAB" -v cut="$(( $(date +%s) - KEEP_DAYS * 86400 ))" '$1 + 0 >= cut' \
      "$FACTS" >"$tmp/facts.trim" 2>/dev/null && mv -f "$tmp/facts.trim" "$FACTS"
  fi
  mv -f "$STAMP.new" "$STAMP"
  return 0
}

# ---------------------------------------------------------------------------
# reporting
# ---------------------------------------------------------------------------
# facts columns: 1 bucket 2 slug 3 sid 4 agentid 5 agenttype 6 kind 7 model
#                8 reqs 9 in 10 cw5 11 cw1h 12 cr 13 out 14 maxctx 15 lastctx
# (15 is absent from rows an older version wrote; see fold_rows)

# Local 00:00 of the 1st of the current month. BSD date wants the format spelt
# out, GNU date parses the bare date; try each in that order.
month_start() {
  local first; first=$(date +%Y-%m-01)
  date -j -f '%Y-%m-%d %H:%M:%S' "$first 00:00:00" +%s 2>/dev/null ||
    date -d "$first" +%s 2>/dev/null
}

# A calendar day as an epoch: its local midnight, or the given time of day. BSD
# date wants the format spelt out and GNU date parses the text, so each is
# tried in that order; the round trip through the date rejects a day that does
# not exist, which both would otherwise roll into the next month (2026-02-30).
day_epoch() {
  local d=$1 t=${2:-00:00:00} e back
  case $d in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
    *) return 1 ;;
  esac
  e=$(date -j -f '%Y-%m-%d %H:%M:%S' "$d $t" +%s 2>/dev/null) ||
    e=$(date -d "$d $t" +%s 2>/dev/null) || return 1
  back=$(date -r "$e" +%Y-%m-%d 2>/dev/null) ||
    back=$(date -d "@$e" +%Y-%m-%d 2>/dev/null) || return 1
  [ "$back" = "$d" ] || return 1
  printf '%s' "$e"
}

# The first instant of a window, as an epoch. `month` is spelt out because the
# suffix space is taken: *m already means minutes, and silently re-reading "1m"
# as a month would change what every existing caller asks for. A duration
# reaches back from now, a date starts at its local midnight, and anything else
# fails: the old reading evaluated an unknown word as shell arithmetic, so
# `--since yesterday` quietly meant "now".
since_cut() {
  local v=$1 n=$1 unit=1
  case $v in
    month)             month_start; return ;;
    ????-??-??)        day_epoch "$v"; return ;;
    *[hdm])
      n=${v%?}
      case ${v: -1} in h) unit=3600 ;; d) unit=86400 ;; m) unit=60 ;; esac ;;
  esac
  case $n in ''|*[!0-9]*) return 1 ;; esac
  printf '%s' "$(( ${NOW:-$(date +%s)} - 10#$n * unit ))"
}

# The last instant of a window. An all-digit value is an epoch, which is what
# the dashboard sends; a date is the end of that day.
until_cut() {
  case $1 in
    '')                return 1 ;;
    *[!0-9]*)          day_epoch "$1" 23:59:59 ;;
    *)                 printf '%s' "$1" ;;
  esac
}

# slug -> the real directory. Decoding the slug itself is impossible (a dash
# stands for both "/" and "-"), so the first cwd written into any transcript of
# that project is used instead, and cached.
SLUGMAP="$STATE/projects.tsv"
slug_map() {
  local d slug f cwd
  if [ -e "$SLUGMAP" ] && [ -z "${TU_REFRESH_SLUGS:-}" ]; then
    # refresh only when a project directory appeared since the map was written
    [ "$(find "$PROJECTS" -maxdepth 1 -type d -newer "$SLUGMAP" 2>/dev/null | wc -l)" -eq 0 ] &&
      { cat "$SLUGMAP"; return 0; }
  fi
  : >"$SLUGMAP.tmp"
  for d in "$PROJECTS"/*/; do
    [ -d "$d" ] || continue
    slug=$(basename "$d")
    f=$(ls -1t "$d"*.jsonl 2>/dev/null | head -1)
    cwd=""
    [ -n "$f" ] && cwd=$(head -200 -- "$f" 2>/dev/null | jq -rc 'select(.cwd)|.cwd' 2>/dev/null | head -1)
    [ -z "$cwd" ] && cwd="$slug"
    printf '%s\t%s\n' "$slug" "$cwd" >>"$SLUGMAP.tmp"
  done
  mv -f "$SLUGMAP.tmp" "$SLUGMAP" 2>/dev/null
  cat "$SLUGMAP"
}

# sid -> which login paid for it.
#
# THE ACCOUNT IS A JOIN, NOT A COLUMN. Every config dir shares one transcript
# pool (~/.claude-d/projects is a symlink into ~/.claude/projects), so no facts
# row can tell which login was billed, and facts.tsv is append-only — a 15th
# field would be blank for every row already written and could never be
# back-filled without a --rebuild that only recovers what the transcripts still
# hold. A side table can be thrown away and rebuilt from scratch at any time.
#
# What does know the answer is each config dir's own history.jsonl: it lists the
# sessions started under that login. Headless `-p` runs write no history line,
# so a second pass classifies whatever is left by the directory it was launched
# in — the same rules tagents already uses to pick a profile.
ACCOUNTS="$STATE/accounts.tsv"

# THE BILL IS NOT THE LIST PRICE. An Enterprise seat is metered at whatever the
# contract says — on this account a flat 0.90 of list, two days running — and
# the meter in `/usage` is the only figure that is actually billed. --meter now
# fetches that reading itself and calls this for every account it reads, so the
# factor follows the meter without anybody typing it; by hand it is still one
# command, and the only way to price an account whose meter cannot be reached:
# `--calibrate work 732.71`
# takes that reading, divides it by the month-to-date this index computes for the
# same instant, and keeps the factor per account. From then on --daily reports
# dollars the meter would agree with; --sessions and --burn stay at list, since
# they are read next to the CLI's own list-price ledger. TU_NO_FACTOR=1 turns the
# scaling off for one call — the calibration itself needs the unscaled number.
FACTOR="$STATE/factor.tsv"  # account<TAB>factor<TAB>read at<TAB>amount<TAB>prices

# A FACTOR IS ONLY VALID FOR THE TABLE IT WAS DERIVED AGAINST. It is meter
# divided by what this index computed at that instant, so correcting a rate
# invalidates every stored factor at once — and silently, in the worst
# direction: the old haircut lands on top of the new prices and the month
# reads far under the meter. (Observed 2026-09-18: the fable/sonnet rates were
# corrected two minutes after a meter fetch, and the work account showed $790
# against a $973 reading until it was recalibrated.) So each row carries a
# fingerprint of the price table, and a row whose fingerprint no longer matches
# is ignored rather than trusted: list price is a little high, a stale factor is
# a lot low, and the next meter reading re-derives it anyway.
prices_fp() { printf '%s' "$PRICES" | tr -s ' \n' ' ' | cksum | tr -d ' '; }

factor_arg() {  # -> "acct=factor;..." for awk, empty when off or absent
  [ -z "${TU_NO_FACTOR:-}" ] || return 0
  [ -s "$FACTOR" ] || return 0
  LC_ALL=C awk -F"$TAB" -v fp="$(prices_fp)" '$2 + 0 > 0 && $5 == fp { printf "%s=%s;", $1, $2 }' "$FACTOR"
}

# Rows the fingerprint check is ignoring, so a caller can say why the dollars
# moved instead of leaving it to be discovered on the status bar.
factor_stale() {  # -> account names, space separated
  [ -s "$FACTOR" ] || return 0
  LC_ALL=C awk -F"$TAB" -v fp="$(prices_fp)" '$2 + 0 > 0 && $5 != fp { printf "%s ", $1 }' "$FACTOR"
}

calibrate() {  # <account> <amount> [at]
  local acct=${1:-} amt=${2:-} at=${3:-} epoch mtd f tmp
  [ -n "$acct" ] && [ -n "$amt" ] || { echo "tusage: --calibrate <account> <amount> [--at when]" >&2; return 2; }
  case "$amt" in ''|*[!0-9.]*) echo "tusage: amount must be a number: $amt" >&2; return 2 ;; esac
  if [ -z "$at" ]; then epoch=$(date +%s)
  else
    case "$at" in
      *[!0-9]*) epoch=$(date -j -f '%Y-%m-%d %H:%M' "$at" +%s 2>/dev/null ||
                        date -d "$at" +%s 2>/dev/null) ;;
      *)        epoch=$at ;;
    esac
  fi
  [ -n "${epoch:-}" ] || { echo "tusage: cannot read the time: $at" >&2; return 2; }
  mtd=$(TU_NO_FACTOR=1 daily "$(since_cut month)" "$epoch" |
          LC_ALL=C awk -F"$TAB" -v a="$acct" '$2 == a { s += $3 } END { printf "%.4f", s + 0 }')
  if ! LC_ALL=C awk -v m="$mtd" 'BEGIN { exit !(m + 0 > 0) }'; then
    echo "tusage: nothing indexed for $acct this month up to that instant — nothing to calibrate" >&2
    return 1
  fi
  f=$(LC_ALL=C awk -v a="$amt" -v m="$mtd" 'BEGIN { printf "%.4f", a / m }')
  if ! LC_ALL=C awk -v f="$f" 'BEGIN { exit !(f >= 0.3 && f <= 2.0) }'; then
    echo "tusage: a factor of $f (meter $amt vs indexed $mtd) is not a price, refusing" >&2
    return 1
  fi
  mkdir -p "$STATE" 2>/dev/null || return 1
  tmp="$FACTOR.tmp.$$"
  { [ -s "$FACTOR" ] && LC_ALL=C awk -F"$TAB" -v a="$acct" '$1 != a' "$FACTOR"
    printf '%s\t%s\t%s\t%s\t%s\n' "$acct" "$f" "$epoch" "$amt" "$(prices_fp)"; } >"$tmp" 2>/dev/null &&
    mv -f "$tmp" "$FACTOR"
  printf 'tusage: %s priced at x%s of list (meter $%s vs indexed $%s at %s)\n' \
    "$acct" "$f" "$amt" "$mtd" "$(date -r "$epoch" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "$epoch")"
  return 0
}

# TU_ACCOUNTS is "name=dir;name=dir"; an empty dir means $HOME/.claude, the
# default config dir. Unset, the accounts are discovered: the default one plus
# every ~/.claude-* directory that keeps a history. Dirs are deduped by their
# real path because ~/.claude-personal is a symlink to ~/.claude-d, and reading
# both would double-count every personal session.
account_dirs() {
  local spec=${TU_ACCOUNTS:-} d n ent
  if [ -z "$spec" ]; then
    spec="default="
    for d in "$HOME"/.claude-*/; do
      [ -f "${d}history.jsonl" ] || continue
      n=$(basename "${d%/}"); n=${n#.claude-}
      spec="$spec;$n=${d%/}"
    done
  fi
  # The trailing newline is not decoration: `read` drops a final line that has
  # none, which silently loses the last account in the list.
  printf '%s\n' "$spec" | tr ';' '\n' | while IFS= read -r ent; do
    [ -n "$ent" ] || continue
    n=${ent%%=*}; d=${ent#*=}
    [ -n "$d" ] || d="$HOME/.claude"
    d=$(cd "$d" 2>/dev/null && pwd -P) || continue
    printf '%s\t%s\n' "$n" "$d"
  done | LC_ALL=C awk -F"$TAB" '!seen[$2]++'
}

# ---------------------------------------------------------------------------
#  The meter — what the account itself says it has spent
# ---------------------------------------------------------------------------
#
# A TYPED-IN READING IS STALE THE DAY AFTER IT IS TAKEN. The calibration factor
# above drifted from 0.98 to 0.73 in two days and the dashboard read $1108
# against a meter of $830; against Claude Code's own per-session ledger the
# estimate is wrong in both directions, so no single ratio can be trusted for
# long. The figure the account is actually billed is one authenticated GET
# away: `/api/oauth/usage` answers with the month-to-date spend and the limit
# behind it, for whichever login owns the OAuth token in the keychain. So the
# month becomes the meter, the index keeps only the shape of the days, and
# calibrate() is re-run from each reading so --daily agrees with it too.
#
# HOW OFTEN. The dashboard's refresher calls --update every few seconds, so the
# TTL in the row IS the rate limit: TU_METER_TTL (900s) normally, 300s once the
# account is past 90% of its limit, 5 minutes after a failure and a day after an
# account that has no meter at all — a plan seat answers without a spend object,
# and asking it again this hour will not change that.
#
# THE TOKEN NEVER LEAVES THE PROCESS. It is read out of the keychain into a
# shell variable, handed to curl as one header, and dropped. It is never
# printed, never logged, and nothing derived from it is written to meter.tsv.
METER="$STATE/meter.tsv"   # account<TAB>used<TAB>limit<TAB>fetched at<TAB>status<TAB>next try

meter_item() {  # <account> -> the keychain item holding its credentials, or 1
  local acct=${1:-} item dir home
  [ -n "$acct" ] || return 1
  # An explicit naming wins: a second login keeps its credentials under an item
  # only whoever set it up can know the name of.
  item=$(printf '%s' "${TU_METER_ITEMS:-}" | tr ';' '\n' |
           LC_ALL=C awk -F= -v a="$acct" '$1 == a { sub(/^[^=]*=/, ""); print; exit }')
  if [ -n "$item" ]; then printf '%s' "$item"; return 0; fi
  dir=$(account_dirs | LC_ALL=C awk -F"$TAB" -v a="$acct" '$1 == a { print $2; exit }')
  [ -n "$dir" ] || return 1
  home=$(cd "$HOME/.claude" 2>/dev/null && pwd -P) || return 1
  # Claude Code writes ONE keychain item, and it belongs to the default config
  # dir. Every other login has credentials somewhere this cannot guess.
  [ "$dir" = "$home" ] || return 1
  printf 'Claude Code-credentials'
}

meter_token() {  # <account> -> its OAuth access token, or 1
  local item tok
  item=$(meter_item "${1:-}") || return 1
  tok=$(security find-generic-password -s "$item" -w 2>/dev/null |
          jq -r '.claudeAiOauth.accessToken // empty' 2>/dev/null)
  [ -n "$tok" ] || return 1
  printf '%s' "$tok"
}

meter_field() {  # <account> <field number>
  [ -s "$METER" ] || return 1
  LC_ALL=C awk -F"$TAB" -v a="${1:-}" -v n="${2:-1}" '$1 == a { print $n; exit }' "$METER"
}

meter_put() {  # <account> <used> <limit> <fetched at> <status> <next try>
  local tmp
  mkdir -p "$STATE" 2>/dev/null || return 1
  tmp="$METER.tmp.$$"
  { [ -s "$METER" ] && LC_ALL=C awk -F"$TAB" -v a="$1" '$1 != a' "$METER"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" "$6"; } >"$tmp" 2>/dev/null &&
    mv -f "$tmp" "$METER"
}

meter_fetch() {  # <account> — one GET, one row, never more than one of either
  local acct=${1:-} tok body code now ttl pct um ue lm le used lim pu pl pt ps
  [ -n "$acct" ] || return 1
  now=$(date +%s)
  # A failed reading must not erase a good one: yesterday's figure with a
  # visible error beside it is worth more than a blank the dashboard would
  # silently fall back from.
  pu=$(meter_field "$acct" 2); pl=$(meter_field "$acct" 3)
  pt=$(meter_field "$acct" 4); ps=$(meter_field "$acct" 5)
  [ "${ps:-}" = ok ] || { pu=""; pl=""; pt=""; }

  tok=$(meter_token "$acct") || {
    meter_put "$acct" "$pu" "$pl" "$pt" error "$((now + 300))"
    return 1
  }
  body="$STATE/.meter.$$.json"
  code=$(curl -sS --max-time 8 -o "$body" -w '%{http_code}' \
           -H "Authorization: Bearer $tok" \
           -H "anthropic-beta: oauth-2025-04-20" \
           https://api.anthropic.com/api/oauth/usage 2>/dev/null)
  tok=""
  if [ "${code:-}" != 200 ]; then
    rm -f "$body" 2>/dev/null
    meter_put "$acct" "$pu" "$pl" "$pt" error "$((now + 300))"
    return 1
  fi
  um=$(jq -r '.spend.used.amount_minor // empty' "$body" 2>/dev/null)
  ue=$(jq -r '.spend.used.exponent // 2' "$body" 2>/dev/null)
  lm=$(jq -r '.spend.limit.amount_minor // empty' "$body" 2>/dev/null)
  le=$(jq -r '.spend.limit.exponent // 2' "$body" 2>/dev/null)
  pct=$(jq -r '.spend.percent // 0' "$body" 2>/dev/null)
  rm -f "$body" 2>/dev/null

  # A plan seat answers the same endpoint with no spend object at all. That is
  # an answer, not a failure, and it will still be the answer tomorrow.
  case "${um:-}" in ''|*[!0-9]*)
    meter_put "$acct" "" "" "$now" nometer "$((now + 86400))"
    return 0 ;;
  esac
  case "${ue:-}" in ''|*[!0-9]*) ue=2 ;; esac
  used=$(LC_ALL=C awk -v m="$um" -v e="$ue" 'BEGIN { printf "%.2f", m / (10 ^ e) }')
  lim=""
  case "${le:-}" in ''|*[!0-9]*) le=2 ;; esac
  case "${lm:-}" in ''|*[!0-9]*) ;; *) lim=$(LC_ALL=C awk -v m="$lm" -v e="$le" 'BEGIN { printf "%.2f", m / (10 ^ e) }') ;; esac

  ttl=${TU_METER_TTL:-900}
  case "$ttl" in ''|*[!0-9]*) ttl=900 ;; esac
  case "${pct:-}" in ''|*[!0-9]*) pct=0 ;; esac
  # Near the wall the figure is the one being watched, so it is refreshed at
  # three times the rate. A shorter TTL asked for on purpose still wins.
  if [ "$pct" -ge 90 ] && [ "$ttl" -gt 300 ]; then ttl=300; fi
  meter_put "$acct" "$used" "$lim" "$now" ok "$((now + ttl))" || return 1

  # The meter prices the month; the factor makes --daily and the sparkline agree
  # with it, which is what calibrate() has always done — it is just no longer a
  # human typing the reading. A refusal is a note on stderr, not a failure: the
  # row is good even when the ratio it implies is not a price.
  calibrate "$acct" "$used" >/dev/null
  return 0
}

meter_refresh() {  # [--force] [account…]
  local force=0 acct list now nt st at
  [ -z "${TU_NO_METER:-}" ] || return 0
  case "${1:-}" in --force) force=1; shift ;; esac
  now=$(date +%s)
  if [ $# -eq 0 ]; then list=$(account_dirs | cut -f1 | tr '\n' ' '); else list=$*; fi
  for acct in $list; do
    [ -n "$acct" ] || continue
    if ! meter_item "$acct" >/dev/null 2>&1; then
      st=$(meter_field "$acct" 5)
      [ "${st:-}" = nometer ] ||
        meter_put "$acct" "$(meter_field "$acct" 2)" "$(meter_field "$acct" 3)" \
                  "$(meter_field "$acct" 4)" nometer "$((now + 86400))"
      continue
    fi
    if [ "$force" != 1 ]; then
      nt=$(meter_field "$acct" 6)
      case "${nt:-}" in ''|*[!0-9]*) nt=0 ;; esac
      # AN EXPLICIT TTL APPLIES TO THE READING ALREADY TAKEN, not only to the
      # next one: somebody who asks for a faster meter means now, not in the
      # quarter of an hour the last row was written with.
      case "${TU_METER_TTL:-}" in
        ''|*[!0-9]*) ;;
        *) if [ "$(meter_field "$acct" 5)" = ok ]; then
             at=$(meter_field "$acct" 4)
             case "${at:-}" in ''|*[!0-9]*) ;; *) nt=$((at + TU_METER_TTL)) ;; esac
           fi ;;
      esac
      [ "$now" -lt "$nt" ] && continue
    fi
    meter_fetch "$acct"
  done
  return 0
}

meter_show() {  # the rows, for a person
  local acct used lim at st nt when
  [ -s "$METER" ] ||
    { echo "tusage: no meter reading yet — tusage --meter --refresh" >&2; return 1; }
  printf '%-12s %10s %10s  %-16s %s\n' account used limit fetched status
  # A TAB IS IFS WHITESPACE EVEN WHEN IFS IS JUST A TAB, so `read` folds the
  # empty used/limit of a nometer row into one separator and hands the status to
  # the wrong variable. Fill the holes before reading them.
  LC_ALL=C awk -F"$TAB" -v OFS="$TAB" '{ for (i = 1; i <= 6; i++) if ($i == "") $i = "-"; print }' "$METER" |
  while IFS="$TAB" read -r acct used lim at st nt; do
    [ -n "$acct" ] || continue
    when="-"
    case "${at:-}" in [0-9]*) when=$(date -r "$at" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$at") ;; esac
    printf '%-12s %10s %10s  %-16s %s\n' "$acct" "$used" "$lim" "$when" "$st"
    case "$st" in
      nometer) printf '# %s: this login reports no spend meter (a plan seat, or credentials this cannot read) — the estimate stands alone\n' "$acct" ;;
      error)   printf '# %s: the last fetch failed; the figures above are the reading before it\n' "$acct" ;;
    esac
  done
}

# Writes $ACCOUNTS (sid<TAB>account) and prints it. Called with --locked from
# inside update(), which already holds the lock: taking it again would deadlock
# against ourselves, and the jq passes are the expensive part anyway, so they
# happen before the lock in either case and only the rename is protected.
account_map() {
  local locked=0 fresh=1 n d tmp rules spec
  [ "${1:-}" = "--locked" ] && locked=1
  mkdir -p "$STATE" 2>/dev/null || return 1

  # THE MAP IS ONLY AS GOOD AS THE SPEC IT WAS BUILT FROM. Rename an account or
  # change a rule and every sid keeps the names of the old spec until a history
  # file happens to move — which is how a status bar came to say $0 for an
  # account that had just been named under it. The spec is kept beside the map
  # and a different spec is a stale map, whatever the timestamps say.
  spec="${TU_ACCOUNTS:-}|${TU_ACCOUNT_RULES:-}"
  [ -s "$ACCOUNTS" ] || fresh=0
  [ -n "${TU_REFRESH_ACCOUNTS:-}" ] && fresh=0
  [ "$(cat "$ACCOUNTS.spec" 2>/dev/null)" = "$spec" ] || fresh=0
  if [ "$fresh" = 1 ]; then
    [ -e "$META" ] && [ "$META" -nt "$ACCOUNTS" ] && fresh=0
    while IFS="$TAB" read -r n d; do
      [ -f "$d/history.jsonl" ] && [ "$d/history.jsonl" -nt "$ACCOUNTS" ] && fresh=0
    done <<EOF
$(account_dirs)
EOF
  fi
  [ "$fresh" = 1 ] && { cat "$ACCOUNTS"; return 0; }

  tmp="$ACCOUNTS.tmp.$$"
  : >"$tmp.in"
  while IFS="$TAB" read -r n d; do
    [ -f "$d/history.jsonl" ] || continue
    jq -r --arg a "$n" 'select(.sessionId)|["H",.sessionId,(.timestamp//0),$a]|@tsv' \
      "$d/history.jsonl" 2>/dev/null >>"$tmp.in"
  done <<EOF
$(account_dirs)
EOF
  slug_map | sed 's/^/P\t/' >>"$tmp.in" 2>/dev/null
  [ -s "$META" ] && LC_ALL=C awk -F"$TAB" -v OFS="$TAB" '{ print "S", $1, $2 }' "$META" >>"$tmp.in"

  rules=${TU_ACCOUNT_RULES:-}
  LC_ALL=C awk -F"$TAB" -v OFS="$TAB" -v rules="$rules" -v home="$HOME" '
    BEGIN {
      n = split(rules, rr, ";")
      for (i = 1; i <= n; i++) {
        if (rr[i] ~ /^[ \t]*$/) continue
        if (!match(rr[i], /=[^=]*$/)) continue
        k = substr(rr[i], 1, RSTART - 1); v = substr(rr[i], RSTART + 1)
        if (substr(k, 1, 2) == "~/") k = home substr(k, 2)
        sub(/\/+$/, "", k)
        if (k == "" || v == "") continue
        NRULE++; RD[NRULE] = k; RN[NRULE] = v
      }
    }
    # Longest prefix wins, and only on a path-component boundary: ~/git/personalx
    # is not inside ~/git/personal, however much it looks like it.
    function ruleacct(dir,   i, k, best, bn) {
      best = ""; bn = "?"
      for (i = 1; i <= NRULE; i++) {
        k = RD[i]
        if (dir != k && !(index(dir, k) == 1 && substr(dir, length(k) + 1, 1) == "/")) continue
        if (length(k) > length(best)) { best = k; bn = RN[i] }
      }
      return bn
    }
    # One sid can appear in two histories (a session resumed under the other
    # login). The newest line wins, so the join stays single-valued instead of
    # emitting the session twice and double-counting its dollars.
    $1 == "H" { if (!($2 in HT) || $3 + 0 > HT[$2]) { HT[$2] = $3 + 0; HA[$2] = $4 } ; next }
    $1 == "P" { PD[$2] = $3; next }
    $1 == "S" { SL[$2] = $3; next }
    END {
      for (s in HA) print s, HA[s]
      for (s in SL) {
        if (s in HA) continue
        d = (SL[s] in PD) ? PD[SL[s]] : ""
        print s, (d == "" ? "?" : ruleacct(d))
      }
    }' "$tmp.in" | sort -u >"$tmp.out" 2>/dev/null

  # A reader must never see a half-written map, so the file appears whole or not
  # at all. Losing the lock is not an error: the old map is still valid, just a
  # session or two behind, and the next tick rewrites it.
  printf '%s\n' "$spec" >"$tmp.spec" 2>/dev/null
  if [ "$locked" = 1 ]; then
    mv -f "$tmp.out" "$ACCOUNTS" 2>/dev/null && mv -f "$tmp.spec" "$ACCOUNTS.spec" 2>/dev/null
  elif mkdir "$LOCK" 2>/dev/null; then
    mv -f "$tmp.out" "$ACCOUNTS" 2>/dev/null && mv -f "$tmp.spec" "$ACCOUNTS.spec" 2>/dev/null
    rm -rf "$LOCK" 2>/dev/null
  fi
  rm -f "$tmp.in" "$tmp.out" "$tmp.spec" 2>/dev/null
  cat "$ACCOUNTS" 2>/dev/null
  return 0
}

# sid -> the directory the session was launched in. The hook's cwd follows the
# Bash tool around, so it is useless as an identity; the first cwd recorded in
# the transcript is the launch directory and never changes.
origin_dir() {
  local sid=$1 slug=${2:-} cache="$STATE/origin.tsv" d f
  if [ -e "$cache" ]; then
    d=$(LC_ALL=C awk -F"$TAB" -v k="$sid" '$1==k { print $2; exit }' "$cache")
    [ -n "$d" ] && { printf '%s' "$d"; return 0; }
  fi
  f=$(ls -1 "$PROJECTS/$slug/$sid.jsonl" 2>/dev/null | head -1)
  [ -z "$f" ] && f=$(find "$PROJECTS" -name "$sid.jsonl" 2>/dev/null | head -1)
  if [ -n "$f" ]; then
    d=$(head -200 -- "$f" 2>/dev/null | jq -rc 'select(.cwd) | .cwd' 2>/dev/null | head -1)
  fi
  [ -z "$d" ] && d="?"
  printf '%s\t%s\n' "$sid" "$d" >>"$cache" 2>/dev/null
  printf '%s' "$d"
}

AWK_FMT='
  function human(x) {
    if (x >= 1e9) return sprintf("%.1fG", x/1e9)
    if (x >= 1e6) return sprintf("%.1fM", x/1e6)
    if (x >= 1e3) return sprintf("%.0fk", x/1e3)
    return sprintf("%d", x)
  }
  function cost(i, c5, c1, cr, o) { return i + 1.25*c5 + 2.0*c1 + 0.1*cr + 5*o }
  # A share of nothing is 0%, not a division by zero: a week with no usage, or a
  # window of nothing but zero-token placeholder requests, is a total of 0.
  function pct(v, of) { return (of > 0) ? 100*v/of : 0 }
  # claude-opus-5 and claude-haiku-4-5-20251001 read as opus-5 and haiku-4-5.
  function short_model(m) {
    sub(/^claude-/, "", m)
    if (m ~ /-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]$/) m = substr(m, 1, length(m) - 9)
    return m
  }
  function bar(v, mx, w,   n, s, i) {
    n = (mx > 0) ? int(v / mx * w + 0.5) : 0
    s = ""; for (i = 0; i < w; i++) s = s (i < n ? "█" : "·")
    return s
  }
'

# Local-day arithmetic, shared by every report that has a day axis. The offset
# comes from a -v tz="$(date +%z)" the caller passes, and is decoded on first
# use rather than in a BEGIN block so a caller only has to supply the variable.
AWK_DAY='
  function tzinit(  zh, zm) {
    zh = substr(tz,2,2) + 0; zm = substr(tz,4,2) + 0
    OFFS = zh*3600 + zm*60; if (substr(tz,1,1) == "-") OFFS = -OFFS
    TZI = 1
  }
  function daykey(t)  { if (!TZI) tzinit(); return int((t + OFFS)/86400) }
  function hourkey(t) { if (!TZI) tzinit(); return int((t + OFFS)/3600) }
  function daystr(d,   z, y, m, dd, e, doe, yoe, doy, mp) {
    # civil-from-days, so no shelling out to date per row
    z = d + 719468
    e = (z >= 0 ? z : z - 146096) / 146097; e = int(e)
    doe = z - e*146097
    yoe = int((doe - int(doe/1460) + int(doe/36524) - int(doe/146096)) / 365)
    y = yoe + e*400
    doy = doe - (365*yoe + int(yoe/4) - int(yoe/100))
    mp = int((5*doy + 2)/153)
    dd = doy - int((153*mp+2)/5) + 1
    m = mp + (mp < 10 ? 3 : -9)
    y += (m <= 2)
    return sprintf("%04d-%02d-%02d", y, m, dd)
  }
'

# Text measured in characters: macOS awk counts bytes, so a "⑂", a "…" or a
# Cyrillic letter would eat two or three of the columns a pad meant to fill.
AWK_TEXT='
  function uclen(s,   i, n, c) { n = 0
    for (i = 1; i <= length(s); i++) { c = substr(s, i, 1)
      if (c >= "\200" && c <= "\277") continue; n++ }
    return n }
  function upad(s, w,   n) { n = uclen(s); return (w > n) ? s sprintf("%" (w-n) "s", "") : s }
  function utrunc(s, n,   i, c, k, r) { k = 0; r = ""
    for (i = 1; i <= length(s); i++) { c = substr(s, i, 1)
      if (c < "\200" || c > "\277") { if (k == n) break; k++ }
      r = r c }
    return r }
'

# A directory as the tables show it: the home is a tilde. Needs -v home.
AWK_TILDE='
  function tilde(p) { return (index(p, home) == 1) ? "~" substr(p, length(home) + 1) : p }
'

# --account and --project narrow every report by the same means: the rows that
# stay are written to a file of their own, FACTS points at it, and the report
# reads it as it reads the index. No report has a filter of its own, so none
# can disagree about what a filter means, and a call with no filter reads the
# index as it always did.
FILTERED=""
have_index() { [ -s "$FACTS" ] || [ -n "$FILTERED" ]; }  # an empty answer is not a missing index
filter_facts() {
  [ -n "$ACCTS$PROJS$SESSION" ] || return 0
  [ -s "$FACTS" ] || return 0
  local withacct=0
  [ -n "$ACCTS" ] && withacct=1
  FILTERED=$(mktemp "${TMPDIR:-/tmp}/tusage.facts.XXXXXX") || return 1
  trap 'rm -f "$FILTERED"' EXIT
  { slug_map | sed 's/^/P\t/'
    [ "$withacct" = 1 ] && { account_map | sed 's/^/A\t/'; }
    cat "$FACTS"; } |
  LC_ALL=C awk -F"$TAB" -v accts="$ACCTS" -v projs="$PROJS" -v sess="$SESSION" -v home="$HOME" "$AWK_TILDE"'
    BEGIN {
      na = split(accts, a, ","); for (i = 1; i <= na; i++) WANTA[a[i]] = 1
      np = split(tolower(projs), WP, "\037")
    }
    $1 == "P" { PD[$2] = tilde($3); next }
    $1 == "A" { ACC[$2] = ($3 == "" ? "?" : $3); next }
    {
      if (sess != "" && $3 != sess) next
      if (na) { x = ($3 in ACC) ? ACC[$3] : "?"; if (!(x in WANTA)) next }
      if (np) {
        p = tolower(($2 in PD) ? PD[$2] : $2); ok = 0
        for (i = 1; i <= np; i++) if (index(p, WP[i])) { ok = 1; break }
        if (!ok) next
      }
      print
    }' >"$FILTERED"
  FACTS=$FILTERED
}

# ---------------------------------------------------------------------------
# tagents, when it is there
# ---------------------------------------------------------------------------
# A session is called what it was named in tagents, and an account what the
# tagents config calls it. Both live in lib/tagents/, beside this file in a
# checkout and nowhere else. Reading the index needs none of it, so without that
# directory every name is an id, every account is a discovered one, and no
# report fails for it. The modules are sourced in a subshell with its standard
# error discarded: a module that prints, or a config the parser refuses, is not
# tusage's output.

# lib/tagents/ beside the real file, found by following the symlinks by hand
# (macOS ships no readlink -f). The loop is the one in ./tagents, word for word,
# and tests/tusage.sh compares the two. Sets TA_LIB; fails when the modules are
# not there.
tu_lib() {
  local ta_real ta_link
  ta_real=${BASH_SOURCE[0]}
  while [ -L "$ta_real" ]; do
    ta_link=$(readlink "$ta_real")
    case $ta_link in
      /*) ta_real=$ta_link ;;
      *)  case $ta_real in
            */*) ta_real=${ta_real%/*}/$ta_link ;;
            *)   ta_real=$ta_link ;;
          esac ;;
    esac
  done
  case $ta_real in
    */*) TA_LIB=${ta_real%/*}/lib/tagents ;;
    *)   TA_LIB=lib/tagents ;;
  esac
  [ -r "$TA_LIB/core.sh" ] && [ -r "$TA_LIB/names.sh" ] && [ -r "$TA_LIB/state.sh" ]
}

# Run a function of this file with the names modules loaded. Its answer is on
# standard output; nothing is printed and the status is 1 when the modules are
# not found.
with_names() {  # <function> [args…]
  tu_lib || return 1
  # shellcheck disable=SC1091  # the dashboard modules sit beside the script, found at run time
  ( set +u
    . "$TA_LIB/core.sh"; . "$TA_LIB/names.sh"; . "$TA_LIB/state.sh"
    "$@" ) 2>/dev/null
}

name_files() { printf '%s\n%s\n' "$LABELS" "$TITLES"; }

# stdin: sid<TAB>project slug, one session per line. Prints S<TAB>sid<TAB>name
# for each that has a name, by the rule of the dashboard: the name typed for it
# (the first line for its id in labels.tsv, where an empty name is no name),
# else the title in the cache, else the title of its transcript. That one is
# read at most once: title_of is the only writer of title.tsv, atomically, and
# it re-reads a transcript that has no title only after the transcript grew.
names_of_sessions() {
  local sid slug haslabel hit hsz nm tr
  set --
  [ -e "$LABELS" ] && set -- "$LABELS"
  [ -e "$TITLES" ] && set -- "$@" "$TITLES"
  while IFS="$US" read -r sid slug haslabel hit hsz; do
    nm=""
    [ "$haslabel" = 1 ] && nm=$(label_of "$sid")
    if [ -z "$nm" ]; then
      case $hit in
        ''|-) tr="$PROJECTS/$slug/$sid.jsonl"
              [ -r "$tr" ] && nm=$(title_of "$sid" "$tr" "$hit" "$hsz") ;;
        *)    nm=$hit ;;
      esac
    fi
    [ -n "$nm" ] && printf 'S\t%s\t%s\n' "$sid" "$nm"
  done < <(LC_ALL=C awk -F"$TAB" -v OFS="$US" -v lab="$LABELS" -v tit="$TITLES" '
      FILENAME == lab { HL[$1] = 1; next }
      FILENAME == tit { TH[$1] = $2; TZ[$1] = $3; next }
      { print $1, $2, ($1 in HL) + 0, TH[$1], TZ[$1] }' "$@" -)
}

# S lines for the session rows of a node file: only the rows the table prints,
# so a session cut by --top is never looked at.
session_names() {  # <nodes file>
  LC_ALL=C awk -F"$TAB" '$1 == "N" && $3 == "session" { print $4 "\t" $17 }' "$1" |
    with_names names_of_sessions
}

# The accounts of the tagents config, for a terminal. The dashboard hands tusage
# TU_ACCOUNTS and TU_ACCOUNT_RULES through usage_env; a hand-typed tusage asks
# the same function, so it names the accounts the dashboard does. A TU_ACCOUNTS
# set by hand wins and the config is not read; so does a TU_ACCOUNT_RULES. With
# no config, or a config with no profiles, nothing is set and the discovery in
# account_dirs stays.
ensure_accounts() {
  local got accts rules
  [ -z "${TU_ACCOUNTS:-}" ] || return 0
  tu_lib || return 0
  # shellcheck disable=SC1091  # the dashboard modules sit beside the script, found at run time
  got=$( ( set +u; unset TU_ACCOUNT_RULES
           . "$TA_LIB/core.sh"; . "$TA_LIB/config.sh"; . "$TA_LIB/accounts.sh"; . "$TA_LIB/usage.sh"
           usage_env
           printf '%s\n%s\n' "${TU_ACCOUNTS:-}" "${TU_ACCOUNT_RULES:-}" ) 2>/dev/null )
  { IFS= read -r accts; IFS= read -r rules; } <<<"$got"
  [ -n "$accts" ] || return 0
  export TU_ACCOUNTS=$accts
  [ -z "${TU_ACCOUNT_RULES:-}" ] && [ -n "$rules" ] && export TU_ACCOUNT_RULES=$rules
  return 0
}

# A session's name as the lookup has it: the typed one (the first line for its
# id in labels.tsv; an empty one is none), else a title in the cache. Spliced
# into the programs below, which pass the two files as -v lab and -v tit.
# shellcheck disable=SC2016  # awk source, $1 and $2 are awk fields
AWK_NAME='
  FILENAME == lab { if (!($1 in HL)) { HL[$1] = 1; LN[$1] = $2 }; next }
  FILENAME == tit { TN[$1] = $2; next }
  function name(s,   t) {
    t = (s in HL) ? LN[s] : ""
    if (t == "") t = ((s in TN) && TN[s] != "-") ? TN[s] : ""
    return t
  }
'

# The sessions a text names by one rule, "sid<TAB>name" each, in index order.
# The rules, in turn: id (the whole id, else the start of one) and name (the
# whole name, else part of it, any case). The first step that matches anything
# is the answer. --account keeps those accounts' sessions. No transcript is read.
session_hits() {  # <text> id|name [labels file] [titles file]
  local x=$1 rule=$2 lab=${3:-} tit=${4:-}
  [ -s "$META" ] || return 0
  set -- "$META"
  [ -n "$lab" ] && [ -e "$lab" ] && set -- "$@" "$lab"
  [ -n "$tit" ] && [ -e "$tit" ] && set -- "$@" "$tit"
  { [ -z "$ACCTS" ] || account_map; } |
  X=$x LC_ALL=C awk -F"$TAB" -v rule="$rule" -v accts="$ACCTS" -v meta="$META" -v lab="$lab" -v tit="$tit" \
      "$AWK_NAME"'
    BEGIN {
      x = ENVIRON["X"]; lx = tolower(x)
      na = split(accts, a, ","); for (i = 1; i <= na; i++) WANT[a[i]] = 1
    }
    FILENAME == meta { if (!($1 in SEEN)) { SEEN[$1] = 1; SID[++n] = $1 }; next }
    { ACC[$1] = ($2 == "" ? "?" : $2) }
    END {
      for (i = 1; i <= n; i++) {
        s = SID[i]
        if (na && !(((s in ACC) ? ACC[s] : "?") in WANT)) continue
        C[++m] = s
      }
      for (step = 1; step <= 2; step++) {
        k = 0
        for (i = 1; i <= m; i++) {
          s = C[i]; nm = name(s)
          if (rule == "id") hit = (step == 1) ? (s == x) : (index(s, x) == 1)
          else hit = (nm != "") && ((step == 1) ? (tolower(nm) == lx) : (index(tolower(nm), lx) > 0))
          if (hit) OUT[++k] = s
        }
        if (k) { for (j = 1; j <= k; j++) print OUT[j]; exit }
      }
    }' "$@" -
}

# Several sessions answer one text: say which, with what tells them apart.
session_list() {  # <text> <hit ids, one per line> [labels file] [titles file]
  local x=$1 hits=$2 lab=${3:-} tit=${4:-}
  ensure_accounts
  printf 'tusage: %s sessions match %s; give more of the id or the name, or narrow with --account:\n' \
    "$(printf '%s\n' "$hits" | wc -l | tr -d ' ')" "$x" >&2
  set --
  [ -n "$lab" ] && [ -e "$lab" ] && set -- "$@" "$lab"
  [ -n "$tit" ] && [ -e "$tit" ] && set -- "$@" "$tit"
  { printf '%s\n' "$hits" | LC_ALL=C sort | sed 's/^/H\t/'; account_map | sed 's/^/A\t/'; } |
  LC_ALL=C awk -F"$TAB" -v facts="$FACTS" -v lab="$lab" -v tit="$tit" -v tz="$(date +%z)" "$AWK_DAY$AWK_NAME"'
    FILENAME == facts { if ($3 in HIT) { d = daykey($1 + 0); if (!(($3, d) in SEEN)) { SEEN[$3, d] = 1; DAYS[$3]++ } }; next }
    $1 == "H" { HIT[$2] = 1; ORDER[++n] = $2; next }
    $1 == "A" { ACC[$2] = ($3 == "" ? "?" : $3); next }
    END {
      for (i = 1; i <= n; i++) { s = ORDER[i]; nm = name(s)
        printf "  %s  %s  %s  %d day%s\n", s, (nm == "" ? "-" : nm), ((s in ACC) ? ACC[s] : "?"), DAYS[s], (DAYS[s] == 1 ? "" : "s") }
    }' - "$@" "$FACTS" >&2
}

# labels.tsv and title.tsv where the names modules keep them, as NAME_LAB and
# NAME_TIT; both empty when the modules are not there.
NAME_LAB=""; NAME_TIT=""; NAME_PATHS=""
name_paths() {
  local paths
  [ -z "$NAME_PATHS" ] || return 0
  NAME_PATHS=1
  paths=$(with_names name_files) || return 0
  { IFS= read -r NAME_LAB; IFS= read -r NAME_TIT; } <<<"$paths"
}

# --session's text becomes the full id, or the run ends: 1 when nothing has that
# id or name, 3 when several do. An id-shaped text that names nothing is not an
# error: the detail of a session with no usage is empty, and the dashboard asks
# for ids that have aged out of the index.
resolve_session() {
  local hits
  [ -s "$FACTS" ] || return 0
  hits=$(session_hits "$SESSION" id)
  [ -n "$hits" ] || { name_paths; hits=$(session_hits "$SESSION" name "$NAME_LAB" "$NAME_TIT"); }
  case $hits in
    '')      case $SESSION in
               *[!0-9a-fA-F-]*) echo "tusage: no session called $SESSION" >&2; exit 1 ;;
             esac ;;
    *$'\n'*) name_paths; session_list "$SESSION" "$hits" "$NAME_LAB" "$NAME_TIT"; exit 3 ;;
    *)       SESSION=$hits ;;
  esac
}

# The heading of a table of one session, as the H record by_render prints it:
# the name the session has in the other tables (none when it has none), its full
# id, its account and its project directory.
session_head() {  # <full session id>
  local sid=$1 slug acct dir nm
  { slug_map | sed 's/^/P\t/'; account_map | sed 's/^/A\t/'; sed 's/^/S\t/' "$META"; } |
  LC_ALL=C awk -F"$TAB" -v k="$sid" -v home="$HOME" "$AWK_TILDE"'
    $1 == "P" { PD[$2] = tilde($3); next }
    $1 == "A" { if ($2 == k) acct = $3; next }
    $1 == "S" && $2 == k && slug == "" { slug = $3; next }
    END { printf "%s\t%s\t%s\n", slug, (acct == "" ? "?" : acct), (slug in PD ? PD[slug] : slug) }' |
  { IFS="$TAB" read -r slug acct dir
    nm=$(printf '%s\t%s\n' "$sid" "$slug" | with_names names_of_sessions | LC_ALL=C cut -f3)
    printf 'H\t%s\t%s\t%s\t%s\n' "$nm" "$sid" "$acct" "$dir"; }
}

# ---------------------------------------------------------------------------
# --by: one aggregation pass, one render pass
# ---------------------------------------------------------------------------
# by_aggregate reads facts.tsv once and prints a stream of nodes; by_render
# turns the stream into a table. --tsv stops after the first pass, so a script
# and the tests read exact numbers instead of a padded table.
#
# The stream, one tab-separated line each:
#   W  first day  last day  sessions that belong to no account
#   K  an account that is a row of the table, in the order of its rows
#   N  depth  dimension  key  reqs  in  out  cwrite  cread  usd  unpriced  first  last  days  models  more models  slug
#   R  as N, for the "… n more" row: its key is the count of rows it sums
#   T  as N, for the total: depth 0
# Depth is 1 for the first dimension. Rows come depth first, children after
# their parent, each parent's children in the order the table prints them.
by_aggregate() {  # <dimensions, comma list> <cut> <upto> table|tsv
  local dims=$1 cut=$2 upto=$3 mode=$4 withacct=0
  case ",$dims," in *,account,*) withacct=1 ;; esac
  { slug_map | sed 's/^/P\t/'
    [ "$withacct" = 1 ] && { account_map | sed 's/^/A\t/'; }
    cat "$FACTS"; } |
  LC_ALL=C awk -F"$TAB" -v dims="$dims" -v cut="$cut" -v upto="$upto" -v mode="$mode" \
      -v topn="$TOPN" -v sortcost="$([ "$SORT" = cost ] && echo 1 || echo 0)" \
      -v now="$(date +%s)" -v tz="$(date +%z)" -v home="$HOME" \
      -v prices="$(prices_arg)" "$AWK_FMT$AWK_DAY$AWK_PRICE$AWK_TILDE"'
    BEGIN {
      nd = split(dims, DIM, ",")
      for (i = 1; i <= nd; i++) {
        if (DIM[i] == "workflow") WFONLY = 1
        TIMED[i] = (DIM[i] == "day" || DIM[i] == "week" || DIM[i] == "month" || DIM[i] == "hour")
        NOCUT[i] = TIMED[i] || DIM[i] == "model"
      }
      ROOT = "0"
    }
    # The key of the current row for one dimension. A week is its Monday: day
    # number 0 was a Thursday, so (day + 3) mod 7 counts days since Monday.
    function rowkey(name, dk,   a) {
      if (name == "account") { a = ($3 in ACC) ? ACC[$3] : "?"; if (a == "?") UNPL[$3] = 1; return a }
      if (name == "project") return ($2 in PD) ? PD[$2] : $2
      if (name == "session") return $3
      if (name == "day")     return daystr(dk)
      if (name == "week")    return daystr(dk - (dk + 3) % 7)
      if (name == "month")   return substr(daystr(dk), 1, 7)
      if (name == "hour")    return daystr(dk) sprintf(" %02d:00", hourkey($1) % 24)
      if (name == "model")   return $7
      if (name == "workflow") return $6
      if ($4 == "-")         return "· main session"
      if ($6 ~ /^wf:/)       return "⑂ workflow agent"
      return "⑂ " $5 ($6 == "bg" ? " (bg)" : "")
    }
    $1 == "P" { PD[$2] = tilde($3); next }
    $1 == "A" { ACC[$2] = ($3 == "" ? "?" : $3); next }
    $1 + 0 < cut { next }
    upto > 0 && $1 + 0 > upto { next }
    WFONLY && $6 !~ /^wf:/ { next }
    {
      d = usd($7, $1 + 0, $9, $10, $11, $12, $13)
      u = 0
      # A request on an unrated model is a hole in the bill only when it spent
      # something: the zero-token "<synthetic>" placeholder is not one.
      if (d < 0) { d = 0; if ($9 + $10 + $11 + $12 + $13 > 0) u = $8 + 0 }
      dk = daykey($1)
      if (!NC || dk < MINDK) MINDK = dk
      id = ""
      for (i = 1; i <= nd; i++) id = id rowkey(DIM[i], dk) SUBSEP
      id = id short_model($7) SUBSEP dk
      if (!(id in CQ)) NC++
      CQ[id] += $8; CI[id] += $9; CO[id] += $13; CW[id] += $10 + $11; CR[id] += $12
      CU[id] += d; CP[id] += u
      if (!($3 in SLUGOF)) SLUGOF[$3] = $2
    }
    # Children of a node go out in the order a table prints them. Time runs
    # oldest first unless --sort cost; everything else is dearest first, and a
    # tie is broken by the key, so two runs print the same rows. Dollars are
    # compared at the millionth, where the order of the additions has stopped
    # mattering.
    function before(x, y,   ux, uy) {
      if (!SORTTIME) {
        ux = int(NU[x] * 1000000 + 0.5); uy = int(NU[y] * 1000000 + 0.5)
        if (ux != uy) return ux > uy
      }
      return ("" KEYOF[x]) < ("" KEYOF[y])
    }
    function msort(a, lo, hi, tmp,   mid, i, j, k) {
      if (lo >= hi) return
      mid = int((lo + hi) / 2)
      msort(a, lo, mid, tmp); msort(a, mid + 1, hi, tmp)
      i = lo; j = mid + 1; k = lo
      while (i <= mid && j <= hi) { if (before(a[j], a[i])) tmp[k++] = a[j++]; else tmp[k++] = a[i++] }
      while (i <= mid) tmp[k++] = a[i++]
      while (j <= hi)  tmp[k++] = a[j++]
      for (k = lo; k <= hi; k++) a[k] = tmp[k]
    }
    # The two dearest models of a node by dollars, in MORE how many are left out.
    function modelstr(nid,   n, i, j, t) {
      n = MN[nid]
      for (i = 1; i <= n; i++) { MS[i] = MK[nid, i]; MV[i] = int(MU[nid, MS[i]] * 1000000 + 0.5) }
      for (i = 2; i <= n; i++)
        for (j = i; j > 1 && (MV[j] > MV[j-1] || (MV[j] == MV[j-1] && ("" MS[j]) < ("" MS[j-1]))); j--) {
          t = MS[j]; MS[j] = MS[j-1]; MS[j-1] = t
          t = MV[j]; MV[j] = MV[j-1]; MV[j-1] = t
        }
      MORE = (n > 2) ? n - 2 : 0
      return (n >= 2) ? MS[1] "," MS[2] : MS[1]
    }
    function emit(type, nid, lvl, name, key,   m) {
      m = modelstr(nid)
      printf "%s\t%d\t%s\t%s\t%.0f\t%.0f\t%.0f\t%.0f\t%.0f\t%.6f\t%.0f\t%s\t%s\t%d\t%s\t%d\t%s\n",
        type, lvl, name, key, NQ[nid], NI[nid], NO[nid], NW[nid], NX[nid], NU[nid], NP[nid],
        daystr(FD[nid]), daystr(LD[nid]), ND[nid], m, MORE, (name == "session" ? SLUGOF[key] : "")
    }
    function emit_tsv(nid,   i) {
      for (i = 1; i <= nd; i++) printf "%s\t", PK[i]
      printf "%.0f\t%.0f\t%.0f\t%.0f\t%.0f\t%.6f\t%.0f\t%s\t%s\t%d\n",
        NQ[nid], NI[nid], NO[nid], NW[nid], NX[nid], NU[nid], NP[nid], daystr(FD[nid]), daystr(LD[nid]), ND[nid]
    }
    # Adds node "from" to node "into": the rows a --top cut sums into one.
    function fold(into, from,   j, dd, m) {
      NQ[into] += NQ[from]; NI[into] += NI[from]; NO[into] += NO[from]; NW[into] += NW[from]
      NX[into] += NX[from]; NU[into] += NU[from]; NP[into] += NP[from]
      for (j = 1; j <= ND[from]; j++) {
        dd = DL[from, j]
        if (!((into, dd) in DAYAT)) { DAYAT[into, dd] = 1; ND[into]++; DL[into, ND[into]] = dd }
      }
      if (!(into in FD) || FD[from] < FD[into]) FD[into] = FD[from]
      if (!(into in LD) || LD[from] > LD[into]) LD[into] = LD[from]
      for (j = 1; j <= MN[from]; j++) {
        m = MK[from, j]
        if (!((into, m) in MU)) { MN[into]++; MK[into, MN[into]] = m }
        MU[into, m] += MU[from, m]
      }
    }
    function walk(par, lvl,   n, i, c, lim, r) {
      n = NK[par]
      for (i = 1; i <= n; i++) SRT[i] = KID[par, i]
      SORTTIME = (TIMED[lvl] && !sortcost)
      msort(SRT, 1, n, TMP)
      for (i = 1; i <= n; i++) ORD[lvl, i] = SRT[i]
      lim = n
      if (mode == "table" && topn > 0 && !NOCUT[lvl] && n > topn) lim = topn
      for (i = 1; i <= lim; i++) {
        c = ORD[lvl, i]
        PK[lvl] = KEYOF[c]
        if (mode == "tsv") { if (lvl == nd) emit_tsv(c) }
        else {
          if (DIM[lvl] == "account" && KEYOF[c] != "?") print "K\t" KEYOF[c]
          emit("N", c, lvl, DIM[lvl], KEYOF[c])
        }
        if (lvl < nd) walk(c, lvl + 1)
      }
      if (lim < n) {
        r = "R" (++NREST)
        for (i = lim + 1; i <= n; i++) fold(r, ORD[lvl, i])
        emit("R", r, lvl, DIM[lvl], n - lim)
      }
    }
    END {
      if (!NC) { print "no data in this window" > "/dev/stderr"; exit 1 }
      for (c in CQ) {
        split(c, P, SUBSEP)
        mdl = P[nd + 1]; dkc = P[nd + 2] + 0
        nid = ROOT
        for (d = 0; d <= nd; d++) {
          if (d > 0) { par = nid; nid = par SUBSEP P[d] }
          if (!(nid in SEEN)) {
            SEEN[nid] = 1
            if (d > 0) { NK[par]++; KID[par, NK[par]] = nid; KEYOF[nid] = P[d] }
          }
          NQ[nid] += CQ[c]; NI[nid] += CI[c]; NO[nid] += CO[c]; NW[nid] += CW[c]; NX[nid] += CR[c]
          NU[nid] += CU[c]; NP[nid] += CP[c]
          if (!((nid, dkc) in DAYAT)) { DAYAT[nid, dkc] = 1; ND[nid]++; DL[nid, ND[nid]] = dkc }
          if (!(nid in FD) || dkc < FD[nid]) FD[nid] = dkc
          if (!(nid in LD) || dkc > LD[nid]) LD[nid] = dkc
          if (!((nid, mdl) in MU)) { MN[nid]++; MK[nid, MN[nid]] = mdl }
          MU[nid, mdl] += CU[c]
        }
      }
      if (mode == "table") {
        for (s in UNPL) nun++
        printf "W\t%s\t%s\t%d\n", daystr(cut > 0 ? daykey(cut) : MINDK), daystr(upto > 0 ? daykey(upto) : daykey(now)), nun
      }
      walk(ROOT, 1)
      if (mode == "table") emit("T", ROOT, 0, "", "total")
    }'
}

# How wide a table may be: COLUMNS when that is a number, else the terminal's
# width when standard output is one, else 120.
out_width() {
  local w=""
  case ${COLUMNS:-} in ''|*[!0-9]*|0) ;; *) w=$COLUMNS ;; esac
  if [ -z "$w" ] && [ "$OUT_TTY" = 1 ]; then w=$(stty size </dev/tty 2>/dev/null); w=${w#* }; fi
  case $w in ''|*[!0-9]*|0) w=120 ;; esac
  echo "$w"
}

# The table. The nodes arrive on standard input; <title> is the dimensions as
# the first line names them.
by_render() {  # <dimensions, comma list> <title>
  LC_ALL=C awk -F"$TAB" -v dims="$1" -v title="$2" -v factors="$(factor_arg)" \
      -v width="$(out_width)" -v compact="$COMPACT" -v color="$COLOR_ON" \
      "$AWK_FMT$AWK_PRICE$AWK_TEXT"'
    BEGIN {
      B = "\033[1m"; D = "\033[90m"; R = "\033[0m"
      nd = split(dims, DIM, ",")
      for (i = 1; i <= nd; i++) {
        if (DIM[i] == "model") HASMODEL = 1
        if (DIM[i] == "day" || DIM[i] == "week" || DIM[i] == "month" || DIM[i] == "hour") HASTIME = 1
      }
      nf = split(factors, fr, ";")
      for (i = 1; i <= nf; i++) if (fr[i] != "") { split(fr[i], q, "="); FAC[q[1]] = 1 }
      split("reqs input output cwrite cread total usd share days span models", CN, " ")
      split("reqs input output cwrite cread total $ share days span models", CH, " ")
      split("5 6 6 6 6 6 8 6 4 12 16", CW, " ")
    }
    $1 == "W" { FROM = $2; TO = $3; UNPL = $4 + 0; next }
    $1 == "K" { NK++; KACC[NK] = $2; next }
    $1 == "S" { t = $3; gsub(/[\001-\037\177]/, "", t); if (t != "") NAME[$2] = t; next }
    $1 == "H" { HEAD = 1; HNAME = $2; HID = $3; HACC = ($4 == "?") ? "? unplaced" : $4; HDIR = $5; next }
    {
      n++
      TY[n] = $1; DP[n] = $2 + 0; DM[n] = $3; KY[n] = $4
      Q[n] = $5; IN[n] = $6; OU[n] = $7; CWR[n] = $8; CRD[n] = $9; U[n] = $10 + 0; UP[n] = $11 + 0
      FD[n] = $12; LD[n] = $13; ND[n] = $14; MD[n] = $15; MO[n] = $16 + 0
      if ($1 == "T") { TOT = $10 + 0; TDAYS = $14 + 0; TFROM = $12; TTO = $13 }
    }
    function span(f, l,   a, b) { a = substr(f, 6); b = substr(l, 6); return (a == b) ? a : a ".." b }
    function label(i,   d, k, t) {
      d = DM[i]; k = KY[i]
      if (TY[i] == "T") return "total"
      if (TY[i] == "R")      t = "… " k " more"
      else if (d == "account") t = (k == "?") ? "? unplaced" : k
      else if (d == "session") t = (k in NAME) ? NAME[k] "  " substr(k, 1, 8) : substr(k, 1, 8)
      else if (d == "week")  t = "wk " k
      else if (d == "model") t = short_model(k)
      else t = k
      return substr("        ", 1, 2 * (DP[i] - 1)) t
    }
    function cell(c, i) {
      if (c == "reqs")   return sprintf("%d", Q[i])
      if (c == "input")  return human(IN[i])
      if (c == "output") return human(OU[i])
      if (c == "cwrite") return human(CWR[i])
      if (c == "cread")  return human(CRD[i])
      if (c == "total")  return human(IN[i] + OU[i] + CWR[i] + CRD[i])
      if (c == "usd")    return money(U[i]) (UP[i] > 0 ? "*" : "")
      if (c == "share")  return sprintf("%.1f%%", pct(U[i], TOT))
      if (c == "days")   return sprintf("%d", ND[i])
      if (c == "span") return span(FD[i], LD[i])
      return MD[i] (MO[i] > 0 ? " +" MO[i] : "")
    }
    function fit(s, c) { return (c == "span" || c == "models") ? sprintf("%-" W[c] "s", s) : sprintf("%" W[c] "s", s) }
    # A line of the table in a style: colour wraps the padded line, so it never
    # changes a width.
    function out(s, style) { sub(/ +$/, "", s); print (color && style != "") ? style s R : s }
    # The label of row i, cut to lim characters. A named session is cut in its
    # name and keeps its eight id characters; an unnamed one is its id.
    function fitlabel(i, lim,   t, ind, room) {
      t = label(i)
      if (uclen(t) <= lim || TY[i] != "N") return t
      if (DM[i] == "session") {
        if (!(KY[i] in NAME)) return t
        ind = substr("        ", 1, 2 * (DP[i] - 1))
        room = lim - length(ind) - 2 - 8 - 1
        return ind utrunc(NAME[KY[i]], room > 0 ? room : 0) "…  " substr(KY[i], 1, 8)
      }
      return utrunc(t, lim - 1) "…"
    }
    function used(   j, u) { for (j = 1; j <= nc; j++) u += W[COLS[j]] + 2; return u }
    function drop(c,   j, k) {
      for (j = 1; j <= nc; j++) if (COLS[j] == c) { for (k = j; k < nc; k++) COLS[k] = COLS[k + 1]; nc--; return }
    }
    # A line that is longer than the table may be is broken at spaces, the lines
    # after the first indented by two. One that fits is printed as it is.
    function note(s,   m, w, line, wd) {
      if (uclen(s) <= width) { print s; return }
      m = split(s, wd, " "); line = ""
      for (w = 1; w <= m; w++) {
        if (line != "" && uclen(line) + 1 + uclen(wd[w]) > width) { print line; line = "  " wd[w] }
        else line = (line == "") ? wd[w] : line " " wd[w]
      }
      if (line != "") print line
    }
    function and_list(a, m,   i, s) {
      for (i = 1; i <= m; i++) s = s (i == 1 ? "" : (i == m ? " and " : ", ")) a[i]
      return s
    }
    END {
      if (!n) exit
      for (j = 1; j <= 11; j++) { W[CN[j]] = CW[j]; H[CN[j]] = CH[j] }
      nc = 0
      if (compact) { COLS[++nc] = "total"; COLS[++nc] = "usd"; COLS[++nc] = "share" }
      else {
        for (j = 1; j <= 8; j++) COLS[++nc] = CN[j]
        if (!HASTIME)  { COLS[++nc] = "days"; COLS[++nc] = "span" }
        if (!HASMODEL) COLS[++nc] = "models"
      }
      for (i = 1; i <= n; i++) {
        if (UP[i] > 0) FLOOR = 1
        for (j = 1; j <= nc; j++) { t = cell(COLS[j], i); X[i, COLS[j]] = t; if (length(t) > W[COLS[j]]) W[COLS[j]] = length(t) }
      }
      # Columns go in a fixed order until the label has room for 24 characters.
      # The label, total, dollars and share stay, whatever the width.
      nx = split("models span days input cwrite cread output reqs", DROPS, " ")
      for (j = 1; j <= nx && width - used() < 24; j++) drop(DROPS[j])
      lim = width - used(); if (lim < 5) lim = 5
      labw = 5
      for (i = 1; i <= n; i++) { L[i] = fitlabel(i, lim); if (uclen(L[i]) > labw) labw = uclen(L[i]) }
      if (HEAD) {
        gsub(/[\001-\037\177]/, "", HNAME); gsub(/[\001-\037\177]/, "", HDIR)
        t = (HNAME == "") ? HID : HNAME "  " HID; out(t, B)
        print HACC "  ·  " HDIR "  ·  " TDAYS " day" (TDAYS == 1 ? "" : "s") ", " span(TFROM, TTO)
      } else note("usage  " FROM " .. " TO "  " title)
      print ""
      s = upad("", labw)
      for (j = 1; j <= nc; j++) s = s "  " fit(H[COLS[j]], COLS[j])
      out(s, D)
      for (i = 1; i <= n; i++) {
        s = upad(L[i], labw)
        for (j = 1; j <= nc; j++) s = s "  " fit(X[i, COLS[j]], COLS[j])
        out(s, TY[i] == "T" || (TY[i] == "N" && DP[i] < nd) ? B : (TY[i] == "R" ? D : ""))
      }
      nl = 0
      if (FLOOR) NOTE[++nl] = floor_note()
      if (UNPL > 0) NOTE[++nl] = UNPL " session" (UNPL == 1 ? " belongs" : "s belong") " to no account: TU_ACCOUNT_RULES places a session by the directory it started in."
      nfa = 0
      for (i = 1; i <= NK; i++) if (KACC[i] in FAC) FA[++nfa] = KACC[i]
      if (nfa == 1) NOTE[++nl] = "Dollars are at list price. A meter factor is stored for " FA[1] ": tusage --daily scales its dollars by it."
      else if (nfa > 1) NOTE[++nl] = "Dollars are at list price. Meter factors are stored for " and_list(FA, nfa) ": tusage --daily scales their dollars by them."
      if (nl) { print ""; for (i = 1; i <= nl; i++) note(NOTE[i]) }
    }'
}

report_by() {  # <the --by list> <cut> <upto>
  local dims=$1 cut=$2 upto=$3 all=$1 nodes rc
  have_index || { echo "tusage: no data yet — run 'tusage --rebuild'" >&2; return 1; }
  # --breakdown is one more dimension under the deepest one, unless the model
  # is a dimension already.
  case ",$dims," in *,model,*) ;; *) [ "$BREAKDOWN" = 1 ] && all="$dims,model" ;; esac
  if [ "$TSV" = 1 ]; then by_aggregate "$all" "$cut" "$upto" tsv; return; fi
  nodes=$(mktemp "${TMPDIR:-/tmp}/tusage.by.XXXXXX") || return 1
  by_aggregate "$all" "$cut" "$upto" table >"$nodes"; rc=$?
  if [ "$rc" = 0 ]; then
    { [ -z "$SESSION" ] || session_head "$SESSION"
      case ",$all," in *,session,*) session_names "$nodes" ;; esac; cat "$nodes"; } |
      by_render "$all" "by ${all//,/ > }"
    rc=$?
  fi
  rm -f "$nodes"
  return "$rc"
}

# sid, cost, reqs, ctx, last_ts, slug, subagent_cost, live_subagents, cost_5h,
#   model, usd, usd_5h, usd_subagent, unpriced
# ctx is the context of the session's newest main-chain request (agent id "-"),
# the number that says "this session is fat, compact it". It used to be the
# largest context of the last hour, which answered a different question: "how
# big did this chat get". After a /compact that kept showing the size from
# before the compaction for up to an hour, and a subagent's own large context
# could show as the session's. A session that has made no main-chain request in
# the window reports 0. The newest request is the one of the newest bucket,
# and of the later row when two rows share a bucket; a row from an index that
# predates the lastctx column falls back to its maxctx (see fold_rows).
#
# `model` is the session's CURRENT model — the one the newest row was billed at,
# which is what a status line should show. The dollar figures are emphatically
# not derived from it: each row is priced at its own model (see usd), so a
# session that switched tiers mid-conversation, or fanned work out to subagents
# on a cheaper one, still totals correctly. Subagent rows are in the session
# total AND in usd_subagent, which is a subset of it, not an addition.
# `unpriced` counts rows whose model has no published rate; when it is non-zero
# the dollar figures are a floor, not the whole bill.
sessions() {
  [ -s "$FACTS" ] || return 0
  local now; now=${NOW:-$(date +%s)}
  LC_ALL=C awk -F"$TAB" -v OFS="$TAB" -v cut="${1:-0}" -v upto="${2:-0}" \
      -v h1="$(( now - 3600 ))" -v h5="$(( now - 18000 ))" \
      -v prices="$(prices_arg)" "$AWK_PRICE"'
    function cost(i,c5,c1,cr,o) { return i + 1.25*c5 + 2.0*c1 + 0.1*cr + 5*o }
    $1 + 0 >= cut && (upto == 0 || $1 + 0 <= upto) {
      s = $3; c = cost($9,$10,$11,$12,$13)
      d = usd($7, $1 + 0, $9,$10,$11,$12,$13)
      # An unpriced row that spent nothing is not a hole in the bill: Claude Code
      # writes a zero-token "<synthetic>" placeholder that would otherwise make
      # every session claim its total was incomplete.
      if (d < 0) { d = 0; if (c > 0) UNP[s]++ }
      C[s] += c; R[s] += $8; P[s] = $2
      D[s] += d
      if ($1 + 0 >= h5) { C5H[s] += c; D5H[s] += d }
      if ($4 == "-") {
        v = (NF >= 15) ? $15 + 0 : $14 + 0
        if (v > 0 && $1 + 0 >= XB[s]) { XB[s] = $1 + 0; X[s] = v }
      }
      if ($1 + 0 > L[s]) L[s] = $1 + 0
      # The newest row that actually spent something wins the model column, so a
      # mid-session /model shows up at once — but the placeholder never does.
      if (c > 0 && $1 + 0 >= LM[s]) { LM[s] = $1 + 0; MDL[s] = $7 }
      if ($4 != "-") { SUB[s] += c; DSUB[s] += d; NSUB[s SUBSEP $4] = ($1 + 0) }
    }
    END { for (s in C) {
        k = 0
        for (q in NSUB) { split(q, a, SUBSEP); if (a[1] == s && NSUB[q] >= h1) k++ }
        print s, int(C[s]), R[s], int(X[s]), L[s], P[s],
              int(SUB[s]), k, int(C5H[s]),
              MDL[s], sprintf("%.6f", D[s]), sprintf("%.6f", D5H[s]),
              sprintf("%.6f", DSUB[s]), UNP[s] + 0 } }' "$FACTS"
}

# day<TAB>account<TAB>usd<TAB>reqs<TAB>unpriced — one row per local day per
# login, no header, sorted by day then account, for a spend chart or a monthly
# reckoning. Machine-readable on purpose: report_by's table prints cost units
# and a bar, which is the wrong shape for money someone is going to add up.
#
# Sessions the account map cannot place print as "?" rather than falling into a
# default, because a wrong login is worse than a visible hole.
daily() {
  [ -s "$FACTS" ] || return 0
  # --until cuts the far end, so a window can be closed at both ends: the meter
  # calibration in tagents needs the month AS OF the instant the meter was read.
  local cut=${1:-0} upto=${2:-0}
  { account_map | sed 's/^/A\t/'; cat "$FACTS"; } |
  LC_ALL=C awk -F"$TAB" -v OFS="$TAB" -v cut="$cut" -v upto="$upto" -v tz="$(date +%z)" \
      -v prices="$(prices_arg)" -v factors="$(factor_arg)" "$AWK_PRICE$AWK_DAY"'
    BEGIN {
      nf = split(factors, fr, ";")
      for (i = 1; i <= nf; i++) if (fr[i] != "") { split(fr[i], q, "="); FAC[q[1]] = q[2] + 0 }
    }
    $1 == "A" { ACC[$2] = ($3 == "" ? "?" : $3); next }
    $1 + 0 < cut { next }
    upto > 0 && $1 + 0 > upto { next }
    {
      a = ($3 in ACC) ? ACC[$3] : "?"
      k = daystr(daykey($1)) SUBSEP a
      d = usd($7, $1 + 0, $9,$10,$11,$12,$13)
      # The contract rate, when a meter reading taught us one — see calibrate.
      if (d > 0 && (a in FAC)) d *= FAC[a]
      c = $9 + 1.25*$10 + 2.0*$11 + 0.1*$12 + 5*$13
      # Same rule as --sessions: a zero-token row on an unknown model is the
      # "<synthetic>" placeholder, not a hole in the bill.
      if (d < 0) { d = 0; if (c > 0) UNP[k]++ }
      USD[k] += d; RQ[k] += $8; SEEN[k] = 1
    }
    END {
      for (k in SEEN) { split(k, p, SUBSEP)
        printf "%s\t%s\t%.4f\t%d\t%d\n", p[1], p[2], USD[k], RQ[k], UNP[k] + 0 }
    }' |
  sort -t"$TAB" -k1,1 -k2,2
}

burn() {   # what the last 5h cost, for the tmux status bar
  [ -s "$FACTS" ] || return 0
  LC_ALL=C awk -F"$TAB" -v cut="$(( $(date +%s) - 18000 ))" -v prices="$(prices_arg)" "$AWK_PRICE"'
    function human(x) { if (x >= 1e6) return sprintf("%.1fM", x/1e6)
                        if (x >= 1e3) return sprintf("%.0fk", x/1e3); return sprintf("%d", x) }
    $1 + 0 >= cut {
      c = $9 + 1.25*$10 + 2.0*$11 + 0.1*$12 + 5*$13; T += c; S[$3] += c
      d = usd($7, $1 + 0, $9,$10,$11,$12,$13); if (d > 0) TD += d
    }
    END {
      if (T <= 0) exit 0
      # Money is the honest threshold now that a bar can mix a $5 and a $10
      # model: the same token count is two different bills.
      printf "#[fg=#665c54]5h #[fg=%s]%s ", (TD > 200 ? "red" : TD > 100 ? "yellow" : "#928374"), money(TD)
    }' "$FACTS"
}

session_detail() {
  local sid=$1 slug
  [ -s "$FACTS" ] || return 1
  slug=$(LC_ALL=C awk -F"$TAB" -v k="$sid" '$1 == k { print $2; exit }' "$META" 2>/dev/null)
  printf '\033[1m%s\033[0m  %s\n' "$sid" "$(origin_dir "$sid" "$slug")"
  LC_ALL=C awk -F"$TAB" -v k="$sid" -v prices="$(prices_arg)" "$AWK_FMT$AWK_PRICE"'
    $3 ~ "^" k {
      a = ($4 == "-" ? "· main" : ($6 ~ /^wf:/ ? "⑂ " $6 : "⑂ " $5 ($6 == "bg" ? " (bg)" : "")))
      REQ[a] += $8; IN[a] += $9; C5[a] += $10; C1[a] += $11; CR[a] += $12; OUT[a] += $13
      if (!(a in seen)) { seen[a] = 1; ord[++n] = a }
      if ($1 + 0 > last) { last = $1 + 0 }
      c = cost($9,$10,$11,$12,$13)
      d = usd($7, $1 + 0, $9,$10,$11,$12,$13)
      if (d < 0) { d = 0; if (c > 0) { UNP++; MUNP[$7] = 1 } }
      T += c; TD += d; DOL[a] += d
      # Per model, so a mid-session switch is visible as two priced rows rather
      # than one blended number that matches neither rate.
      MC[$7] += c; MD[$7] += d
      if (!($7 in mseen) && c > 0) { mseen[$7] = 1; mord[++mn] = $7 }
    }
    END {
      if (n == 0) { print "  (no usage recorded in the retained window)"; exit }
      printf "\033[90m  %-26s %8s %8s %7s %8s %8s %8s\033[0m\n", "who", "cost", "$", "reqs", "cwrite", "cread", "out"
      for (i = 1; i <= n; i++) { a = ord[i]
        printf "  %-26.26s %8s %8s %7d %8s %8s %8s\n", a, human(cost(IN[a],C5[a],C1[a],CR[a],OUT[a])),
               money(DOL[a]), REQ[a], human(C5[a]+C1[a]), human(CR[a]), human(OUT[a]) }
      printf "\033[90m  %-26s %8s %8s\033[0m\n", "TOTAL", human(T), money(TD)
      if (mn > 1 || UNP) {
        printf "\n\033[90m  %-26s %8s %8s\033[0m\n", "model", "cost", "$"
        for (i = 1; i <= mn; i++) { m = mord[i]
          printf "  %-26.26s %8s %8s%s\n", m, human(MC[m]), money(MD[m]),
                 ((m in MUNP) ? "  \033[33m(no published rate)\033[0m" : "") }
      }
      if (UNP) printf "\033[33m  %d request(s) ran on a model with no published rate — $ is a floor\033[0m\n", UNP
    }' "$FACTS"
}

summary() {
  local now top names; now=$(date +%s)
  have_index || { echo "tusage: no data yet — run 'tusage --rebuild'" >&2; return 1; }
  { slug_map | sed 's/^/P\t/'; account_map | sed 's/^/A\t/'; cat "$FACTS"; } |
  LC_ALL=C awk -F"$TAB" -v now="$now" -v home="$HOME" -v prices="$(prices_arg)" \
      "$AWK_FMT$AWK_PRICE$AWK_TEXT$AWK_TILDE"'
    BEGIN { R = "\033[0m"; DIM = "\033[90m"; B = "\033[1m" }
    $1 == "P" { pdir[$2] = $3; next }
    $1 == "A" { ACC[$2] = ($3 == "" ? "?" : $3); next }
    {
      c = cost($9,$10,$11,$12,$13); age = now - ($1 + 0)
      # A request on an unrated model is a hole in the bill only when it spent
      # something: the zero-token "<synthetic>" placeholder is not one.
      d = usd($7, $1 + 0, $9, $10, $11, $12, $13); u = 0; spent = ($9 + $10 + $11 + $12 + $13 > 0)
      if (d < 0) { d = 0; u = spent }
      if (age <= 18000) { W5 += c; W5R += $8; W5D += d; W5U += u; if ($14 + 0 > W5X) W5X = $14 + 0 }
      if (age <= 86400) { D1 += c; D1R += $8; D1D += d; D1U += u }
      if (age <= 604800) { D7 += c; D7R += $8; D7D += d; D7U += u
        P[$2] += c
        if (spent) { a = ($3 in ACC) ? ACC[$3] : "?"; AD[a] += d; AU[a] += u; if (!(a in AN)) { AN[a] = 1; NACC++ } }
        if ($4 == "-") MAIN += c
        else { SUBC += c
               SA[$6 ~ /^wf:/ ? "workflow agent" : $5 ($6 == "bg" ? " (bg)" : "")] += c
               if ($6 ~ /^wf:/) { WF[$6] += c; WFR[$6] += $8 } }
        CW += $10 + $11; CW5 += $10; CW1 += $11; CR += $12; OU += $13; INP += $9
        if ($14 + 0 > 200000) BIG += $8
        TREQ += $8
      }
    }
    # A dollar cell: right-aligned, with a "*" after it when a request in the
    # window had no rate, so the digits of every line stay under each other.
    function dollars(x, u) { return sprintf("%8s%s", money(x), u > 0 ? "*" : " ") }
    # The account that comes first: the dearer one, the name when they tie.
    function acct_before(x, y,   ux, uy) {
      ux = int(AD[x] * 1000000 + 0.5); uy = int(AD[y] * 1000000 + 0.5)
      if (ux != uy) return ux > uy
      return x < y
    }
    END {
      printf "%s cost = input-token equivalents: in + 1.25*cw5m + 2*cw1h + 0.1*cread + 5*out%s\n\n", DIM, R
      printf "%slast 5 h%s   %s%10s%s  %s  %5d requests   %speak ctx %.0fk%s\n", B, R, B, human(W5), R, dollars(W5D, W5U), W5R, DIM, W5X/1000, R
      printf "%slast 24 h%s  %s%10s%s  %s  %5d requests\n", B, R, B, human(D1), R, dollars(D1D, D1U), D1R
      printf "%slast 7 d%s   %s%10s%s  %s  %5d requests\n", B, R, B, human(D7), R, dollars(D7D, D7U), D7R
      if (W5U + D1U + D7U > 0) printf "%s%s%s\n", DIM, floor_note(), R
      printf "\n"

      if (NACC > 1) {
        printf "%sby account (7 d)%s\n", B, R
        k = 0; for (a in AN) AK[++k] = a
        for (i = 1; i <= k; i++) for (j = i + 1; j <= k; j++)
          if (acct_before(AK[j], AK[i])) { t = AK[i]; AK[i] = AK[j]; AK[j] = t }
        for (i = 1; i <= k; i++) { a = AK[i]
          nm = (a == "?") ? "? unplaced" : a
          if (uclen(nm) > 42) nm = utrunc(nm, 41) "…"
          printf "  %s %9s%s %5.1f%%\n", upad(nm, 42), money(AD[a]), (AU[a] > 0 ? "*" : " "), (D7D > 0 ? 100 * AD[a] / D7D : 0) }
        printf "\n"
      }

      printf "%swhere it goes (7 d)%s\n", B, R
      wcw = 1.25*CW5 + 2.0*CW1; wcr = 0.1*CR; wou = 5*OU; wt = INP + wcw + wcr + wou
      if (wt > 0) {
        printf "  cache WRITE %10s raw -> %9s  %s%s %2.0f%%%s\n", human(CW), human(wcw), DIM, bar(wcw, wt, 22), pct(wcw, wt), R
        printf "  cache READ  %10s raw -> %9s  %s%s %2.0f%%%s\n", human(CR), human(wcr), DIM, bar(wcr, wt, 22), pct(wcr, wt), R
        printf "  output      %10s raw -> %9s  %s%s %2.0f%%%s\n", human(OU), human(wou), DIM, bar(wou, wt, 22), pct(wou, wt), R
      } else printf "  %snothing in the last 7 days%s\n", DIM, R
      if (TREQ) printf "  %s%.0f%% of requests carry more than 200k of context%s\n", DIM, 100*BIG/TREQ, R

      printf "\n%stop projects (7 d)%s\n", B, R
      for (p in P) if (P[p] > pm) pm = P[p]
      k = 0; for (p in P) arr[++k] = P[p] SUBSEP p
      for (i = 1; i <= k; i++) for (j = i+1; j <= k; j++) {
        split(arr[i], x, SUBSEP); split(arr[j], y, SUBSEP)
        if (y[1] + 0 > x[1] + 0) { t = arr[i]; arr[i] = arr[j]; arr[j] = t } }
      for (i = 1; i <= k && i <= 6; i++) { split(arr[i], x, SUBSEP)
        printf "  %-42.42s %9s  %s%s%s\n",
               (x[2] in pdir ? tilde(pdir[x[2]]) : x[2]), human(x[1]), DIM, bar(x[1], pm, 16), R }

      printf "\n%smain sessions vs everything they spawn (7 d)%s\n", B, R
      tot = MAIN + SUBC + 0.001
      printf "  %s %9s  %s%s %2.0f%%%s\n", upad("main sessions", 42), human(MAIN), DIM, bar(MAIN, tot, 16), 100*MAIN/tot, R
      k = 0; for (a in SA) arr2[++k] = SA[a] SUBSEP a
      for (i = 1; i <= k; i++) for (j = i+1; j <= k; j++) {
        split(arr2[i], x, SUBSEP); split(arr2[j], y, SUBSEP)
        if (y[1] + 0 > x[1] + 0) { t = arr2[i]; arr2[i] = arr2[j]; arr2[j] = t } }
      for (i = 1; i <= k && i <= 7; i++) { split(arr2[i], x, SUBSEP)
        printf "  %s %9s  %s%s %2.0f%%%s\n", upad("⑂ " x[2], 42), human(x[1]), DIM, bar(x[1], tot, 16), 100*x[1]/tot, R }

      nwf = 0; for (w in WF) nwf++
      if (nwf) {
        printf "\n%sworkflow runs (7 d) — %d of them%s\n", B, nwf, R
        k = 0; for (w in WF) arr3[++k] = WF[w] SUBSEP w
        for (i = 1; i <= k; i++) for (j = i+1; j <= k; j++) {
          split(arr3[i], x, SUBSEP); split(arr3[j], y, SUBSEP)
          if (y[1] + 0 > x[1] + 0) { t = arr3[i]; arr3[i] = arr3[j]; arr3[j] = t } }
        for (i = 1; i <= k && i <= 5; i++) { split(arr3[i], x, SUBSEP)
          printf "  %-42.42s %9s  %s%d requests%s\n", x[2], human(x[1]), DIM, WFR[x[2]], R }
      }
    }'
  echo
  printf '\033[1mheaviest sessions (7 d)\033[0m\n'
  top=$(sessions "$(since_cut 7d)" | sort -t"$TAB" -k2,2nr | head -8)
  [ -n "$top" ] || return 0
  names=$(printf '%s\n' "$top" | LC_ALL=C awk -F"$TAB" '{ print $1 "\t" $6 }' | with_names names_of_sessions)
  { printf '%s\n' "$names"
    while IFS="$TAB" read -r sid c reqs ctx _ slug subc _; do
      printf 'R\t%s\t%s\t%s\t%s\t%s\t%s\n' "$sid" "$c" "$reqs" "$ctx" "$subc" "$(origin_dir "$sid" "$slug")"
    done <<<"$top"
  } | LC_ALL=C awk -F"$TAB" -v home="$HOME" "$AWK_FMT$AWK_TEXT$AWK_TILDE"'
    $1 == "S" { NM[$2] = $3; next }
    $1 == "R" { n++; ID[n] = $2; CS[n] = $3; RQ[n] = $4; CX[n] = $5; SB[n] = $6; DR[n] = $7
                nm = ($2 in NM) ? NM[$2] : ""
                if (uclen(nm) > 28) nm = utrunc(nm, 27) "…"
                NMS[n] = nm; if (uclen(nm) > w) w = uclen(nm) }
    END {
      for (i = 1; i <= n; i++)
        printf "  %s%s\033[90m%-8.8s\033[0m %9s %6s req  ctx %5.0fk  sub %7s  \033[90m%s\033[0m\n",
               upad(NMS[i], w), (w > 0 ? "  " : ""), ID[i], human(CS[i]), RQ[i], int(CX[i] / 1000), human(SB[i]), tilde(DR[i])
    }'
}

json() {
  have_index || { echo '{"error":"no data"}'; return 1; }
  LC_ALL=C awk -F"$TAB" -v cut="${1:-0}" -v upto="${2:-0}" '
    function cost(i,c5,c1,cr,o) { return i + 1.25*c5 + 2.0*c1 + 0.1*cr + 5*o }
    $1 + 0 >= cut && (upto == 0 || $1 + 0 <= upto) { C[$2 SUBSEP $3 SUBSEP ($4=="-"?"main":$5)] += cost($9,$10,$11,$12,$13)
                    R[$2 SUBSEP $3 SUBSEP ($4=="-"?"main":$5)] += $8 }
    END { printf "["; first = 1
      for (k in C) { split(k, a, SUBSEP)
        printf "%s{\"project\":\"%s\",\"session\":\"%s\",\"who\":\"%s\",\"cost\":%d,\"requests\":%d}",
               (first ? "" : ","), a[1], a[2], a[3], C[k], R[k]; first = 0 }
      print "]" }' "$FACTS"
}

# ---------------------------------------------------------------------------

# One DIM holds the report that runs. The session, the dimensions and the
# filters are held apart from it, so the order of the flags decides nothing:
# `--session X --by day` and `--by day --session X` are the same report.
NOW=""; SINCE=""; UNTIL=""; DIM=""; DO_UPDATE=1; CAL_ACCT=""; CAL_AMT=""; CAL_AT=""
MET_REFRESH=0; MET_FORCE=0
BYLIST=""; SESSION=""; ACCTS=""; PROJS=""; BREAKDOWN=0; TOPN=12; SORT=""
COLOR=auto; COMPACT=0; TSV=0
OUT_TTY=0; [ -t 1 ] && OUT_TTY=1   # asked here: inside $( ) standard output is a pipe
US=$'\037'
DIMENSIONS="account project session day week month hour agent model workflow"

die_usage() { echo "tusage: $*" >&2; exit 2; }
want_value() { [ "$2" -ge 2 ] || die_usage "$1 needs a value"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --by)       want_value "$1" $#; BYLIST=$2; DIM=__by; shift 2 ;;
    --since)    want_value "$1" $#; SINCE=$2; SINCE_SET=1; shift 2 ;;
    --until)    want_value "$1" $#; UNTIL=$2; UNTIL_SET=1; shift 2 ;;
    --account)  want_value "$1" $#; [ -n "$2" ] || die_usage "--account needs a name"
                ACCTS="${ACCTS:+$ACCTS,}$2"; shift 2 ;;
    --project)  want_value "$1" $#; [ -n "$2" ] || die_usage "--project needs some text"
                PROJS="${PROJS:+$PROJS$US}$2"; shift 2 ;;
    --breakdown) BREAKDOWN=1; shift ;;
    --top)      want_value "$1" $#; TOPN=$2; shift 2 ;;
    --sort)     want_value "$1" $#; SORT=$2; shift 2 ;;
    --color)    want_value "$1" $#; COLOR=$2; shift 2 ;;
    --compact)  COMPACT=1; shift ;;
    --tsv)      TSV=1; shift ;;
    --calibrate) DIM=__calibrate; CAL_ACCT=${2:-}; CAL_AMT=${3:-}; shift 3 ;;
    --at)       CAL_AT=${2:-}; shift 2 ;;
    --meter)    DIM=__meter; shift ;;
    --refresh)  MET_REFRESH=1; shift ;;
    --force)    MET_FORCE=1; shift ;;
    --sessions) DIM=__sessions; shift ;;
    --daily)    DIM=__daily; shift ;;
    --session)  want_value "$1" $#; [ -n "$2" ] || die_usage "--session needs an id or a name"
                SESSION=$2; [ -n "$DIM" ] || DIM=__detail; shift 2 ;;
    --burn)     DIM=__burn; shift ;;
    --json)     DIM=__json; shift ;;
    # The meter runs AFTER the index work and outside its lock: it is a network
    # call, and holding a lock across one would wedge every other tick behind it.
    --update)   update 0 1; URC=$?; meter_refresh; exit "$URC" ;;
    --rebuild)  update 1 1; exit $? ;;
    --no-update) DO_UPDATE=0; shift ;;
    # Print to the first non-comment line, never a hardcoded range: the header
    # grows, the range does not, and the help silently loses its tail.
    -h|--help)  LC_ALL=C awk 'NR > 2 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
    *)          die_usage "unknown option $1" ;;
  esac
done

# Every value is checked before the index is touched: a typo prints a plain
# message and exits 2, where the old reading fell through to a plausible table
# of the wrong thing.
DIMS=()
check_by() {
  local d seen=" "
  [ -n "$BYLIST" ] || die_usage "--by needs at least one dimension"
  case ",$BYLIST," in *,,*) die_usage "empty dimension in --by $BYLIST" ;; esac
  IFS=, read -r -a DIMS <<<"$BYLIST"
  for d in "${DIMS[@]}"; do
    case " $DIMENSIONS " in
      *" $d "*) ;;
      *) printf 'tusage: unknown dimension %s\nvalid: %s\n' "$d" "${DIMENSIONS// /, }" >&2; exit 2 ;;
    esac
    case "$seen" in *" $d "*) die_usage "dimension $d given twice" ;; esac
    seen="$seen$d "
  done
  [ "${#DIMS[@]}" -le 3 ] || die_usage "--by takes at most three dimensions, not ${#DIMS[@]}"
}

check_accounts() {
  local a known
  [ -n "$ACCTS" ] || return 0
  known=$(account_dirs | LC_ALL=C cut -f1)
  IFS=, read -r -a want <<<"$ACCTS"
  for a in "${want[@]}"; do
    [ "$a" = "?" ] && continue
    printf '%s\n' "$known" | grep -Fxq -- "$a" && continue
    printf 'tusage: unknown account %s\nknown accounts: %s\n' "$a" \
      "$(printf '%s\n' "$known" | paste -sd, - | sed 's/,/, /g'), ?" >&2
    exit 2
  done
}

[ "$DIM" = __by ] && check_by
case "$TOPN" in ''|*[!0-9]*) die_usage "--top wants a number of rows, not $TOPN" ;; esac
[ -z "$SORT" ] || [ "$SORT" = cost ] || die_usage "--sort accepts only cost, not $SORT"
case "$COLOR" in auto|always|never) ;; *) die_usage "--color accepts auto, always or never, not $COLOR" ;; esac
# Colour: only on a terminal, with NO_COLOR unset or empty and TERM not dumb;
# --color always is an explicit request and wins over NO_COLOR.
COLOR_ON=0
case "$COLOR" in
  always) COLOR_ON=1 ;;
  auto)   [ "$OUT_TTY" = 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ] && COLOR_ON=1 ;;
esac
if [ -n "$ACCTS" ]; then ensure_accounts
else case "$DIM" in ""|__by|__daily|__meter|__calibrate) ensure_accounts ;; esac
fi
check_accounts

# The window. A table by week or month, or of one session, reaches back as far
# as the index does unless --since says otherwise: seven days is one row of a
# week table, and the days of a session are not all in the last week.
wide_window() {
  [ "$DIM" = __detail ] && return 1
  [ -n "$SESSION" ] && return 0
  [ "$DIM" = __by ] || return 1
  case ",$BYLIST," in *,week,*|*,month,*) return 0 ;; esac
  return 1
}
# The reports with a window read the clock once, for the window and for the rows
# that count the last hour and five; the others have no window to cut.
case "$DIM" in __sessions|__daily|__json|__by) NOW=$(date +%s) ;; esac
if [ "${SINCE_SET:-0}" = 1 ]; then
  CUT=$(since_cut "$SINCE") || die_usage "bad --since value $SINCE"
elif wide_window || [ -z "$NOW" ]; then
  CUT=0
else
  CUT=$(since_cut 7d)
fi
UPTO=0
if [ "${UNTIL_SET:-0}" = 1 ]; then
  UPTO=$(until_cut "$UNTIL") || die_usage "bad --until value $UNTIL"
fi

[ "$DO_UPDATE" = 1 ] && update 0
[ -n "$SESSION" ] && resolve_session
case "$DIM" in ""|__by|__sessions|__daily|__burn|__json) filter_facts ;; esac

case "$DIM" in
  "")          summary ;;
  __sessions)  sessions "$CUT" "$UPTO" ;;
  __daily)     daily "$CUT" "$UPTO" ;;
  __calibrate) calibrate "$CAL_ACCT" "$CAL_AMT" "$CAL_AT" ;;
  __meter)     if [ "$MET_FORCE" = 1 ]; then meter_refresh --force
               elif [ "$MET_REFRESH" = 1 ]; then meter_refresh; fi
               meter_show ;;
  __detail)    session_detail "$SESSION" ;;
  __burn)      burn ;;
  __json)      json "$CUT" "$UPTO" ;;
  __by)        report_by "$BYLIST" "$CUT" "$UPTO" ;;
esac
